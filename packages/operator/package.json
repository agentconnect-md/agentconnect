{
  "name": "@agentconnect.md/operator",
  "version": "1.0.0-dev",
  "description": "AgentConnect cluster operator — reconciles AgentConnectOrg resources into per-org execution envelopes (namespace, RBAC, daemon supervisor, sandbox templates)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "agentconnect-operator": "dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter '{.}^...' build && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch --conditions=development src/index.ts",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "dependencies": {
    "@agentconnect.md/connection": "workspace:*",
    "@agentconnect.md/k8s-client": "workspace:*",
    "@agentconnect.md/observability": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "agentconnect",
    "crd",
    "kubernetes",
    "operator"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
