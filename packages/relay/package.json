{
  "name": "@agentconnect.md/relay",
  "version": "2.0.0-dev",
  "description": "AgentConnect relay — the unified ingress plane (HTTP bot / webhook / webchat) that dials the control-plane and forwards to daemons",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "bin": {
    "agentconnect-relay": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter \"{.}...\" build:package",
    "build:package": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "types": "dist/index.d.ts",
  "dependencies": {
    "@agentconnect.md/activation-policy": "workspace:*",
    "@agentconnect.md/connection": "workspace:*",
    "@agentconnect.md/message": "workspace:*",
    "@agentconnect.md/observability": "workspace:*",
    "@agentconnect.md/protocol": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@slack/web-api": "^8.2.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "undici": "^8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.3",
    "@ag-ui/core": "^1.0.3",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "ai": "^7.0.154",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "agentconnect",
    "ingress",
    "relay",
    "websocket"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
