# Settings for compose.yaml: copy to .env next to it and fill in the first two.
# Guide: docs/self-host-desktop-container.md.

# From the console: Computers -> Add computer -> Docker. The token works once and expires.
AGENTCONNECT_CP_URL=https://cp.example.com
AGENTCONNECT_REGISTER_TOKEN=

# The name shown in the console when you gave none there; defaults to the hostname below.
# AGENTCONNECT_COMPUTER_NAME=Build server desktop
# AGENTCONNECT_DESKTOP_HOSTNAME=agentconnect-desktop

# Direct viewer media. Set the public IP browsers reach this server on and open the UDP range in its
# firewall; each viewer uses up to two ports. Without it the viewer uses the deployment's TURN server,
# or polls screenshots through the relay.
# RTC_ADDRESS=203.0.113.10
# AGENTCONNECT_DESKTOP_RTC_PORTS=7700-7709

# The screen, and the browser kept open on it (`none` for no browser).
# AGENTCONNECT_DESKTOP_RESOLUTION=1600x900x24
# AGENTCONNECT_DESKTOP_BROWSER=firefox-esr
# BROWSER_URL=https://example.com

# Image selection. Pin the version your Control Plane runs.
# AGENTCONNECT_VERSION=latest
# AGENTCONNECT_IMAGE_REGISTRY=ghcr.io/agentconnect-md
