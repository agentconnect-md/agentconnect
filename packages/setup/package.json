{
  "name": "@agentconnect.md/setup",
  "version": "2.0.0-dev",
  "description": "AgentConnect self-hosted Setup Server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentconnect-md/agentconnect.git",
    "directory": "packages/setup"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter \"{.}...\" build:package",
    "build:package": "tsdown && node scripts/assert-self-contained.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx watch --conditions=development src/index.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@agentconnect.md/control-plane": "workspace:*",
    "@agentconnect.md/protocol": "workspace:*",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "json": "^11.0.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "agentconnect",
    "self-hosting",
    "setup-server"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
