{
  "name": "@agentconnect.md/control-plane",
  "version": "1.0.0-dev",
  "description": "AgentConnect Control Plane — orchestration / registry / BFF (no message hot path)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "src"
  ],
  "scripts": {
    "prebuild": "pnpm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "db:seed:example": "prisma db execute --file prisma/seed-example.sql",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "openapi:generate": "pnpm run prisma:generate && tsx --conditions development scripts/generate-openapi.ts",
    "prepack": "pnpm run prisma:generate && pnpm run build",
    "prisma:generate": "prisma generate",
    "secrets:rewrap": "tsx --env-file-if-exists=../../.env src/secrets/rewrap-cli.ts",
    "start": "node dist/index.js",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:int": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "pretypecheck": "pnpm run prisma:generate",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "types": "dist/index.d.ts",
  "dependencies": {
    "@agentconnect.md/protocol": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/otel": "^0.19.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "@octokit/auth-app": "^8.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-undici": "^0.30.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "aws4fetch": "^1.0.20",
    "croner": "^10.0.1",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "image-size": "^2.0.2",
    "jose": "^6.2.3",
    "lucide": "^1.21.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.3",
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "prisma": "^7.8.0",
    "testcontainers": "^12.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "agentconnect",
    "control-plane",
    "fastify",
    "orchestration"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
