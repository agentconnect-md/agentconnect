{
  "name": "@agentconnect.md/control-plane",
  "version": "1.0.0-dev",
  "description": "AgentConnect Control Plane — orchestration / registry / BFF (no message hot path)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deployment-config-store": {
      "development": "./src/deployment-config-store.ts",
      "types": "./dist/deployment-config-store.d.ts",
      "import": "./dist/deployment-config-store.js",
      "default": "./dist/deployment-config-store.js"
    },
    "./feishu-registration-provider": {
      "development": "./src/http/feishu-registration-provider.ts",
      "types": "./dist/http/feishu-registration-provider.d.ts",
      "import": "./dist/http/feishu-registration-provider.js",
      "default": "./dist/http/feishu-registration-provider.js"
    },
    "./feishu-identity": {
      "development": "./src/http/feishu-identity.ts",
      "types": "./dist/http/feishu-identity.d.ts",
      "import": "./dist/http/feishu-identity.js",
      "default": "./dist/http/feishu-identity.js"
    },
    "./github-app-api": {
      "development": "./src/github/setup-api.ts",
      "types": "./dist/github/setup-api.d.ts",
      "import": "./dist/github/setup-api.js",
      "default": "./dist/github/setup-api.js"
    },
    "./gitlab-config": {
      "development": "./src/gitlab/config.ts",
      "types": "./dist/gitlab/config.d.ts",
      "import": "./dist/gitlab/config.js",
      "default": "./dist/gitlab/config.js"
    },
    "./slack-config-api": {
      "development": "./src/http/slack-config-api.ts",
      "types": "./dist/http/slack-config-api.d.ts",
      "import": "./dist/http/slack-config-api.js",
      "default": "./dist/http/slack-config-api.js"
    },
    "./slack-manifest": {
      "development": "./src/http/slack-manifest.ts",
      "types": "./dist/http/slack-manifest.d.ts",
      "import": "./dist/http/slack-manifest.js",
      "default": "./dist/http/slack-manifest.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "src"
  ],
  "scripts": {
    "prebuild": "pnpm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "db:seed:example": "prisma db execute --file prisma/seed-example.sql",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "openapi:generate": "pnpm run prisma:generate && tsx --conditions development scripts/generate-openapi.ts",
    "prepack": "pnpm run prisma:generate && pnpm run build",
    "prisma:generate": "prisma generate",
    "secrets:rewrap": "tsx --env-file-if-exists=../../.env src/secrets/rewrap-cli.ts",
    "secrets:shred": "tsx --env-file-if-exists=../../.env src/secrets/shred-cli.ts",
    "start": "node dist/index.js",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:int": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "pretypecheck": "pnpm run prisma:generate",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "types": "dist/index.d.ts",
  "dependencies": {
    "@agentconnect.md/k8s-client": "workspace:*",
    "@agentconnect.md/observability": "workspace:*",
    "@agentconnect.md/protocol": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/instrumentation": "^7.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@slack/web-api": "^8.1.0",
    "aws4fetch": "^1.0.20",
    "croner": "^10.0.1",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "image-size": "^2.0.2",
    "jose": "^6.2.4",
    "lru-cache": "^11.5.2",
    "lucide": "^1.26.0",
    "sharp": "^0.35.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace": "^2.10.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "execa": "^10.0.0",
    "prisma": "^7.9.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentconnect",
    "control-plane",
    "fastify",
    "orchestration"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
