// AgentConnect Control Plane — Persistence (C6).
//
// PostgreSQL via Prisma. METADATA-ONLY: there is no `text`/`content`/`messages`
// column anywhere — the raw `session/update` stream and `NormalizedMessage.text`
// live only in the daemon's local SQLite (body-locality invariant, protocol §12 /
// design §1, §3). Every column here is control state, a fencing token, a digest,
// or an opaque reference.
//
// See docs/designs/control-plane-implementation.md §3.

generator client {
  provider     = "prisma-client"
  // v7 emits TypeScript source compiled with the app (tsc). Output lives under
  // `src/` so `rootDir: src` picks it up; it is gitignored and regenerated by
  // `prisma:generate` in CI and the Docker build. No query-engine binary — v7
  // uses the queryCompiler + the `@prisma/adapter-pg` driver adapter.
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Connection URL is supplied at runtime via the pg driver adapter (see
  // `persistence/prisma.ts`) and to the CLI via `prisma.config.ts`
  // (`datasource.url`). v7 deprecates a `url` here, so it is intentionally omitted.
}

// ───────────────────────────────────────────────────────────────────────────
// §3.2 Tenancy axis — Org / User / Membership (C2/C4 WebUI authz)
// ───────────────────────────────────────────────────────────────────────────

model Org {
  id        String   @id @default(cuid())
  // Optional display name; when absent the console falls back to `slug`.
  name      String?
  slug      String   @unique
  // Console avatar descriptor (protocol AgentIcon): {kind:'runtime'} | {kind:'glyph',glyph,color}
  // | {kind:'image'}. Null ⇒ generated default (glyph plate keyed off the org id). An `image`
  // icon's bytes live in the object store (docs/designs/icon-uploads.md), served by GET
  // /v1/orgs/:id/icon. Org icons are console-only — never fed to Slack.
  icon      Json?    @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  members                   Membership[]
  daemons                   Daemon[]
  agents                    Agent[]
  crons                     CronDef[]
  hooks                     HookDef[]
  apiKeys                   ApiKey[]
  integrations              Integration[]
  bots                      Bot[]
  githubInstallations       GithubInstallation[]
  slackUserConfigs          SlackUserConfig[]
  inviteLink                OrgInviteLink?
  mcpProviders              McpProvider[]
  skillSources              SkillSource[]
  memoryPluginInstallations MemoryPluginInstallation[]
  externalMemoryConnections ExternalMemoryConnection[]
  webchatConversations      WebchatConversation[]

  @@map("org")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  displayName             String?
  picture                 String? // OIDC `picture` claim (avatar URL); display-only, refreshed on sign-in
  // Set when the user uploads a profile photo. The image itself lives in the icon
  // object store under a key derived from this user id; the timestamp marks it as
  // the active photo and cache-busts its public URL.
  profilePictureUpdatedAt DateTime? @db.Timestamptz(6)
  oidcSubject             String?   @unique // OIDC `sub` → user
  // The moment the user redeemed their waitlist join link = "formal / activated"
  // user. Non-null ⇒ may enter the app
  // and create orgs under WAITLIST_MODE. ONLY the CP's redeem path writes this (the
  // external admin app is not granted write on this column, §7 contract 2). Always
  // null when waitlist mode is off — the column is inert there.
  activatedAt             DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)

  memberships                      Membership[]
  apiKeys                          ApiKey[]
  createdAgents                    Agent[]                    @relation("AgentCreatedBy")
  modifiedAgents                   Agent[]                    @relation("AgentModifiedBy")
  createdIntegrations              Integration[]
  createdBots                      Bot[]
  createdMcpProviders              McpProvider[]
  createdSkillSources              SkillSource[]
  createdMemoryPluginInstallations MemoryPluginInstallation[] @relation("MemoryPluginInstallationCreatedBy")
  createdExternalMemoryConnections ExternalMemoryConnection[] @relation("ExternalMemoryConnectionCreatedBy")
  createdDaemons                   Daemon[]                   @relation("DaemonCreatedBy")
  modifiedDaemons                  Daemon[]                   @relation("DaemonModifiedBy")
  createdCrons                     CronDef[]                  @relation("CronCreatedBy")
  modifiedCrons                    CronDef[]                  @relation("CronModifiedBy")
  createdHooks                     HookDef[]                  @relation("HookCreatedBy")
  modifiedHooks                    HookDef[]                  @relation("HookModifiedBy")
  createdRepoAuths                 AgentRepoAuthorization[]   @relation("AgentRepoAuthCreatedBy")
  slackConfigs                     SlackUserConfig[]
  createdInviteLinks               OrgInviteLink[]            @relation("OrgInviteLinkCreatedBy")
  inviteRedemptions                OrgInviteRedemption[]
  webchatConversations             WebchatConversation[]

  @@map("app_user")
}

// Console roles (§3.2): owner = edit everything + manage members/org info (an
// org can have several owners); collaborator = create/edit/run agents, manage
// sessions; viewer = read-only.
enum OrgRole {
  owner
  collaborator
  viewer
}

// Per-resource visibility (docs/designs/resource-visibility.md §1): 'org' (default)
// = visible to every org member (current behavior); 'restricted' = creator + org
// owners + the `sharedWith` set only. Enforced ONLY on console read/write paths —
// never crosses the daemon↔CP wire (a restricted-but-active resource still runs).
enum ResourceVisibility {
  org
  restricted
}

// Directional agent-call policy. The inbound fields control which peers may call
// THIS agent; the outbound fields control which peers this agent may discover/call.
// Separate from ResourceVisibility, which governs human console access.
enum AgentCallPolicy {
  all
  selected
}

model Membership {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(collaborator)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("membership")
}

// One shareable join link per org. The token is stored as a peppered hash and
// always grants collaborator for exactly seven days; neither is configurable.
model OrgInviteLink {
  id              String    @id @default(cuid())
  orgId           String    @unique
  tokenHash       String    @unique
  displayTail     String
  expiresAt       DateTime  @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  org         Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("OrgInviteLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  redemptions OrgInviteRedemption[]

  @@map("org_invite_link")
}

// Persists use even after membership removal, so the same account cannot use
// the same link to restore its own access. A newly generated link has a new id.
model OrgInviteRedemption {
  inviteLinkId String
  userId       String
  redeemedAt   DateTime @default(now()) @db.Timestamptz(6)

  inviteLink OrgInviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteLinkId, userId])
  @@index([userId])
  @@map("org_invite_redemption")
}

// ───────────────────────────────────────────────────────────────────────────
// WaitlistEntry — closed-beta admission
//   One row per activation link. TWO write sides share this table (§7):
//     • the EXTERNAL admin app writes approval/mint fields (name, email, status,
//       note, source, tokenHash, displayTail, joinExpiresAt, revokedAt, approved*)
//       — enforced by a column-level least-privilege DB role granted in the migration;
//     • the CP writes ONLY the redemption fields (redeemed*), in the same
//       transaction that sets User.activatedAt.
//   `email` is OPTIONAL and drives the ONE redemption rule (§6): a row WITH an email
//   may be redeemed ONLY by that verified email (strong binding); a row with NO email
//   is a one-time BEARER link — any verified identity may redeem it once, and the
//   redeemer's email is recorded in `redeemedEmail`. `email` stays `@unique` so real
//   emails don't collide and self-signup upserts still work; Postgres treats NULLs as
//   distinct, so any number of bearer rows (email null) coexist.
//   The join link reuses OrgInviteLink's peppered-hash + tail + expiry/revoke
//   shape, but the token is minted by the admin app and only VERIFIED (hashed &
//   compared) by the CP on redeem. Minting/approval/admin-auth are out of this
//   repo's scope; the CP owns the schema + migrations for its application DB.
// ───────────────────────────────────────────────────────────────────────────

enum WaitlistStatus {
  pending // user self-submitted, awaiting review
  approved // admin approved = whitelisted; a join link has been minted
  rejected // admin rejected
}

model WaitlistEntry {
  id     String         @id @default(cuid())
  name   String? // display name for the applicant / invitee (admin- or intake-supplied)
  email  String?        @unique // normalized lowercase (auth.ts); NULL ⇒ bearer link
  status WaitlistStatus @default(pending)
  note   String? // applicant message / admin note
  source String? // 'self' | 'admin' | …

  // ── join link (one per email; minted by the admin app on approve) ──
  tokenHash     String?   @unique // peppered hash; plaintext only ever in the mint response
  displayTail   String? // display-only tail for reconciliation
  joinExpiresAt DateTime? @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)

  // ── approval / redemption audit ──
  approvedByUserId String?
  approvedAt       DateTime? @db.Timestamptz(6)
  redeemedByUserId String? // written ONLY by the CP redeem path
  redeemedAt       DateTime? @db.Timestamptz(6) // written ONLY by the CP redeem path
  redeemedEmail    String? // the redeemer's verified email; written ONLY by the CP redeem path

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("waitlist_entry")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.3 Daemon — fleet registry & fencing root (C4)
// ───────────────────────────────────────────────────────────────────────────

enum DaemonStatus {
  provisioned
  authenticating
  ready
  draining
  unreachable
  disabled
}

enum HealthState {
  ok
  degraded
}

model Daemon {
  id            String  @id @db.Uuid // AuthReq.daemonId (wire UUID)
  orgId         String
  host          String? // RegisterReq.host (display)
  name          String? // human-assigned display name (set via the console, never by the daemon)
  agentVersion  String?
  machineId     String? @db.Uuid // 🅼 AuthReq.machineId (stored, stub-enforced)
  tokenFp       String? // `id` of the authenticating ApiKey (audit; written by upsertOnAuth)
  attestationFp String? // 🅼 last accepted attestation digest
  capabilities  Json    @default("{}") @db.JsonB // {platforms[],runtimes[],acp,features[]}
  mcpServers    Json    @default("[]") @db.JsonB // facts/daemon-runtimes MCP-server list (FactsMcpServer[] = {name,transport}); replaced whole per frame
  maxAgents     Int     @default(0)

  createdByUserId String? // WebUI user who provisioned the daemon (audit; null for CLI/self-registered). Surfaced in the console "Created" row.

  // ── last-modification audit (human edits only) ──
  // Stamped together on user-initiated writes (provision, rename). Deliberately
  // SEPARATE from `updatedAt`, which the row bumps on every system write
  // (heartbeat, (re)auth, register, watchdog) and so cannot mean "last human edit".
  lastModifiedByUserId String? // WebUI user who last edited the daemon (null ⇒ never edited by a human)
  lastModifiedAt       DateTime @default(now()) @db.Timestamptz(6) // defaults to createdAt; app-bumped on each human edit

  // ── visibility / sharing (docs/designs/resource-visibility.md) ──
  visibility ResourceVisibility @default(org) // 'org' = all members; 'restricted' = creator + owners + sharedWith
  sharedWith String[]           @default([]) // app_user.id set granted view when visibility='restricted'

  // ── fencing root ──
  sessionEpoch BigInt @default(0) @db.BigInt // bumped each successful (re)auth
  routingEpoch BigInt @default(0) @db.BigInt // version of THIS daemon's assignment set

  // Last applied `facts/daemon-runtimes.seq` (per-connection monotonic; reset to
  // NULL on register). Snapshots with an older seq are dropped so interleaved
  // frame transactions cannot commit out of order (runtime-model-catalog.md §5).
  runtimesSnapshotSeq Int?

  // ── liveness / watchdog ──
  status         DaemonStatus @default(provisioned)
  health         HealthState  @default(ok)
  load           Json?        @db.JsonB // Heartbeat.load {cpu,mem,agents}
  activeSessions Int          @default(0)
  degradedScopes String[]     @default([]) // Heartbeat.degradedScopes
  lastSeenAt     DateTime?    @db.Timestamptz(6) // drives watchdog
  unreachableAt  DateTime?    @db.Timestamptz(6) // reassignGrace clock origin

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  org             Org                 @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("DaemonCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy  User?               @relation("DaemonModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  agents          Agent[]
  assignments     Assignment[]
  leases          SecretLease[]
  launches        AgentLaunch[]
  runtimeProfiles RuntimeProfile[]
  apiKeys         ApiKey[]
  sessions        SessionMeta[]
  lifecycleOps    DaemonLifecycleOp[]

  @@index([orgId])
  @@index([status])
  @@index([lastSeenAt])
  @@map("daemon")
}

// ───────────────────────────────────────────────────────────────────────────
// DaemonLifecycleOp — a CP-commanded restart/upgrade in flight (cli-daemon-split.md §7)
//   A console "Restart"/"Upgrade" opens a `pending` row and sends the C→D
//   `daemon/restart` / `daemon/upgrade` REQ. The `DaemonControlAck` only means the
//   daemon accepted the command; the real outcome is closed out-of-band when the
//   daemon drains, its supervisor relaunches it, and it re-registers READY (an
//   upgrade additionally requires its reported `agentVersion` to reach the target
//   within the deadline). A decline (`accepted:false`) or a `deadline` lapse closes
//   the row `failed`. At most one op may be pending per daemon (partial unique index,
//   hand-added in the migration — not faithfully expressible in the Prisma schema).
// ───────────────────────────────────────────────────────────────────────────

enum DaemonLifecycleOpType {
  restart
  upgrade
}

enum DaemonLifecycleOpStatus {
  pending
  succeeded
  failed
}

model DaemonLifecycleOp {
  id            String                  @id @default(cuid())
  daemonId      String                  @db.Uuid
  op            DaemonLifecycleOpType
  targetVersion String? // the version to reach (upgrade only); null for restart
  initiator     String? // app_user.id that commanded it; null under devAuth / system
  status        DaemonLifecycleOpStatus @default(pending)
  // The daemon `sessionEpoch` at command-send time. The op only settles on a READY
  // whose epoch is STRICTLY GREATER (the daemon re-authed after draining + relaunching),
  // so a coincidental reconnect at the same epoch can never close it.
  commandEpoch  BigInt                  @default(0) @db.BigInt
  // Set when the daemon ACKs `accepted:true` (the op is "armed"). A READY before this
  // must NOT settle the op — the command hadn't been accepted/executed yet.
  acceptedAt    DateTime?               @db.Timestamptz(6)
  startedAt     DateTime                @default(now()) @db.Timestamptz(6)
  deadline      DateTime                @db.Timestamptz(6) // drain+relaunch budget; a lapse closes the op `failed`
  outcome       String? // short closure detail (decline reason / "version mismatch" / "expired")
  settledAt     DateTime?               @db.Timestamptz(6) // when it left `pending`
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)

  daemon Daemon @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@index([daemonId, status])
  @@map("daemon_lifecycle_op")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.3a ApiKey — long-lived, revocable control-channel credential (C4)
// ───────────────────────────────────────────────────────────────────────────
// One table with a `principalType` discriminator serves daemon, personal-user,
// relay, and OAuth credentials. Hash-only at rest: the token
// a bare opaque `<secret><crc>` is looked up by `hash = HMAC-SHA256(secret, API_KEY_PEPPER)`
// (@unique); the plaintext is shown exactly once at mint and never persisted.
// See docs/designs/daemon-api-key-auth.md.

enum PrincipalType {
  daemon
  user
  relay // relay↔CP credential (shared-bot-relay.md §8) — org-less infra key
  oauth // access token minted by the embedded OAuth AS (agent-assistant.md §7) — same shape as a user key
}

model ApiKey {
  id            String        @id @default(cuid())
  principalType PrincipalType // daemon | user | relay | oauth
  orgId         String? // org-scoped for daemon/user/oauth keys; NULL for relay keys
  daemonId      String?       @db.Uuid // set iff principalType=daemon
  userId        String? // set iff principalType=user or oauth

  hash            String   @unique // HMAC-SHA256(secret, pepper) hex — NEVER plaintext; the unique lookup key
  displayTail     String // "…a2b1" (non-secret) for the console
  name            String? // human label ("ci-runner-east")
  scopes          String[] @default([]) // daemon/user/relay keys use []; oauth keys carry granted mcp:* scopes
  createdByUserId String? // operator who minted it (audit)
  oauthGrantId    String? // set iff principalType=oauth — links the access token to its OAuthGrant so revoking the grant kills its tokens

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt    DateTime? @db.Timestamptz(6) // throttled write on auth
  expiresAt     DateTime? @db.Timestamptz(6) // long-lived principals may be non-expiring; user/oauth mint policies set TTLs
  revokedAt     DateTime? @db.Timestamptz(6) // kill switch — checked on every auth
  revokedReason String?

  org    Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Cascade: deleting a daemon (DELETE /daemons/:id) removes its keys, so no
  // orphaned credential rows (daemonId-null but still hash-valid) survive.
  daemon Daemon? @relation(fields: [daemonId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([daemonId])
  @@index([userId])
  @@index([orgId, revokedAt])
  @@index([oauthGrantId])
  @@map("api_key")
}

// ───────────────────────────────────────────────────────────────────────────
// Embedded OAuth 2.1 Authorization Server (docs/designs/agent-assistant.md §7)
//   Lets MCP clients (claude.ai / Claude Code) do the browser login flow against
//   the CP. The CP issues its OWN tokens (access token = an `api_key` row with
//   principalType='oauth'); the human login on /authorize is delegated to the web
//   console (Logto / devAuth). These tables hold only the AS's own protocol state.
// ───────────────────────────────────────────────────────────────────────────

// A dynamically-registered (RFC 7591) MCP client. Public clients only (PKCE is the
// proof; no client secret). Reaped after `expiresAt` to bound DCR-table growth.
model OAuthClient {
  clientId     String   @id // AS-generated opaque id
  clientName   String?
  redirectUris String[] @default([])
  grantTypes   String[] @default([]) // e.g. ["authorization_code","refresh_token"]
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime @db.Timestamptz(6) // DCR registration TTL (default 90d)

  @@index([expiresAt])
  @@map("oauth_client")
}

// A single-use authorization code, issued AFTER the user consents on the console
// and exchanged at /token. Hash-only at rest (like api_key). Bound to the PKCE
// challenge + the consenting user/org so the client cannot forge identity.
model OAuthCode {
  codeHash            String    @id // HMAC-SHA256(secret, pepper) hex of the code
  clientId            String
  redirectUri         String
  userId              String
  orgId               String
  scopes              String[]  @default([])
  codeChallenge       String
  codeChallengeMethod String // always "S256"
  resource            String? // RFC 8707 audience the client requested
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime  @db.Timestamptz(6) // short (≈60s)
  consumedAt          DateTime? @db.Timestamptz(6) // set on first exchange — single-use guard

  @@index([expiresAt])
  @@map("oauth_code")
}

// A persisted authorization grant = the refresh-token state for one (user, org,
// client). Refresh tokens rotate on every use; the previous generation stays valid
// for one more use (workers-oauth-provider's fix for the lost-response deadlock).
model OAuthGrant {
  id          String    @id @default(cuid())
  userId      String
  orgId       String
  clientId    String
  scopes      String[]  @default([])
  resource    String?
  rtHash      String?   @unique // current refresh-token hash (rotating)
  prevRtHash  String? // previous generation — still redeemable once
  rtExpiresAt DateTime? @db.Timestamptz(6) // refresh inactivity expiry (default 30d, slid on use)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6) // "disconnect" — also cascade-revokes its access tokens

  @@index([userId])
  @@index([prevRtHash])
  @@map("oauth_grant")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.4 RuntimeProfile — observed runtime capabilities (C4)
// ───────────────────────────────────────────────────────────────────────────

enum AcpSupport {
  full
  partial
  none
}

model RuntimeProfile {
  id                 String     @id @default(cuid())
  daemonId           String     @db.Uuid
  runtime            String // "claude" / "codex"
  version            String
  models             String[]   @default([])
  contextWindow      Int?
  acpSupport         AcpSupport @default(none)
  acpProtocolVersion Int? // ACP protocol version negotiated at initialize
  toolCalling        Boolean    @default(false)
  mcpCapabilities    Json?      @db.JsonB // MCP transports advertised at initialize {http,sse}; null ⇒ not probed (assume stdio-only)
  modelCatalog       Json?      @db.JsonB // wire RuntimeModelCatalog verbatim (runtime-model-catalog.md §5); null ⇒ no catalog reported
  modelsSource       String? // provenance of models[]: 'cached' | 'probed'; null ⇒ older daemon (probed semantics)
  authRequired       Boolean    @default(false) // last probe hit ACP auth-required (-32000): installed but needs a login on the daemon host
  observedAt         DateTime   @default(now()) @db.Timestamptz(6)

  daemon Daemon @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@unique([daemonId, runtime])
  @@map("runtime_profile")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.5 Workspace mode — INLINE on Agent (no standalone entity).
// ───────────────────────────────────────────────────────────────────────────
// The agent's working dir is daemon-generated; the caller picks one of two modes
// (mirrors protocol AgentWorkspace). `github` clones gitRepo@gitBranch and runs the
// agent in `agentDir` (a subdir); multiple agents may share a repo by differing
// `agentDir`, so workspace config lives per-agent on the Agent row below.
enum WorkspaceMode {
  scratch // fresh empty working dir, no repo
  github // clone gitRepo @ gitBranch, run in agentDir
}

// ───────────────────────────────────────────────────────────────────────────
// §3.6 Agent — agent definition & capability pin (C6 + C4)
// ───────────────────────────────────────────────────────────────────────────

enum AgentStatus {
  active
  inactive
  paused
}

model Agent {
  id                    String             @id @db.Uuid // wire UUID across route/*, agent/*, event/session
  orgId                 String
  name                  String // slug — lowercase [a-z0-9-]; unique per org; the daemon-facing handle
  displayName           String? // human-readable original ("Acme Network Bot"); the console derives the slug from it
  // Console avatar descriptor (protocol AgentIcon): {kind:'runtime'} | {kind:'glyph',glyph,color} |
  // {kind:'image',url}. Null ⇒ legacy default = the runtime mark. New agents are created with a
  // random glyph+color. Rendered by GET /v1/agents/:id/icon and used as the Slack per-message icon_url.
  icon                  Json?              @db.JsonB
  description           String? // system prompt seed → AgentLaunch.spec.description; daemon appends to standing prompt
  runtime               String // must be in Daemon.capabilities.runtimes
  status                AgentStatus        @default(inactive)
  daemonId              String?            @db.Uuid // 1 agent : 1 machine (null until placed)
  // ── workspace (inline; §3.5) — daemon-generated path ──
  workspaceMode         WorkspaceMode      @default(scratch)
  gitRepo               String? // github mode: e.g. github.com/acme/infra
  gitBranch             String?            @default("main")
  agentDir              String? // github mode: subdir within the repo (repo-root if null)
  // github-app credential mode (docs/designs/github-app-git-credentials.md).
  // `installationId` = GithubInstallation.id picked at create time — a PROVENANCE
  // HINT only, deliberately NO relation/FK: minting re-resolves the live
  // installation by repo owner every time, so an uninstall→reinstall (new GitHub
  // installation id) self-heals without touching agents. Null ⇒ anonymous git.
  installationId        String?
  // GitHub's numeric repository id for the workspace repo.  Unlike gitRepo,
  // this survives rename and is the authority for repo-scoped effects.
  // Nullable for pre-migration/anonymous workspaces and lazily repairable.
  workspaceRepoId       BigInt?
  gitAccess             GitAccess          @default(write) // ceiling for minted tokens (contents read|write)
  capabilities          String[]           @default([]) // → AgentLaunch.activeCapabilities
  permissions           Json               @default("{}") @db.JsonB // {policy:"ask",autoApprove:[...]}
  runtimeOverrides      Json?              @db.JsonB // {model, reasoningEffort, outputMode, fastMode, env{K:V}, mcpServers[], skills[]} — NO secret values (those live in agent_secret)
  createdByUserId       String? // WebUI user who created the agent (audit; null for daemon/CLI-created). Surfaced in the console "Created" row.
  // Last-modification audit (human edits only): stamped on create + PATCH. Kept
  // separate from `updatedAt`, which also bumps on system writes (e.g. placement).
  lastModifiedByUserId  String? // WebUI user who last edited the agent (null ⇒ never edited by a human)
  lastModifiedAt        DateTime           @default(now()) @db.Timestamptz(6) // defaults to createdAt; app-bumped on each PATCH
  // ── visibility / sharing (docs/designs/resource-visibility.md) ──
  visibility            ResourceVisibility @default(org) // 'org' = all members; 'restricted' = creator + owners + sharedWith
  sharedWith            String[]           @default([]) // app_user.id set granted view when visibility='restricted'
  // ── inbound agent-call policy (UI: Agent visibility) ──
  callPolicy            AgentCallPolicy    @default(all) // 'all' = any org peer agent may call this as a sub-agent
  allowedCallerAgentIds String[]           @default([]) // agent.id set used when callPolicy='selected'
  // ── outbound agent-call policy (UI: Agent visibility) ──
  outboundPolicy        AgentCallPolicy    @default(all) // 'all' = this agent may discover/call any otherwise-callable org peer
  allowedTargetAgentIds String[]           @default([]) // agent.id set used when outboundPolicy='selected'
  introduceOnJoin       Boolean            @default(false) // #536: self-introduce to peers on a genuine channel join
  restrictFileAccess    Boolean            @default(false) // #642: request an OS sandbox; daemon policy may force it on
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  org                  Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  daemon               Daemon?                  @relation(fields: [daemonId], references: [id], onDelete: SetNull)
  createdBy            User?                    @relation("AgentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy       User?                    @relation("AgentModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  assignments          Assignment[]
  launches             AgentLaunch[]
  sessions             SessionMeta[]
  sessionUsage         SessionUsage[]
  crons                CronDef[]
  hooks                HookDef[]
  integrations         Integration[]
  repoAuths            AgentRepoAuthorization[]
  secrets              AgentSecret[]
  webchatConversations WebchatConversation[]

  @@unique([orgId, name]) // slug is unique within an org
  @@index([orgId])
  @@index([daemonId])
  @@map("agent")
}

// One write-only secret env var of an agent, row-per-key. BotSecret discipline:
// list/DTO queries never join it — key NAMES are read via AgentSecretStore.keys
// (values untouched), values ONLY via AgentSecretStore.get on the wire-projection
// paths (agent/upsert, register/ok roster, agent/activate). The store seam is the
// single read/write path, so the configured SecretCipher transforms every value;
// an encrypting provider supplies at-rest encryption while `none` is identity.
model AgentSecret {
  agentId   String   @db.Uuid
  key       String // env var name (validated at the API edge)
  value     String // passes through the SecretCipher seam (plaintext under the identity cipher)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, key])
  @@map("agent_secret")
}

/// Access level of an AgentRepoAuthorization row. Three tiers instead of
/// GitAccess's two: `comment` (contents:read + issues/PR:write) is the github
/// hook write-back shape — two tiers would force granting contents:write just
/// to let the agent comment (agent-multi-repo-authorization.md decision 3).
enum RepoAccess {
  read // contents/issues/PR all read — reference repo
  comment // contents:read, issues/PR write — watch + write-back
  write // all write — secondary working repo
}

/// Explicit grant of a GitHub repo to an agent (issue #457,
/// agent-multi-repo-authorization.md). Anchored on the agent, NOT on hooks —
/// creating a hook must never silently widen credentials. `repoId` (numeric,
/// rename-immune) is the match key; `repoFullName` is display + the request
/// fast-path. The covering installation is deliberately NOT bound here: minting
/// re-resolves the live installation by repo owner (gitcred decision 7), so an
/// uninstall→reinstall self-heals. Rows are mutable (add/remove) — the
/// workspace-immutability convention is untouched.
model AgentRepoAuthorization {
  id              String     @id @default(uuid()) @db.Uuid
  agentId         String     @db.Uuid
  repoId          BigInt // GitHub numeric repo id — the match key
  repoFullName    String // "owner/repo" — display + case-insensitive fast-path; refreshed on rename detection
  access          RepoAccess
  createdByUserId String? // audit: who authorized (the identity-assertion subject)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)

  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AgentRepoAuthCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([agentId, repoId])
  @@index([agentId])
  @@map("agent_repo_authorization")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.7 Assignment — the routing table (session ownership + fencing) (C3)
// ───────────────────────────────────────────────────────────────────────────

enum Platform {
  slack
  telegram
  discord
  feishu
}

enum AssignmentState {
  active
  draining
  released // released = drain/done (reassignable under NEW epoch)
  frozen
}

model Assignment {
  id          String   @id @default(cuid())
  platform    Platform
  channel     String
  thread      String?
  threadKey   String   @default(dbgenerated("(COALESCE(thread, ''::text))")) // STORED generated col, added in migration SQL (§3.13); read-only
  agentId     String   @db.Uuid
  daemonId    String?  @db.Uuid // null while released/unplaced
  workspaceId String // opaque scope id on the wire (RouteAssign.workspaceId); now = agentId (workspace is inline)

  // ── fencing ──
  assignedEpoch BigInt          @db.BigInt // Daemon.sessionEpoch at assign time (ControlExt.epoch)
  assignedSeq   BigInt?         @db.BigInt // per-agent seq of the route/assign frame
  routingEpoch  BigInt          @db.BigInt // table version this row reflects
  state         AssignmentState @default(active)
  bindRules     Json            @default("[]") @db.JsonB // RouteAssign.bindRules[]
  releasedAt    DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  daemon Daemon? @relation(fields: [daemonId], references: [id], onDelete: SetNull)

  @@index([daemonId, state]) // register/ok reconcile: active set for a daemon
  @@index([agentId])
  @@index([platform, channel, threadKey])
  @@map("assignment")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.8 SessionMeta — converged session milestones (NO bodies) (C6 + dashboard)
// ───────────────────────────────────────────────────────────────────────────

enum SessionPhase {
  start
  plan
  problem
  end
}

enum ActivityState {
  thinking
  tool_call
  awaiting_permission
  idle
}

model SessionMeta {
  id              String        @id // EventSession.sessionId = ACP session id (agent-assigned string, NOT a UUID)
  parentSessionId String? // Parent ACP session id reported by the daemon; no FK because parent metadata may arrive later or live on another daemon
  agentId         String        @db.Uuid
  launchId        String?       @db.Uuid // CP launch fence; null for Slack/Discord-created sessions (no CP launch)
  platform        String? // denormalized sessionKey echo for dashboard filters (free string so webchat can be listed)
  channel         String?
  thread          String?
  phase           SessionPhase  @default(start)
  link            String? // deep-link (NOT a body)
  summary         String?       @db.Text // short milestone text (NOT the stream)
  title           String?       @db.Text // daemon-derived display title (NOT a body)
  status          String?
  triggeredBy     String?
  channelName     String?
  triggeredByName String?
  threadUrl       String?       @db.Text
  // ── execution-config snapshot (what the session actually ran with) ──
  // Daemon-reported via event/session (session override ?? agent config at run
  // time); null ⇒ never reported / the runtime's own default. Recorded so the
  // console shows what a session USED, not the agent's config at view time.
  runtime         String?
  model           String?
  effort          String? // reasoning effort level (runtime-owned vocabulary)
  fastMode        Boolean?
  permissionMode  String? // runtime permission/approval mode
  outputMode      String? // daemon-side output verbosity (low/medium/high)
  daemonId        String?       @db.Uuid // daemon that reported the session — stamped by the CP from the authenticated WS conn, never daemon-echoed
  activityState   ActivityState @default(idle)
  // Cursor tokens pass through JavaScript Date (millisecond precision), so the
  // complete keyset tuple must use the same precision in Postgres.
  lastActivityAt  DateTime      @db.Timestamptz(3)
  startedAt       DateTime      @default(now()) @db.Timestamptz(3)
  endedAt         DateTime?     @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  agent  Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  launch AgentLaunch? @relation(fields: [launchId], references: [id], onDelete: SetNull)
  daemon Daemon?      @relation(fields: [daemonId], references: [id], onDelete: SetNull)

  @@index([agentId, startedAt])
  @@index([lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc), agentId], map: "session_meta_activity_page_idx")
  @@index([agentId, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_activity_page_idx")
  @@index([agentId, platform, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_platform_page_idx")
  @@index([agentId, channel, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_channel_page_idx")
  @@index([agentId, triggeredBy, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_trigger_page_idx")
  @@index([parentSessionId])
  @@index([platform, channel])
  @@index([launchId])
  @@index([daemonId])
  @@map("session_meta")
}

// Durable ownership metadata for a browser webchat conversation. The message
// stream and transcript remain daemon-local; this row only lets the CP prove
// that a requested resume belongs to the authenticated human, agent, and org.
model WebchatConversation {
  id        String   @id @db.Uuid
  orgId     String
  agentId   String   @db.Uuid
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  org   Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([agentId])
  @@index([userId])
  @@map("webchat_conversation")
}

// ───────────────────────────────────────────────────────────────────────────
// SessionUsage — per-session token accounting for the console's usage dashboard.
//
// Unlike the message stream (daemon-local, never on the CP), token counts + cost
// ARE dashboard telemetry: the daemon reports each session's CUMULATIVE usage via
// the `usage/report` EVT and the CP upserts one row per (agentId, sessionId). This
// is the ONLY historical usage store — the `/usage` aggregates sum over it by
// time window. `sessionId` is the agent-assigned ACP id (a string, NOT a wire
// UUID), so the PK is composite with agentId. Latest-wins upsert = idempotent.
// ───────────────────────────────────────────────────────────────────────────
model SessionUsage {
  agentId           String   @db.Uuid
  sessionId         String // ACP session id (agent-assigned; NOT a wire UUID)
  platform          String? // denormalized sessionKey echo (free string, not the Platform enum)
  channel           String?
  totalTokens       Int      @default(0)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  thoughtTokens     Int      @default(0)
  cachedReadTokens  Int      @default(0)
  cachedWriteTokens Int      @default(0)
  contextUsed       Int?
  contextSize       Int?
  costAmount        Float    @default(0)
  costCurrency      String?
  startedAt         DateTime @default(now()) @db.Timestamptz(6)
  lastActivityAt    DateTime @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, sessionId])
  @@index([agentId, lastActivityAt])
  @@map("session_usage")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.9 AgentLaunch — launch fencing (C3)
// ───────────────────────────────────────────────────────────────────────────

enum LaunchMode {
  long_lived
  per_turn
}

enum LaunchStatus {
  launching
  running
  stopped
  crashed
}

model AgentLaunch {
  id                 String       @id @db.Uuid // AgentLaunched.launchId (the fence value)
  agentId            String       @db.Uuid
  daemonId           String       @db.Uuid
  runtime            String
  mode               LaunchMode   @default(long_lived)
  acpSessionId       String? // set iff long-lived ACP session
  activeCapabilities String[]     @default([]) // capability pin (AgentCapabilities.active)
  status             LaunchStatus @default(launching)
  launchEpoch        BigInt       @db.BigInt // sessionEpoch the launch was issued under
  startedAt          DateTime?    @db.Timestamptz(6)
  stoppedAt          DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  agent    Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  daemon   Daemon        @relation(fields: [daemonId], references: [id], onDelete: Cascade)
  sessions SessionMeta[]

  @@index([agentId, status])
  @@index([daemonId])
  @@map("agent_launch")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.10 SecretLease — lease metadata (NO plaintext) (C5)
// ───────────────────────────────────────────────────────────────────────────

enum LeaseStatus {
  active
  expired
  revoked
}

model SecretLease {
  id               String      @id @db.Uuid // SecretsGrant.leaseId
  daemonId         String      @db.Uuid
  scopePlatform    Platform
  scopeWorkspaceId String      @db.Uuid // SecretsGrant.scope.workspaceId — opaque scope id; now = agentId (workspace inline)
  ref              String // Vault/KMS path/handle — NOT the secret
  ttlSec           Int
  renewBeforeSec   Int         @default(60)
  status           LeaseStatus @default(active)
  issuedAt         DateTime    @default(now()) @db.Timestamptz(6)
  renewedAt        DateTime?   @db.Timestamptz(6)
  expiresAt        DateTime    @db.Timestamptz(6) // issuedAt+ttl; advanced on renew
  revokedReason    String?

  daemon Daemon @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@index([daemonId, status])
  @@index([status, expiresAt])
  @@map("secret_lease")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.11 CronDef — cron definitions (C6 + C3)
// ───────────────────────────────────────────────────────────────────────────

model CronDef {
  id                   String             @id @db.Uuid // CronUpsert.cronId
  orgId                String
  agentId              String?            @db.Uuid // required at the API; null only via agent-delete SetNull (inert until re-assigned)
  name                 String? // console display name ("weekly-deploy-report"); pure console metadata, never on the daemon wire. Null for legacy/CLI rows.
  schedule             String // croner expression interpreted in timezone
  timezone             String // IANA timezone resolved by the CP before persistence
  targetPlatform       Platform           @default(slack)
  targetChannel        String? // CronUpsert.target.channel; null ⇒ headless fire (no platform output)
  targetIntegrationId  String?            @db.Uuid // CronUpsert.target.integrationId — the agent integration posting the anchor; null (legacy / uninstalled) ⇒ daemon falls back to the agent's first integration
  trigger              String             @db.Text // synthetic trigger text (control metadata)
  enabled              Boolean            @default(true)
  lastRunAt            DateTime?          @db.Timestamptz(6) // advisory (cron/report EVT, latest-wins); daemon authoritative
  createdByUserId      String? // WebUI user who created the cron (audit; stamped on create only, never reassigned by edits)
  // Last-modification audit (human edits only): stamped on create AND on every
  // edit through the PUT upsert. Separate from `updatedAt`, which also bumps on
  // system writes (e.g. `lastRunAt` advanced by a daemon cron/report).
  lastModifiedByUserId String? // WebUI user who last edited the cron (null ⇒ never edited by a human)
  lastModifiedAt       DateTime           @default(now()) @db.Timestamptz(6) // defaults to createdAt; app-bumped on each upsert-edit
  // ── visibility / sharing (docs/designs/resource-visibility.md) ──
  visibility           ResourceVisibility @default(org) // 'org' = all members; 'restricted' = creator + owners + sharedWith
  sharedWith           String[]           @default([]) // app_user.id set granted view when visibility='restricted'
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  org               Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent             Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  targetIntegration Integration? @relation(fields: [targetIntegrationId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation("CronCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy    User?        @relation("CronModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  runs              CronRun[]

  @@index([orgId])
  @@index([agentId])
  @@index([targetIntegrationId])
  @@map("cron_def")
}

// One fire of a schedule (`cron/report` EVT pairs keyed on (cronId, startedAt)):
// the FIRE report opens the row (`running`), the COMPLETION report closes it
// with outcome + duration + the ACP session to deep-link. `running` rows whose
// completion report was lost (daemon crashed / CP down at turn end) are
// reconciled to `failed` (orphaned) by the CronRunReaper once they age past
// CRON_RUN_TTL_SEC — a late completion still overwrites that with the real
// outcome (the upsert is last-writer-wins), the daemon remaining authoritative.
enum CronRunStatus {
  running
  success
  failed
}

model CronRun {
  id         String        @id @default(cuid())
  cronId     String        @db.Uuid
  orgId      String
  startedAt  DateTime      @db.Timestamptz(6) // CronReport.firedAt
  status     CronRunStatus @default(running)
  durationMs Int?
  sessionId  String? // ACP session id (console deep-link); null while running / on legacy reports
  reason     String? // short failure text (status "failed")
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)

  cron CronDef @relation(fields: [cronId], references: [id], onDelete: Cascade)

  @@unique([cronId, startedAt])
  @@index([cronId, startedAt(sort: Desc)])
  @@map("cron_run")
}

// ───────────────────────────────────────────────────────────────────────────
// HookDef — inbound-webhook triggers (webhook-triggers-and-github-events.md)
//   A hook maps an inbound webhook delivery to ONE agent turn. The CP owns the
//   definition and compiles it into relay-side rules (rc/hook-assign, broadcast
//   to the whole pool); the relay is the public ingress — event payloads never
//   touch the CP, these rows are definitions + run metadata only.
// ───────────────────────────────────────────────────────────────────────────

enum HookKind {
  webhook // generic inbound webhook (POST /webhooks/in/:token on the relay)
  github // GitHub event subscription (P2)
}

enum HookSessionMode {
  perDelivery // new ACP session per delivery (webhook-kind default)
  perThread // source-thread affinity: github = repo#number (github-kind default & only)
  shared // the whole hook shares one session (webhook-kind opt-in)
}

enum HookReviewPolicy {
  off
  comment
  request_changes
  full
}

enum HookReportingMode {
  off
  check
  status
}

enum HookGateMode {
  informational
  required
}

model HookDef {
  id                                 String            @id @default(uuid()) @db.Uuid
  orgId                              String
  agentId                            String?           @db.Uuid // required at the API; nullable only for legacy inert rows
  kind                               HookKind
  name                               String
  enabled                            Boolean           @default(true)
  // No trigger prompt: the agent's description is its standing context and the
  // delivery payload carries the caller's message (design security boundary 1).
  sessionMode                        HookSessionMode
  // ── kind=webhook ──
  urlToken                           String?           @unique // ≥128-bit random ingress routing key (capability URL; canEdit-visible)
  // hmacSecret lives in HookSecret — never on this row (accidental-serialization guard)
  // ── kind=github (P2) ──
  repoId                             BigInt? // GitHub numeric repo id — the match key (rename-proof)
  repoFullName                       String? // "owner/repo" — display + create-time validation; never matched on
  githubSessionKey                   String? // immutable per-thread namespace; existing rows keep their pre-rename owner/repo
  events                             String[]          @default([]) // "issues:opened" / "pull_request:*" / "issue_comment:created"
  commentFamilies                    String[]          @default([]) // empty = legacy repo-wide comments; otherwise issues/pull_request scope
  labelFilter                        String[]          @default([]) // non-empty ⇒ issue/PR must carry one of these labels
  mentionOnly                        Boolean           @default(false) // P3 summon mode: authored event text must @<agent-name> or @<app-slug>
  // Durable configuration/dispatch fences.  configRevision changes whenever
  // the compiled definition changes; dispatchRevision additionally changes
  // when the owning agent is re-placed.
  configRevision                     BigInt            @default(1)
  dispatchRevision                   BigInt            @default(1)
  // Changes only when the review projection binding/lifecycle changes
  // (enablement, agent/repo binding, reporting transport, or gate mode). It is
  // part of the projection natural key, so a one-way tombstone from an older
  // lifecycle can never suppress a later explicit re-enable on the same SHA.
  projectionEpoch                    BigInt            @default(1)
  reviewPolicy                       HookReviewPolicy  @default(off)
  reportingMode                      HookReportingMode @default(off)
  gateMode                           HookGateMode      @default(informational)
  requiredAcknowledgedAt             DateTime?         @db.Timestamptz(6)
  requiredAcknowledgedByUserId       String?
  requiredAcknowledgedConfigRevision BigInt?
  // ── output anchoring (same trio as CronDef.target*; null channel ⇒ headless) ──
  targetPlatform                     Platform          @default(slack)
  targetChannel                      String?
  targetIntegrationId                String?           @db.Uuid
  lastFiredAt                        DateTime?         @db.Timestamptz(6) // advisory; bumped on rc/run-report
  // A hook is subordinate to ONE agent (like an Integration, unlike a CronDef):
  // it is only ever listed under that agent, so it carries NO visibility of its
  // own — access is gated by the owning agent's visibility. createdBy is audit.
  createdByUserId                    String?
  lastModifiedByUserId               String?
  lastModifiedAt                     DateTime          @default(now()) @db.Timestamptz(6)
  createdAt                          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime          @updatedAt @db.Timestamptz(6)

  org               Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent             Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  targetIntegration Integration? @relation(fields: [targetIntegrationId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation("HookCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy    User?        @relation("HookModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  secret            HookSecret?

  @@index([orgId])
  @@index([agentId])
  @@index([kind, repoId]) // github rule-compile main query (P2)
  @@map("hook_def")
}

// Per-hook HMAC signing key, 1:1 with HookDef. BotSecret discipline: list/DTO
// queries never join it, it is read only through the HookSecretStore, and it is
// echoed exactly once in the create response. The stored value passes through
// SecretCipher: plaintext under `none`, ciphertext under an encrypting provider.
model HookSecret {
  hookId     String @id @db.Uuid
  hmacSecret String // stored SecretCipher representation; read ONLY via HookSecretStore

  hook HookDef @relation(fields: [hookId], references: [id], onDelete: Cascade)

  @@map("hook_secret")
}

// One webhook delivery that fired (or failed to fire) an agent turn. Two-stage
// lifecycle: the relay's rc/run-report opens the row (`running` on accepted, or
// `failed` outright on a delivery failure), the daemon's hook/report completion
// EVT closes it. `running` rows whose completion was lost are reconciled to
// `failed` (orphaned) by the HookRunReaper; a late completion still overwrites
// (last-writer-wins). (hookId, deliveryKey) is the idempotency key absorbing
// GitHub redeliveries and reconcile re-posts.
model HookRun {
  id                        String             @id @default(cuid())
  hookId                    String             @db.Uuid
  orgId                     String
  deliveryKey               String // X-GitHub-Delivery GUID / X-AC-Delivery-Key / relay-minted uuid
  event                     String? // github: "issues:opened"; webhook kind: null (metadata, never a body)
  startedAt                 DateTime           @db.Timestamptz(6) // RcRunReport.firedAt (relay ingest time)
  // Exact accepted dispatch snapshot.  Nullable only for legacy rows whose
  // relay/daemon predates the R1 protocol additions.
  agentId                   String?            @db.Uuid
  configRevision            BigInt?
  dispatchRevision          BigInt?
  projectionEpoch           BigInt?
  dispatchDaemonId          String?            @db.Uuid
  reviewPolicySnapshot      HookReviewPolicy?
  reportingModeSnapshot     HookReportingMode?
  gateModeSnapshot          HookGateMode?
  projectionIntent          String?
  repoId                    BigInt?
  repoFullName              String?
  sourceInstallationId      BigInt?
  subjectKind               String?
  pullNumber                Int?
  headSha                   String?
  baseSha                   String?
  reportSha                 String?
  isDraft                   Boolean?
  baseChanged               Boolean?
  turnStartedAt             DateTime?          @db.Timestamptz(6)
  completedAt               DateTime?          @db.Timestamptz(6)
  orphanedAt                DateTime?          @db.Timestamptz(6)
  projectionId              String?            @db.Uuid
  projectionGeneration      BigInt?
  reviewAttemptId           String?            @unique @db.Uuid
  reviewAttemptState        String?
  reviewErrorCode           String?
  reviewId                  String?
  reviewEvent               String?
  verdict                   String?
  reviewCommitId            String?
  status                    CronRunStatus      @default(running)
  durationMs                Int?
  sessionId                 String? // ACP session id (console deep-link); null while running
  reason                    String? // short failure text: daemon_offline / dispatch_timeout / orphaned / turn failure
  // Durable, metadata-only GitHub redelivery schedule. These fields are used
  // only for delivery-stage failures that are explicitly classified as safe
  // to retry; no webhook payload is stored in the control plane.
  redeliveryAttempts        Int                @default(0)
  redeliveryLastRequestedAt DateTime?          @db.Timestamptz(6)
  redeliveryNextAttemptAt   DateTime?          @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([hookId, deliveryKey])
  @@index([orgId])
  @@index([hookId, startedAt(sort: Desc)])
  @@index([hookId, repoId, reportSha, startedAt(sort: Desc)])
  @@index([projectionId, projectionGeneration])
  @@index([status, startedAt])
  @@index([deliveryKey, status, redeliveryNextAttemptAt])
  @@index([status, redeliveryNextAttemptAt, redeliveryAttempts], map: "hook_run_redelivery_due_idx")
  @@map("hook_run")
}

// Durable GitHub Checks/status projection.  It deliberately has no FK to
// HookDef/Agent/Org: cleanup must still run after an owner row is deleted.
model HookReviewProjection {
  id                         String  @id @default(uuid()) @db.Uuid
  hookId                     String  @db.Uuid
  orgId                      String
  agentId                    String  @db.Uuid
  // Stable, single-line agent slug displayed in the external Check summary.
  // Snapshotted because this projection must survive Agent deletion for cleanup.
  agentName                  String?
  lastResolvedInstallationId BigInt?
  repoId                     BigInt
  repoFullName               String
  headSha                    String
  reportSha                  String
  projectionEpoch            BigInt

  generation       BigInt  @default(0)
  currentHookRunId String?
  externalId       String  @unique
  checkRunId       String? @unique

  mode          HookReportingMode
  gateMode      HookGateMode
  desiredState  String
  observedState String?
  sealedThrough BigInt            @default(0)

  // Live commit -> current PR association is evaluated once per generation
  // before a terminal informational Check write. The canonical desired state
  // remains untouched when association fails closed.
  subjectSyncGeneration BigInt  @default(0)
  subjectSyncErrorCode  String?

  leaseOwner     String?
  leaseUntil     DateTime? @db.Timestamptz(6)
  nextAttemptAt  DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastErrorCode  String?
  pendingIntent  Json?     @db.JsonB
  writeMarker    String?   @unique
  writePhase     String?
  writeStartedAt DateTime? @db.Timestamptz(6)
  tombstonedAt   DateTime? @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  subjects HookReviewSubject[]

  @@unique([hookId, repoId, reportSha, projectionEpoch])
  @@index([orgId])
  @@index([nextAttemptAt, leaseUntil])
  @@index([agentId, repoId])
  @@index([lastResolvedInstallationId])
  @@map("hook_review_projection")
}

model HookReviewSubject {
  projectionId String   @db.Uuid
  pullNumber   Int
  headSha      String
  baseSha      String?
  isOpen       Boolean  @default(true)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  projection HookReviewProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  @@id([projectionId, pullNumber])
  @@index([headSha])
  @@map("hook_review_subject")
}

// ───────────────────────────────────────────────────────────────────────────
// Relay — one registered ingress-relay instance (shared-bot-relay.md §6)
//   The relay pool is the platform's unified inbound plane: webchat now,
//   shared-bot + webhook with milestone B. Instances register dynamically over
//   the relay WS (`rc/register`); `lastSeenAt` is bumped by `rc/heartbeat` and
//   drives the liveness sweeper (stale rows are swept, and — milestone B —
//   their bots reassigned). No org column: relays are deployment-level infra
//   serving every tenant. No FKs and no secret material.
// ───────────────────────────────────────────────────────────────────────────

model Relay {
  id         String    @id @db.Uuid // minted by the CP on rc/register → rc/registered
  // Deployment-side identity (pod name etc.) — THE upsert key: a relay is
  // stateless, so after a restart `name` is its only stable identity and
  // re-registration reclaims the same row (and relayId). Unique so the upsert
  // is atomic (no duplicate rows for one pod racing the sweeper).
  name       String    @unique
  // The address daemons dial for THIS relay instance. MUST route to this
  // specific instance (per-pod DNS, or one hostname with relay-id-sticky
  // paths) — a pool-level random LB here breaks the no-cross-pod-forwarding
  // topology (design §5). The pool-level public ingress (browser/webhook) is
  // env-level PUBLIC_RELAY_URL and never stored per relay.
  daemonUrl  String
  lastSeenAt DateTime? @db.Timestamptz(6) // rc/heartbeat; drives the failover sweeper
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([lastSeenAt])
  @@map("relay")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.15 Bot + Integration — a platform bot identity and its install (C6/C5)
//   `bot` is the durable identity (name + token material): it OUTLIVES the
//   integration that installs it, so uninstalling frees the bot for reuse from
//   the console picker instead of forcing a re-create. `bot_secret` holds the
//   stored SecretCipher representation behind the BotSecretStore seam — the ONLY
//   read/write path for tokens. `none` stores plaintext; an encrypting provider
//   stores ciphertext. `integration` is the install: it binds ONE bot to
//   ONE agent (`botId` unique ⇒ a bot serves at most one agent at a time) and
//   is what the owning daemon opens the socket from. The metadata read paths
//   (GET /bots, GET /integrations) never select the secret table.
// ───────────────────────────────────────────────────────────────────────────

model Bot {
  id              String         @id @db.Uuid
  orgId           String
  platform        Platform       @default(slack)
  name            String // Slack app / display name
  prebuilt        Boolean        @default(false) // provisioned by AgentConnect, not a console user
  slackAppId      String? // Slack app id (A…), parsed from the pasted xapp token — deep-links the console to api.slack.com/apps/{id}. Public metadata, NOT secret material.
  discordAppId    String? // Discord application (client) id, decoded from the bot token's first segment — lets the console offer a ready-made "Add to Discord" invite URL. Public metadata (it IS the bot's user id), NOT secret material.
  feishuRegion    String? // Feishu/Lark open-platform gateway for this app: 'feishu' (open.feishu.cn) | 'lark' (open.larksuite.com). NULL ⇒ 'feishu'. DURABLE home (survives uninstall) so a freed Lark bot reinstalls against the right gateway. Public config, NOT secret.
  // Shared-bot opt-in (shared-bot-relay.md §4.1). false ⇒ classic 1-bot:1-agent
  // (daemon owns the whole socket, zero behaviour change). true ⇒ the bot's
  // INBOUND migrates to a relay and it may serve MULTIPLE agents (one Integration
  // row per agent). Per-bot, not per-install — a uniform rule, no mode switching.
  shareable       Boolean        @default(false)
  // Slack ingress transport (slack-http-mode). `socket` ⇒ classic Socket Mode: the
  // owning daemon holds the xapp connection (direct spec). `http` ⇒ the relay pool
  // receives inbound over the stable PUBLIC_RELAY_URL Events API endpoint and the
  // daemon gets a send-only (shared) spec. This is the direct-vs-shared axis;
  // `shareable` is now the multi-agent-within-http sub-flag. Immutable post-create
  // (the Slack app's request_url is set once at app creation).
  transport       SlackTransport @default(socket)
  createdByUserId String? // WebUI user who registered it (audit)
  lastUsedAt      DateTime?      @db.Timestamptz(6) // stamped when its integration is removed
  lastAgentName   String? // agent the bot was last freed from (console display hint)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  secret       BotSecret?
  // A shareable bot backs MANY installs (one per agent); a classic bot backs ≤1.
  // The 1-install cap for classic bots is enforced in the install route, not by a
  // unique FK (dropped so shared bots can fan out).
  integrations Integration[]

  @@index([orgId])
  @@map("bot")
}

/**
 * Slack inbound transport for a bot (slack-http-mode). See Bot.transport.
 */
enum SlackTransport {
  socket
  http
}

model BotSecret {
  botId         String  @id @db.Uuid
  botToken      String // xoxb-… / Telegram token in stored SecretCipher form; read ONLY via BotSecretStore
  appToken      String? // xapp-… — Slack Socket Mode only; NULL for Telegram (single bot token)
  // Slack signing secret — verifies inbound Events API POSTs (HMAC). Lives ONLY here
  // + is shipped to the relay in rc/bot-assign (http transport); daemons never get it.
  signingSecret String? // Slack signing secret (http transport); NULL for socket/Telegram

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_secret")
}

// ───────────────────────────────────────────────────────────────────────────
// SharedThreadAgent (slack-http-mode §10) — durable per-sessionKey thread affinity
// for http-transport shared bots. A relay reports (botId, sessionKey)→{agentId,
// daemonId} the first time it routes a thread (rc/thread-assign); the CP persists it
// here (single writer) and broadcasts it to every relay (rc/assign), and answers a
// pull-on-miss lookup (rc/thread-lookup). Relay-opaque `sessionKey`; no FKs (daemon/
// agent may churn — mirrors relay / github_install_state FK-less infra).
// ───────────────────────────────────────────────────────────────────────────
model SharedThreadAgent {
  botId      String   @db.Uuid
  sessionKey String
  agentId    String   @db.Uuid
  daemonId   String   @db.Uuid
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@id([botId, sessionKey])
  @@index([botId])
  @@map("shared_thread_agent")
}

enum IntegrationStatus {
  active
  revoked
}

model Integration {
  id              String            @id @db.Uuid // IntegrationSpec.integrationId
  orgId           String
  agentId         String            @db.Uuid // owner ⇒ delivery daemon (agent.daemonId)
  // The identity this install runs as. NO @unique: a shareable bot fans out to
  // one Integration row per agent (shared-bot-relay.md §4.1). A classic
  // (non-shareable) bot is still capped at ≤1 install by the create route.
  botId           String            @db.Uuid
  platform        Platform          @default(slack)
  name            String // Slack app / display name (mirrors bot.name at install time)
  status          IntegrationStatus @default(active)
  feishuRegion    String? // Feishu/Lark open-platform gateway: 'feishu' (open.feishu.cn) | 'lark' (open.larksuite.com). NULL ⇒ 'feishu' (default / non-feishu integrations). Public config, NOT secret.
  createdByUserId String? // WebUI user who installed it (audit)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  org             Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent           Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Restrict: the bot is the durable identity — it must never vanish underneath a
  // live install. Uninstall deletes the integration row and FREES the bot.
  bot             Bot                  @relation(fields: [botId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  channels        IntegrationChannel[]
  // Crons/hooks whose target anchor posts through this integration (SetNull on uninstall).
  targetedByCrons CronDef[]
  targetedByHooks HookDef[]

  @@index([orgId])
  @@index([agentId])
  @@index([botId])
  @@map("integration")
}

// How the bot activates in one conversation: not at all (conversation gating,
// resource-visibility.md §14), only when @-mentioned, or on any message.
enum ChannelTrigger {
  off
  mention
  any
}

// Conversation kind (resource-visibility.md §14.3): a member channel vs a DM
// conversation. DM rows exist only for gated (restricted-agent) integrations.
enum ConversationKind {
  channel
  im
}

// One conversation the integration's bot participates in. `integration/channels`
// carries either an authoritative membership snapshot or a partial observed-
// conversation report; DM rows and rows absent from partial reports are retained.
// The operator's per-conversation trigger survives both forms. Channel id/name are
// control metadata — never message content (§1/§12).
model IntegrationChannel {
  integrationId String           @db.Uuid
  channelId     String // platform conversation id (Slack "C…" / DM "D…")
  name          String? // "#deploys" without the hash (or DM counterpart); null if lookup failed
  isPrivate     Boolean          @default(false)
  kind          ConversationKind @default(channel)
  // Relay-backed channel rows repeat the effective trigger across each active
  // integration so deleting the canonical owner does not discard channel state.
  // DM rows remain independently gated per integration.
  trigger       ChannelTrigger   @default(mention)
  // Per-channel default/owning agent for a SHARED bot (shared-bot-relay.md §10.1
  // channel ownership — the primary disambiguation path). Exactly one active
  // integration row per shared channel carries the owner; sibling rows are null.
  // Irrelevant for a classic integration, where its agent is the only target.
  agentId       String?          @db.Uuid
  firstSeenAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, channelId])
  @@index([agentId])
  @@map("integration_channel")
}

// Pending Slack auto-install session (docs/designs/slack-install-smoothing.md §Tier B).
// A short-lived bridge for the config-token funnel: the app is created via
// apps.manifest.create and its client credentials + the OAuth-obtained bot token
// live here until the operator pastes the app-level token and `finalize` creates
// the real bot + integration (then this row is DELETED). `clientSecret`/`botToken`
// pass through SecretCipher with the same discipline as `bot_secret` — plaintext
// under `none`, ciphertext under an encrypting provider; NEVER logged or included
// in a DTO. No FKs (mirrors github_install_state): a dangling row after an
// org/agent delete is harmless and TTL-reaped. The `id` doubles as the
// unforgeable OAuth `state`.
model SlackInstall {
  id              String         @id @db.Uuid // == OAuth state
  orgId           String
  agentId         String         @db.Uuid // install target (owner ⇒ delivery daemon)
  appId           String // A… — manifest-created app id (deep links + association)
  clientId        String
  clientSecret    String // sensitive — secret discipline, never logged/DTO'd
  botToken        String? // xoxb-…, backfilled by the OAuth callback
  name            String? // operator-chosen app name; null ⇒ derived at finalize
  // slack-http-mode quick-install: the finalize path + the http signing secret that
  // apps.manifest.create returns at start (the browser never sees it), so an http
  // auto-install finalizes with no manual paste. `shareable` is NOT stored — it's a
  // non-secret choice the console re-sends in the finalize body.
  transport       SlackTransport @default(socket)
  signingSecret   String? // http: captured at app-create; used at finalize
  createdByUserId String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)

  @@map("slack_install")
}

// One user's stored Slack App Configuration Token, scoped to an org (composite key
// orgId+userId) — docs/designs/slack-install-smoothing.md §Tier B. PER-USER on purpose:
// the app that `apps.manifest.create` builds is owned by whoever's config token
// created it, and only that user can then generate the app's app-level (xapp) token
// on api.slack.com. So each initiator stores their OWN token and installs entirely
// on their own — no shared token that pins every app to one person. When the caller
// has one AND the funnel is enabled, the console FORCES auto-install; absent ⇒ the
// manual flow. The access token expires ~12h after issue, so we persist the refresh
// token and rotate via `tooling.tokens.rotate` when it is stale (each rotate returns
// a NEW pair — last write wins). `accessToken`/`refreshToken` pass through
// SecretCipher with the same discipline as `bot_secret`: plaintext under `none`,
// ciphertext under an encrypting provider; NEVER logged or included in a DTO.
model SlackUserConfig {
  orgId           String
  userId          String
  accessToken     String // xoxe.xoxp-… — the App Configuration access token
  refreshToken    String? // xoxe-… — used to rotate a fresh access token; null ⇒ access-only (expires ~12h, then re-enter)
  accessExpiresAt DateTime @db.Timestamptz(6) // when accessToken expires (~12h; drives rotation / re-entry)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("slack_user_config")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.12 AuditEvent — audit log / events feed (C6 + C7)
// ───────────────────────────────────────────────────────────────────────────

enum AuditKind {
  daemon_auth
  daemon_register
  daemon_unreachable
  route_assign
  route_release
  drain
  agent_launch
  agent_stop
  scope_denied
  secret_grant
  secret_revoke
  cron_change
  hook_change
  agent_repo_change
  org_invite_change
  protocol_error
  api_key_create
  api_key_rotate
  api_key_revoke
  mcp_tool_call
}

model AuditEvent {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  orgId       String?
  kind        AuditKind
  daemonId    String?   @db.Uuid
  agentId     String?   @db.Uuid
  sessionId   String?   @db.Uuid
  actorUserId String? // set when action came from WebUI
  frameType   String? // "route/assign", "error", …
  frameCorr   String?   @db.Uuid // Envelope.id / corr (tracing)
  message     String?   @db.Text // redacted, human-readable
  details     Json?     @db.JsonB // {expected:<seq>}, {capability}, …
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@index([daemonId, createdAt])
  @@index([kind, createdAt])
  @@map("audit_event")
}

// ── GitHub App (github-app workspaces; docs/designs/github-app-git-credentials.md §Configuration and Data Model) ──
// The App identity itself (id/slug/private key) is DEPLOYMENT CONFIG (GITHUB_APP_* env),
// never persisted. Only its installations are rows, claimed to an org.
// Visibility taxonomy: infrastructure, like `bot` — always org-visible, never restricted.

enum GitAccess {
  read
  write
}

/// One installation of the deployment GitHub App on a GitHub org/user account,
/// claimed by an AgentConnect org. Rows are only ever MARKED dead (`revokedAt`)
/// — never deleted — because agents keep `installationId` provenance pointers;
/// minting resolves live installations by account login, not by row liveness.
model GithubInstallation {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String
  installationId      BigInt    @unique // GitHub-side installation id
  accountLogin        String // e.g. "example-org"
  accountType         String // "Organization" | "User"
  repositorySelection String // "all" | "selected"
  // Installation-effective permissions as returned by GitHub. Unknown/legacy
  // rows use {}, which is intentionally fail-closed for review/check effects.
  permissions         Json      @default("{}") @db.JsonB
  suspendedAt         DateTime? @db.Timestamptz(6)
  revokedAt           DateTime? @db.Timestamptz(6) // sync found it uninstalled ⇒ mark, don't delete
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("github_installation")
}

/// One-shot HMAC-signed install-state nonces (the `state` on the GitHub install
/// deep link / setup callback). Consumed exactly once — replay ⇒ reject. Expired
/// rows are garbage; consumption deletes, and expiry is also embedded in the
/// signed state itself so stale rows can never be replayed.
model GithubInstallState {
  nonce     String   @id // random 128-bit, base64url
  orgId     String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("github_install_state")
}

// ───────────────────────────────────────────────────────────────────────────
// Centralized tool management — MCP provider registry (docs/designs/
// centralized-tool-management.md). CP owns MCP provider definitions; the relay
// reverse-proxies agent calls so the upstream credential never reaches the
// daemon/agent. Mirrors the Bot / BotSecret split: metadata table + secret
// side-table read only via McpProviderSecretStore.
// ───────────────────────────────────────────────────────────────────────────
enum McpTransport {
  http
  sse
}

// How a provider row was created / what manages it. `custom` = an operator-entered
// upstream MCP server (url + headers). `open_connector` = a connection provisioned
// through the open-connector integration (docs: connectors); the url is the
// open-connector /mcp endpoint and the upstream header carries the connection
// profile alias. Display + create-flow discriminator only — the wire (rc/mcp-assign,
// daemon proxy def) is identical for both.
enum McpProviderKind {
  custom
  open_connector
}

model McpProvider {
  // uuid (not cuid): providerId rides the wire as rc/mcp-assign.providerId (z.string().uuid()).
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String
  name            String // reference key; the agent enable-list + probe facts key on it
  kind            McpProviderKind    @default(custom) // custom upstream vs open-connector connection
  transport       McpTransport       @default(http) // v1 accepts http (Streamable HTTP) only
  url             String // upstream endpoint (non-secret; may appear in DTOs)
  // Console visibility — same Shareable model as Agent/Daemon/Cron
  // (docs/designs/resource-visibility.md): 'org' = every member sees it; 'restricted'
  // = creator + owners + sharedWith. Governs console access only — an agent that
  // already enabled a provider keeps reaching it regardless (never crosses the wire).
  visibility      ResourceVisibility @default(org)
  sharedWith      String[]           @default([]) // app_user.id set granted view when visibility='restricted'
  createdByUserId String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  org       Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  secret    McpProviderSecret?
  grants    McpGrant[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("mcp_provider")
}

// Upstream auth headers pass through SecretCipher: plaintext under `none`,
// ciphertext under an encrypting provider. Read ONLY via
// McpProviderSecretStore, never in a DTO, and never pushed to a daemon (same
// discipline as bot_secret). Shipped to the relay in rc/mcp-assign, injected on
// forward.
model McpProviderSecret {
  mcpProviderId String @id @db.Uuid
  headers       Json   @default("[]") @db.JsonB // {name,value}[] — upstream apikey etc.

  provider McpProvider @relation(fields: [mcpProviderId], references: [id], onDelete: Cascade)

  @@map("mcp_provider_secret")
}

// A proxy grant: the bearer key the daemon injects into the agent and the relay
// validates. v1 = one active grant per provider (shared identity). The CP re-pushes
// the plaintext key to daemons on every reconcile, so the persisted value must be
// recoverable through SecretCipher. `none` stores plaintext; an encrypting provider
// stores ciphertext. The key remains store-only and never enters a DTO; the relay
// receives only sha256(key) via rc/mcp-assign.
model McpGrant {
  id            String   @id @default(cuid())
  mcpProviderId String   @db.Uuid
  key           String   @unique // bearer grant key in stored SecretCipher form; store-only
  status        String   @default("active") // active | revoked
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  provider McpProvider @relation(fields: [mcpProviderId], references: [id], onDelete: Cascade)

  @@index([mcpProviderId])
  @@map("mcp_grant")
}

// ───────────────────────────────────────────────────────────────────────
// Shared skills registry (docs/designs/shared-skills.md). The CP records only
// the SOURCE (a repo / git URL / tree path) plus an optional ref + skill
// filter — skill CONTENT never touches the CP. The daemon installs enabled
// skills via `npx skills` after clone and before the ACP host spawns. There is
// no secret side-table or grant: skills are plain content, and private-repo
// reads reuse the existing GitHub App short-lived token path on the daemon.
//
// The per-agent enable-list is NOT a relation here; like mcpServers it lives as
// a string[] of "<sourceName>/<skillName>" (or "<sourceName>/*") inside the
// agent's runtimeOverrides JSON bag. The CP resolves those into self-contained
// AgentSpec.skills entries when it assembles the spec (agentSpecAssembler).
model SkillSource {
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String
  name            String // reference key; the agent enable-list keys on it. @@unique([orgId, name])
  source          String // fed to `npx skills add` (owner/repo | git URL | tree/<ref>/<subdir>)
  githubRepoId    BigInt? // GitHub numeric id — survives rename/re-create (mirrors AgentRepoAuthorization)
  ref             String? // optional branch/tag/commit; composed into the source (design §5)
  subDir          String? // optional repo-relative install dir
  skills          String[]           @default([]) // empty ⇒ install every skill; else only these (passed as -s)
  visibility      ResourceVisibility @default(org)
  sharedWith      String[]           @default([]) // app_user.id set granted view when visibility='restricted'
  createdByUserId String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("skill_source")
}

// ───────────────────────────────────────────────────────────────────────
// External-memory plugin control plane (docs/designs/memory-evolution.md M-5A).
// Purpose-separated from the model-facing MCP registry. Upstream secret values
// and daemon grant keys live only in side tables whose values pass through the
// configured SecretCipher.
// ────────────────────────────────────────────────────────────────────────
enum MemoryPluginTransport {
  streamable_http
  stdio
}

enum ExternalMemoryConnectionStatus {
  probing
  ready
  degraded
  invalid
}

model MemoryPluginInstallation {
  id                     String                @id @default(uuid()) @db.Uuid
  orgId                  String
  pluginId               String
  transport              MemoryPluginTransport @default(streamable_http)
  endpoint               String?
  commandRef             String?
  pinnedProfileMajor     Int                   @default(1)
  expectedManifestDigest String?
  // Reviewed logical-secret → upstream-header mapping. Header names are
  // configuration; values live only in ExternalMemoryConnectionSecret.
  secretHeaders          Json                  @default("[]") @db.JsonB
  createdByUserId        String?
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)

  org         Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?                      @relation("MemoryPluginInstallationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  connections ExternalMemoryConnection[]

  // One plugin may have multiple independently reviewed immutable pins: another
  // endpoint, manifest digest, or secret contract must not overwrite agents
  // still using the old installation.
  @@index([orgId, pluginId])
  @@map("memory_plugin_installation")
}

model ExternalMemoryConnection {
  id                  String                         @id @default(uuid()) @db.Uuid
  orgId               String
  installationId      String                         @db.Uuid
  config              Json                           @default("{}") @db.JsonB
  status              ExternalMemoryConnectionStatus @default(probing)
  revision            Int                            @default(1)
  probedRevision      Int?
  pluginVersion       String?
  profile             String?
  manifestDigest      String?
  capabilities        Json?                          @db.JsonB
  declaredEgressHosts String[]                       @default([])
  reasonCode          String?
  createdByUserId     String?
  createdAt           DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                       @updatedAt @db.Timestamptz(6)

  org          Org                             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installation MemoryPluginInstallation        @relation(fields: [installationId], references: [id], onDelete: Restrict)
  createdBy    User?                           @relation("ExternalMemoryConnectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  secret       ExternalMemoryConnectionSecret?
  grants       ExternalMemoryGrant[]

  @@index([orgId])
  @@index([installationId])
  @@map("external_memory_connection")
}

model ExternalMemoryConnectionSecret {
  connectionId String @id @db.Uuid
  values       Json   @default("{}") @db.JsonB

  connection ExternalMemoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("external_memory_connection_secret")
}

model ExternalMemoryGrant {
  id           String   @id @default(cuid())
  connectionId String   @db.Uuid
  key          String   @unique
  status       String   @default("active")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  connection ExternalMemoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("external_memory_grant")
}
