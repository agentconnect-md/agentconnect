// AgentConnect Control Plane — Persistence (C6).
//
// PostgreSQL is metadata-only for message, transcript, and agent-memory bodies.
// Approved organization Knowledge Markdown and bounded immutable managed-skill
// ZIP revisions are the explicit shared-content exception described in
// docs/designs/organization-knowledge.md; pending suggestion bodies remain on
// their source daemon.
//
// See docs/designs/control-plane-implementation.md §3.

generator client {
  provider     = "prisma-client"
  // v7 emits TypeScript source compiled with the app (tsc). Output lives under
  // `src/` so `rootDir: src` picks it up; it is gitignored and regenerated by
  // `prisma:generate` in CI and the Docker build. No query-engine binary — v7
  // uses the queryCompiler + the `@prisma/adapter-pg` driver adapter.
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Connection URL is supplied at runtime via the pg driver adapter (see
  // `persistence/prisma.ts`) and to the CLI via `prisma.config.ts`
  // (`datasource.url`). v7 deprecates a `url` here, so it is intentionally omitted.
}

// Deployment-wide operator configuration. There is exactly one row (`id = 1`),
// enforced by the migration. `values` is a versioned, application-validated
// JSON document; secret values live in the side table and never join ordinary
// configuration reads.
model DeploymentConfig {
  id              Int      @id
  schemaVersion   Int
  values          Json     @db.JsonB
  revision        Int      @default(1)
  adminClaimedFor String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  secrets DeploymentSecret[]

  @@map("deployment_config")
}

model DeploymentSecret {
  deploymentConfigId Int
  key                String
  value              String
  // Stable, truncated digest of the plaintext for redacted operator status.
  // It is never used for authentication.
  fingerprint        String
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  deploymentConfig DeploymentConfig @relation(fields: [deploymentConfigId], references: [id], onDelete: Cascade)

  @@id([deploymentConfigId, key])
  @@map("deployment_secret")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.2 Tenancy axis — Org / User / Membership (C2/C4 WebUI authz)
// ───────────────────────────────────────────────────────────────────────────

model Org {
  id                     String          @id @default(cuid())
  // Optional display name; when absent the console falls back to `slug`.
  name                   String?
  slug                   String          @unique
  // Immutable provenance: the user credited with creating the org — what the creation quota counts.
  createdByUserId        String?
  // Console avatar descriptor (protocol AgentIcon): {kind:'runtime'} | {kind:'glyph',glyph,color}
  // | {kind:'image'}. Null ⇒ generated default (glyph plate keyed off the org id). An `image`
  // icon's bytes live in the object store (docs/designs/icon-uploads.md), served by GET
  // /v1/orgs/:id/icon. Org icons are console-only — never fed to Slack.
  icon                   Json?           @db.JsonB
  // Applied to both call directions when a new agent does not explicitly choose
  // a policy. Existing agents keep their persisted directional policies.
  defaultAgentVisibility AgentCallPolicy @default(all)
  // Console onboarding wizard done — set once by an owner (finish OR skip); entering
  // an org with this false (as owner) opens the wizard instead of the console.
  onboardingCompleted    Boolean         @default(false)
  // Getting-started tutorial position: how many checklist steps this org has passed
  // (completed or skipped via Next). Monotonic, advanced by the console drawer.
  gettingStartedStep     Int             @default(0)
  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)

  createdBy                 User?                         @relation("OrgCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members                   Membership[]
  daemons                   Daemon[]
  agents                    Agent[]
  memberSets                MemberSet[]
  crons                     CronDef[]
  hooks                     HookDef[]
  codeHostRepositories      CodeHostRepository[]
  apiKeys                   ApiKey[]
  integrations              Integration[]
  bots                      Bot[]
  githubInstallations       GithubInstallation[]
  gitlabConnections         GitlabConnection[]
  gitlabProjectBindings     GitlabProjectBinding[]
  gitlabAgentAccounts       GitlabAgentAccount[]
  slackUserConfigs          SlackUserConfig[]
  linearTokens              LinearToken[]
  inviteLink                OrgInviteLink?
  mcpProviders              McpProvider[]
  skillSources              SkillSource[]
  memoryPluginInstallations MemoryPluginInstallation[]
  externalMemoryConnections ExternalMemoryConnection[]
  webchatConversations      WebchatConversation[]
  webchatMcpDelegations     WebchatMcpDelegation[]
  presetAgents              PresetAgent[]
  organizationKnowledge     OrganizationKnowledge[]
  managedSkills             ManagedSkill[]
  organizationSuggestions   OrganizationSuggestion[]
  externalScopes            ExternalScope[]
  sessionExternalAccess     SessionExternalAccessPolicy[]
  environmentEntries        OrganizationEnvironmentEntry[]
  dutyGroups                DutyGroup[]
  codeHostReviewLeases      CodeHostReviewLease[]
  codeHostReviewOutcomes    CodeHostReviewAttemptOutcome[]

  @@index([createdByUserId])
  @@map("org")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  displayName             String?
  picture                 String? // OIDC `picture` claim (avatar URL); display-only, refreshed on sign-in
  // Set when the user uploads a profile photo. The image itself lives in the icon
  // object store under a key derived from this user id; the timestamp marks it as
  // the active photo and cache-busts its public URL.
  profilePictureUpdatedAt DateTime? @db.Timestamptz(6)
  oidcSubject             String?   @unique // OIDC `sub` → user
  // The moment the user redeemed their waitlist join link = "formal / activated"
  // user. Non-null ⇒ may enter the app
  // and create orgs under WAITLIST_MODE. ONLY the CP's redeem path writes this (the
  // external admin app is not granted write on this column, §7 contract 2). Always
  // null when waitlist mode is off — the column is inert there.
  activatedAt             DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)

  memberships                      Membership[]
  createdOrgs                       Org[]                      @relation("OrgCreatedBy")
  apiKeys                          ApiKey[]
  createdAgents                    Agent[]                    @relation("AgentCreatedBy")
  modifiedAgents                   Agent[]                    @relation("AgentModifiedBy")
  createdIntegrations              Integration[]
  createdBots                      Bot[]
  createdMcpProviders              McpProvider[]              @relation("McpProviderCreatedBy")
  createdSkillSources              SkillSource[]              @relation("SkillSourceCreatedBy")
  createdMemoryPluginInstallations MemoryPluginInstallation[] @relation("MemoryPluginInstallationCreatedBy")
  createdExternalMemoryConnections ExternalMemoryConnection[] @relation("ExternalMemoryConnectionCreatedBy")
  createdDaemons                   Daemon[]                   @relation("DaemonCreatedBy")
  modifiedDaemons                  Daemon[]                   @relation("DaemonModifiedBy")
  createdCrons                     CronDef[]                  @relation("CronCreatedBy")
  modifiedCrons                    CronDef[]                  @relation("CronModifiedBy")
  createdHooks                     HookDef[]                  @relation("HookCreatedBy")
  modifiedHooks                    HookDef[]                  @relation("HookModifiedBy")
  createdRepoAuths                 AgentRepoAuthorization[]   @relation("AgentRepoAuthCreatedBy")
  gitlabConnections                GitlabConnection[]         @relation("GitlabConnectionUser")
  slackConfigs                     SlackUserConfig[]
  createdInviteLinks               OrgInviteLink[]            @relation("OrgInviteLinkCreatedBy")
  inviteRedemptions                OrgInviteRedemption[]
  webchatConversations             WebchatConversation[]
  webchatMcpDelegations            WebchatMcpDelegation[]
  createdEnvironmentEntries        OrganizationEnvironmentEntry[]      @relation("OrgEnvCreatedBy")
  modifiedEnvironmentEntries       OrganizationEnvironmentEntry[]      @relation("OrgEnvModifiedBy")
  authorizedEnvironmentAssignments OrganizationEnvironmentAssignment[] @relation("OrgEnvAuthorizedBy")

  @@map("app_user")
}

// A deleted account's identity boundary: tokens issued at or before `cutoffAt` are
// refused for that subject, so a still-valid pre-deletion bearer cannot re-run JIT
// signup and recreate the account it just lost — not even across a CP restart, where
// the auth plane's in-process cutoff is gone.
//
// Two writers, deliberately: an `AFTER DELETE` trigger on app_user (added by the
// `deleted_identity_trigger` migration) records every deletion as it happens — the CP
// does not perform account deletion, the external admin app does, and the database is
// where both meet — and the auth plane also records what it observes, which covers a
// row that disappeared without the trigger (e.g. a restore from a backup taken before
// it existed).
//
// NOT a ban list: rows are expiry-limited, and once `expiresAt` passes the subject is
// an ordinary newcomer again. Whether a deleted person may re-apply at all is the
// deleting app's policy, not this table's.
model DeletedIdentityCutoff {
  oidcSubject String   @id // the OIDC `sub` whose local row was found missing
  cutoffAt    DateTime @db.Timestamptz(6) // refuse tokens with `iat` <= this
  expiresAt   DateTime @db.Timestamptz(6) // pruned/ignored past this point
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("deleted_identity_cutoff")
}

// One row per deleted organization, recording that its transit key should be
// destroyed (docs/designs/per-org-secret-encryption.md §6). Written inside the
// same transaction that deletes the org, so the intent survives whatever
// happens next; drained by the operator-run `secrets:shred` CLI, which is the
// ONLY thing that ever deletes a key — the CP process cannot.
//
// Deliberately NO foreign key: the row's entire purpose is to outlive the
// organization it names.
//
// The RESOLVED target is stored, not just the org id. Deriving the name at
// drain time would read it from whatever configuration is current then, so
// rotating VAULT_TRANSIT_MOUNT or the org key prefix between the delete and the
// drain would aim the destroy at a name that does not exist — which the
// shredder reads as "already gone", clears the row, and leaves the real key
// alive forever. Pinning the target at delete time makes the tombstone
// self-describing and immune to later configuration changes.
model PendingKeyShred {
  orgId     String   @id // the deleted org (identity + idempotency key)
  mount     String // transit mount as configured when the org was deleted
  keyName   String // fully resolved key name, e.g. <orgKeyPrefix><orgId>
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("pending_key_shred")
}

// Console roles (§3.2): owner = edit everything + manage members/org info (an
// org can have several owners); collaborator = create/edit/run agents, manage
// sessions; viewer = read-only.
enum OrgRole {
  owner
  collaborator
  viewer
}

// Per-resource visibility (docs/designs/resource-visibility.md §1): 'org' (default)
// = visible to every org member; 'restricted' = the complete non-empty
// `sharedWith` audience. Enforced ONLY on console read/write paths —
// never crosses the daemon↔CP wire (a restricted-but-active resource still runs).
enum ResourceVisibility {
  org
  restricted
}

// Directional agent-call policy. The inbound fields control which peers may call
// THIS agent; the outbound fields control which peers this agent may discover/call.
// Separate from ResourceVisibility, which governs human console access.
enum AgentCallPolicy {
  all
  selected
}

model Membership {
  id             String    @id @default(cuid())
  orgId          String
  userId         String
  role           OrgRole   @default(collaborator)
  // When this user joined THIS org — not their account signup. The console's
  // "joined" column reads it, and removal picks the ownership-transfer
  // recipient by it (resource-visibility.md §8.2). Pre-existing rows were
  // backfilled from the cuid embedded in `id`, which is that same instant.
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  // The last time THIS user selected THIS org in the console. Nullable keeps
  // existing memberships in their original insertion order until a choice is made.
  lastSelectedAt DateTime? @db.Timestamptz(6)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("membership")
}

// One shareable join link per org. The token is stored as a peppered hash and
// always grants collaborator for exactly seven days; neither is configurable.
model OrgInviteLink {
  id              String    @id @default(cuid())
  orgId           String    @unique
  tokenHash       String    @unique
  displayTail     String
  expiresAt       DateTime  @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  org         Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("OrgInviteLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  redemptions OrgInviteRedemption[]

  @@map("org_invite_link")
}

// Persists use even after membership removal, so the same account cannot use
// the same link to restore its own access. A newly generated link has a new id.
model OrgInviteRedemption {
  inviteLinkId String
  userId       String
  redeemedAt   DateTime @default(now()) @db.Timestamptz(6)

  inviteLink OrgInviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteLinkId, userId])
  @@index([userId])
  @@map("org_invite_redemption")
}

// ───────────────────────────────────────────────────────────────────────────
// WaitlistEntry — closed-beta admission
//   One row per activation link. TWO write sides share this table (§7):
//     • the EXTERNAL admin app writes approval/mint fields (name, email, status,
//       note, source, tokenHash, displayTail, joinExpiresAt, revokedAt, approved*)
//       — enforced by a column-level least-privilege DB role granted in the migration;
//     • the CP writes ONLY the redemption fields (redeemed*), in the same
//       transaction that sets User.activatedAt.
//   `email` is OPTIONAL and drives the ONE redemption rule (§6): a row WITH an email
//   may be redeemed ONLY by that verified email (strong binding); a row with NO email
//   is a one-time BEARER link — any verified identity may redeem it once, and the
//   redeemer's email is recorded in `redeemedEmail`. `email` stays `@unique` so real
//   emails don't collide and self-signup upserts still work; Postgres treats NULLs as
//   distinct, so any number of bearer rows (email null) coexist.
//   The join link reuses OrgInviteLink's peppered-hash + tail + expiry/revoke
//   shape, but the token is minted by the admin app and only VERIFIED (hashed &
//   compared) by the CP on redeem. Minting/approval/admin-auth are out of this
//   repo's scope; the CP owns the schema + migrations for its application DB.
// ───────────────────────────────────────────────────────────────────────────

enum WaitlistStatus {
  pending // user self-submitted, awaiting review
  approved // admin approved = whitelisted; a join link has been minted
  rejected // admin rejected
}

model WaitlistEntry {
  id     String         @id @default(cuid())
  name   String? // display name for the applicant / invitee (admin- or intake-supplied)
  email  String?        @unique // normalized lowercase (auth.ts); NULL ⇒ bearer link
  status WaitlistStatus @default(pending)
  note   String? // applicant message / admin note
  source String? // 'self' | 'admin' | …

  // ── join link (one per email; minted by the admin app on approve) ──
  tokenHash     String?   @unique // peppered hash; plaintext only ever in the mint response
  displayTail   String? // display-only tail for reconciliation
  joinExpiresAt DateTime? @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)

  // ── approval / redemption audit ──
  approvedByUserId String?
  approvedAt       DateTime? @db.Timestamptz(6)
  redeemedByUserId String? // written ONLY by the CP redeem path
  redeemedAt       DateTime? @db.Timestamptz(6) // written ONLY by the CP redeem path
  redeemedEmail    String? // the redeemer's verified email; written ONLY by the CP redeem path

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("waitlist_entry")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.3 Daemon — fleet registry & fencing root (C4)
// ───────────────────────────────────────────────────────────────────────────

enum DaemonStatus {
  provisioned
  authenticating
  ready
  draining
  unreachable
  disabled
}

enum HealthState {
  ok
  degraded
}

model Daemon {
  id            String  @id @db.Uuid // AuthReq.daemonId (wire UUID)
  orgId         String? // null only for an install-wide pool member shared by every org
  host          String? // RegisterReq.host (display)
  name          String? // human-assigned display name (set via the console, never by the daemon)
  agentVersion  String?
  machineId     String? @db.Uuid // 🅼 AuthReq.machineId (stored, stub-enforced)
  tokenFp       String? // `id` of the authenticating ApiKey (audit; written by upsertOnAuth)
  /// The Kubernetes ServiceAccount subject TokenReview reports; pool members share it and are unique by the reviewed Pod UID.
  clusterIdentity String?
  clusterPodUid   String?
  attestationFp String? // 🅼 last accepted attestation digest
  capabilities  Json    @default("{}") @db.JsonB // {platforms[],runtimes[],acp,features[]}
  /// Rollout generation a pool member reported on register (RegisterReq.generation, the pod-template
  /// hash). Only the newest live generation of a set claims vacated duty groups; null never excludes.
  generation      String?
  generationSince DateTime? @db.Timestamptz(6) // when this row first reported its current generation
  mcpServers    Json    @default("[]") @db.JsonB // facts/daemon-runtimes MCP-server list (FactsMcpServer[] = {name,transport}); replaced whole per frame
  maxAgents     Int     @default(0)

  createdByUserId String? // WebUI user who provisioned the daemon (immutable audit; null for CLI/self-registered). Surfaced in the console "Created" row.

  // ── last-modification audit (human edits only) ──
  // Stamped together on user-initiated writes (provision, rename). Deliberately
  // SEPARATE from `updatedAt`, which the row bumps on every system write
  // (heartbeat, (re)auth, register, watchdog) and so cannot mean "last human edit".
  lastModifiedByUserId String? // WebUI user who last edited the daemon (null ⇒ never edited by a human)
  lastModifiedAt       DateTime @default(now()) @db.Timestamptz(6) // defaults to createdAt; app-bumped on each human edit

  // ── visibility / sharing (docs/designs/resource-visibility.md) ──
  visibility ResourceVisibility @default(org) // 'org' = all members; 'restricted' = the complete sharedWith audience
  sharedWith String[]           @default([]) // complete app_user.id audience when visibility='restricted'

  // ── console-set daemon settings ──
  // Retention window for FINISHED sessions on the daemon's LOCAL store (the console's
  // "Expire sessions" option): 'never' | '7d' | '30d' | '90d'. The CP only stores and
  // delivers it (register/ok baseline + config/push hot update); the daemon's hourly
  // retention sweep is what actually deletes expired sessions.
  sessionRetention String @default("7d")

  // ── fencing root ──
  sessionEpoch BigInt @default(0) @db.BigInt // bumped each successful (re)auth
  routingEpoch BigInt @default(0) @db.BigInt // version of THIS daemon's assignment set

  // Last applied `facts/daemon-runtimes.seq` (per-connection monotonic; reset to
  // NULL on register). Snapshots with an older seq are dropped so interleaved
  // frame transactions cannot commit out of order (runtime-model-catalog.md §5).
  runtimesSnapshotSeq Int?

  // ── liveness / watchdog ──
  status         DaemonStatus @default(provisioned)
  health         HealthState  @default(ok)
  load           Json?        @db.JsonB // Heartbeat.load {cpu,mem,agents}
  activeSessions Int          @default(0)
  degradedScopes String[]     @default([]) // Heartbeat.degradedScopes
  lastSeenAt     DateTime?    @db.Timestamptz(6) // drives watchdog
  unreachableAt  DateTime?    @db.Timestamptz(6) // reassignGrace clock origin

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  org                   Org?                   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("DaemonCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy        User?                  @relation("DaemonModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  agents                Agent[]
  assignments           Assignment[]
  leases                SecretLease[]
  launches              AgentLaunch[]
  runtimeProfiles       RuntimeProfile[]
  apiKeys               ApiKey[]
  sessions              SessionMeta[]
  lifecycleOps          DaemonLifecycleOp[]
  setMembership         MemberSetMember?

  @@unique([clusterIdentity, clusterPodUid], map: "daemon_cluster_identity_pod_key")
  @@index([orgId])
  @@index([status])
  @@index([lastSeenAt])
  @@map("daemon")
}

// ───────────────────────────────────────────────────────────────────────────
// DaemonLifecycleOp — a CP-commanded restart/upgrade in flight (cli-daemon-split.md §7)
//   A console "Restart"/"Upgrade" opens a `pending` row and sends the C→D
//   `daemon/restart` / `daemon/upgrade` REQ. The `DaemonControlAck` only means the
//   daemon accepted the command; the real outcome is closed out-of-band when the
//   daemon drains, its supervisor relaunches it, and it re-registers READY (an
//   upgrade additionally requires its reported `agentVersion` to reach the target
//   within the deadline). A decline (`accepted:false`) or a `deadline` lapse closes
//   the row `failed`. At most one op may be pending per daemon (partial unique index,
//   hand-added in the migration — not faithfully expressible in the Prisma schema).
// ───────────────────────────────────────────────────────────────────────────

enum DaemonLifecycleOpType {
  restart
  upgrade
}

enum DaemonLifecycleOpStatus {
  pending
  succeeded
  failed
}

model DaemonLifecycleOp {
  id            String                  @id @default(cuid())
  daemonId      String                  @db.Uuid
  op            DaemonLifecycleOpType
  targetVersion String? // the version to reach (upgrade only); null for restart
  initiator     String? // app_user.id that commanded it; null under devAuth / system
  status        DaemonLifecycleOpStatus @default(pending)
  // The daemon `sessionEpoch` at command-send time. The op only settles on a READY
  // whose epoch is STRICTLY GREATER (the daemon re-authed after draining + relaunching),
  // so a coincidental reconnect at the same epoch can never close it.
  commandEpoch  BigInt                  @default(0) @db.BigInt
  // Set when the daemon ACKs `accepted:true` (the op is "armed"). A READY before this
  // must NOT settle the op — the command hadn't been accepted/executed yet.
  acceptedAt    DateTime?               @db.Timestamptz(6)
  startedAt     DateTime                @default(now()) @db.Timestamptz(6)
  deadline      DateTime                @db.Timestamptz(6) // drain+relaunch budget; a lapse closes the op `failed`
  outcome       String? // short closure detail (decline reason / "version mismatch" / "expired")
  settledAt     DateTime?               @db.Timestamptz(6) // when it left `pending`
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)

  daemon Daemon @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@index([daemonId, status])
  @@map("daemon_lifecycle_op")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.3a ApiKey — long-lived, revocable control-channel credential (C4)
// ───────────────────────────────────────────────────────────────────────────
// One table with a `principalType` discriminator serves daemon, personal-user,
// relay, and OAuth credentials. Hash-only at rest: the token
// a bare opaque `<secret><crc>` is looked up by `hash = HMAC-SHA256(secret, API_KEY_PEPPER)`
// (@unique); the plaintext is shown exactly once at mint and never persisted.
// See docs/designs/daemon-api-key-auth.md.

enum PrincipalType {
  daemon
  user
  relay // relay↔CP credential (shared-bot-relay.md §8) — org-less infra key
  oauth // access token minted by the embedded OAuth AS (agent-assistant.md §7) — same shape as a user key
}

model ApiKey {
  id            String        @id @default(cuid())
  principalType PrincipalType // daemon | user | relay | oauth
  orgId         String? // org-scoped for daemon/user/oauth keys; NULL for relay keys
  daemonId      String?       @db.Uuid // set iff principalType=daemon
  userId        String? // set iff principalType=user or oauth

  hash            String   @unique // HMAC-SHA256(secret, pepper) hex — NEVER plaintext; the unique lookup key
  displayTail     String // "…a2b1" (non-secret) for the console
  name            String? // human label ("ci-runner-east")
  scopes          String[] @default([]) // daemon/user/relay keys use []; oauth keys carry granted mcp:* scopes
  createdByUserId String? // operator who minted it (audit)
  oauthGrantId    String? // set iff principalType=oauth — links the access token to its OAuthGrant so revoking the grant kills its tokens

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt    DateTime? @db.Timestamptz(6) // throttled write on auth
  expiresAt     DateTime? @db.Timestamptz(6) // long-lived principals may be non-expiring; user/oauth mint policies set TTLs
  revokedAt     DateTime? @db.Timestamptz(6) // kill switch — checked on every auth
  revokedReason String?

  org    Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Cascade: deleting a daemon (DELETE /daemons/:id) removes its keys, so no
  // orphaned credential rows (daemonId-null but still hash-valid) survive.
  daemon Daemon? @relation(fields: [daemonId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([daemonId])
  @@index([userId])
  @@index([orgId, revokedAt])
  @@index([oauthGrantId])
  @@map("api_key")
}

// ───────────────────────────────────────────────────────────────────────────
// Embedded OAuth 2.1 Authorization Server (docs/designs/agent-assistant.md §7)
//   Lets MCP clients (claude.ai / Claude Code) do the browser login flow against
//   the CP. The CP issues its OWN tokens (access token = an `api_key` row with
//   principalType='oauth'); the human login on /authorize is delegated to the web
//   console (Logto / devAuth). These tables hold only the AS's own protocol state.
// ───────────────────────────────────────────────────────────────────────────

// A dynamically-registered (RFC 7591) MCP client. Public clients only (PKCE is the
// proof; no client secret). Reaped after `expiresAt` to bound DCR-table growth.
model OAuthClient {
  clientId     String   @id // AS-generated opaque id
  clientName   String?
  redirectUris String[] @default([])
  grantTypes   String[] @default([]) // e.g. ["authorization_code","refresh_token"]
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime @db.Timestamptz(6) // DCR registration TTL (default 90d)

  @@index([expiresAt])
  @@map("oauth_client")
}

// A single-use authorization code, issued AFTER the user consents on the console
// and exchanged at /token. Hash-only at rest (like api_key). Bound to the PKCE
// challenge + the consenting user/org so the client cannot forge identity.
model OAuthCode {
  codeHash            String    @id // HMAC-SHA256(secret, pepper) hex of the code
  clientId            String
  redirectUri         String
  userId              String
  orgId               String
  scopes              String[]  @default([])
  codeChallenge       String
  codeChallengeMethod String // always "S256"
  resource            String? // RFC 8707 audience the client requested
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime  @db.Timestamptz(6) // short (≈60s)
  consumedAt          DateTime? @db.Timestamptz(6) // set on first exchange — single-use guard

  @@index([expiresAt])
  @@map("oauth_code")
}

// A persisted authorization grant = the refresh-token state for one (user, org,
// client). Refresh tokens rotate on every use; the previous generation stays valid
// for one more use (workers-oauth-provider's fix for the lost-response deadlock).
model OAuthGrant {
  id          String    @id @default(cuid())
  userId      String
  orgId       String
  clientId    String
  scopes      String[]  @default([])
  resource    String?
  rtHash      String?   @unique // current refresh-token hash (rotating)
  prevRtHash  String? // previous generation — still redeemable once
  rtExpiresAt DateTime? @db.Timestamptz(6) // refresh inactivity expiry (default 30d, slid on use)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6) // "disconnect" — also cascade-revokes its access tokens

  @@index([userId])
  @@index([prevRtHash])
  @@map("oauth_grant")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.4 RuntimeProfile — observed runtime capabilities (C4)
// ───────────────────────────────────────────────────────────────────────────

enum AcpSupport {
  full
  partial
  none
}

model RuntimeProfile {
  id                 String     @id @default(cuid())
  daemonId           String     @db.Uuid
  runtime            String // "claude" / "codex"
  version            String
  models             String[]   @default([])
  contextWindow      Int?
  acpSupport         AcpSupport @default(none)
  acpProtocolVersion Int? // ACP protocol version negotiated at initialize
  toolCalling        Boolean    @default(false)
  mcpCapabilities    Json?      @db.JsonB // MCP transports advertised at initialize {http,sse}; null ⇒ not probed (assume stdio-only)
  modelCatalog       Json?      @db.JsonB // wire RuntimeModelCatalog verbatim (runtime-model-catalog.md §5); null ⇒ no catalog reported
  modelsSource       String? // provenance of models[]: 'cached' | 'probed'; null ⇒ older daemon (probed semantics)
  authRequired       Boolean    @default(false) // last probe hit ACP auth-required (-32000): installed but needs a login on the daemon host
  observedAt         DateTime   @default(now()) @db.Timestamptz(6)

  daemon Daemon @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@unique([daemonId, runtime])
  @@map("runtime_profile")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.5 Workspace mode — INLINE on Agent (no standalone entity).
// ───────────────────────────────────────────────────────────────────────────
// The agent's working dir is daemon-generated; the caller picks one of two modes
// (mirrors protocol AgentWorkspace; git-workspace-model.md §2). `mode` answers "is
// there a repository"; `gitCredentialProvider` answers "who vouches for it". `git`
// clones gitRepo@gitBranch and runs the agent in `agentDir` (a subdir); multiple
// agents may share a repo by differing `agentDir`, so workspace config lives
// per-agent on the Agent row below.
enum WorkspaceMode {
  scratch // fresh empty working dir, no repo
  git // clone gitRepo @ gitBranch, run in agentDir; any host
}

enum WorkspaceIsolation {
  shared // every session uses the primary checkout
  session // each logical session uses its own git worktree
}

// ───────────────────────────────────────────────────────────────────────────
// §3.6 Agent — agent definition & capability pin (C6 + C4)
// ───────────────────────────────────────────────────────────────────────────

enum AgentStatus {
  active
  inactive
  paused
}

// ───────────────────────────────────────────────────────────────────────────
// MemberSet / MemberSetMember — a named set of daemons within which an agent's
//   duty may be claimed (docs/designs/daemon-groups.md §2). The install-wide
//   pool is one ROW of it, not a kind of its own.
// ───────────────────────────────────────────────────────────────────────────

/// A named set of daemons within which an agent's duty may be claimed. `orgId` is nullable and
/// NULL MEANS CROSS-ORG, never "unassigned": an org-less set is served by org-less daemons and
/// holds every organization's agents. The install-wide pool is that row — one per install, which
/// the partial unique index `member_set_cross_org_key` (migration-only; Prisma cannot express it)
/// enforces.
model MemberSet {
  id        String   @id @db.Uuid
  orgId     String? // NULL = cross-org (the install-wide pool), never "unassigned"
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  org      Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  MemberSetMember[]
  agents   Agent[]
  sessions SessionMeta[]     @relation("SessionContentStore")

  @@index([orgId])
  @@map("member_set")
}

/// One daemon in at most one set — the daemon IS the primary key. Two write-time invariants,
/// enforced where the row is written (`member-set.repo.ts#enrollDaemonInSet`) and nowhere else:
/// an org-less set accepts only org-less daemons, an org set only that org's daemons. They are
/// what lets eligibility be a single membership lookup with no tenancy branch.
model MemberSetMember {
  setId    String   @db.Uuid
  daemonId String   @id @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(6)

  set    MemberSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  daemon Daemon    @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@map("member_set_member")
}

// Where an agent's duty may be held (docs/designs/daemon-groups.md §2). `daemon` names one
// machine through `Agent.daemonId`; `set` names a member set through `Agent.setId` — the
// install-wide pool is the org-less set. Read the pair through domain/placement.ts.
enum AgentPlacementKind {
  daemon
  set
}

model Agent {
  id                    String             @id @db.Uuid // wire UUID across route/*, agent/*, event/session
  orgId                 String
  name                  String // slug — lowercase [a-z0-9-]; unique per org; the daemon-facing handle
  displayName           String? // human-readable original ("Acme Network Bot"); the console derives the slug from it
  // Console avatar descriptor (protocol AgentIcon): {kind:'runtime'} | {kind:'glyph',glyph,color} |
  // {kind:'image',url}. Null ⇒ legacy default = the runtime mark. New agents are created with a
  // random glyph+color. Rendered by GET /v1/agents/:id/icon and used as the Slack per-message icon_url.
  icon                  Json?              @db.JsonB
  description           String? // system prompt seed → AgentLaunch.spec.description; daemon appends to standing prompt
  // Nullable = "deferred exec config" (preset-agents.md §3.2): an agent may exist
  // UNPLACED with no runtime chosen yet; the invariant moves to placement, which
  // requires one. When set it must be in Daemon.capabilities.runtimes.
  runtime               String?
  status                AgentStatus        @default(inactive)
  // Placement is a TARGET, not only a member id. `daemon` (the default, so every pre-existing row
  // keeps meaning what it meant) resolves through `daemonId`; `set` resolves through `setId`, the
  // install-wide pool being the org-less set. Only domain/placement.ts reads the triple.
  placementKind         AgentPlacementKind @default(daemon)
  daemonId              String?            @db.Uuid // the `daemon`-kind ref: 1 agent : 1 machine (null until placed)
  setId                 String?            @db.Uuid // the `set`-kind ref, null for a `daemon` placement as daemonId is for a `set` one
  // ── workspace (inline; §3.5) — daemon-generated path ──
  workspaceMode         WorkspaceMode      @default(scratch)
  workspaceIsolation    WorkspaceIsolation @default(shared)
  gitRepo               String? // git mode: FULL cloneable address, e.g. https://github.com/acme/infra
  gitBranch             String?            @default("main")
  agentDir              String? // git mode: subdir within the repo (repo-root if null)
  // Who vouches for the git workspace's repository (git-workspace-model.md §4):
  // 'github' | 'gitlab' | null. Null ⇒ anonymous clone. Kept explicit rather than
  // derived because `workspaceRepoId` is shared between GitHub's repo id and
  // GitLab's project id, so provider cannot be reconstructed from the columns.
  gitCredentialProvider String?
  // github credential (docs/designs/github-app-git-credentials.md).
  // `installationId` = GithubInstallation.id picked at create time — a PROVENANCE
  // HINT only, deliberately NO relation/FK: minting re-resolves the live
  // installation by repo owner every time, so an uninstall→reinstall (new GitHub
  // installation id) self-heals without touching agents. Null ⇒ anonymous git.
  installationId        String?
  // The host's numeric repository/project id for the workspace repo. Unlike
  // gitRepo, this survives rename and is the authority for repo-scoped effects;
  // `gitCredentialProvider` qualifies which host numbered it.
  // Nullable for pre-migration/anonymous workspaces and lazily repairable.
  workspaceRepoId       BigInt?
  gitAccess             GitAccess          @default(write) // ceiling for minted tokens; meaningful only with a credential provider
  capabilities          String[]           @default([]) // → AgentLaunch.activeCapabilities
  permissions           Json               @default("{}") @db.JsonB // {policy:"ask",autoApprove:[...]}
  runtimeOverrides      Json?              @db.JsonB // {model, reasoningEffort, outputMode, fastMode, env{K:V}, mcpServers[], skills[]} — NO secret values (those live in agent_secret)
  managedSkills         String[]           @default([]) // centrally accepted managed_skill ids, explicitly enabled
  createdByUserId       String? // WebUI user who created the agent (immutable audit; null for daemon/CLI-created). Surfaced in the console "Created" row.
  // Last-modification audit (human edits only): stamped on create + PATCH. Kept
  // separate from `updatedAt`, which also bumps on system writes (e.g. placement).
  lastModifiedByUserId  String? // WebUI user who last edited the agent (null ⇒ never edited by a human)
  lastModifiedAt        DateTime           @default(now()) @db.Timestamptz(6) // defaults to createdAt; app-bumped on each PATCH
  // ── visibility / sharing (docs/designs/resource-visibility.md) ──
  visibility            ResourceVisibility @default(org) // 'org' = all members; 'restricted' = the complete sharedWith audience
  sharedWith            String[]           @default([]) // complete app_user.id audience when visibility='restricted'
  // ── inbound agent-call policy (UI: Agent visibility) ──
  callPolicy            AgentCallPolicy    @default(all) // 'all' = any org peer agent may call this as a sub-agent
  allowedCallerAgentIds String[]           @default([]) // agent.id set used when callPolicy='selected'
  // ── outbound agent-call policy (UI: Agent visibility) ──
  outboundPolicy        AgentCallPolicy    @default(all) // 'all' = this agent may discover/call any otherwise-callable org peer
  allowedTargetAgentIds String[]           @default([]) // agent.id set used when outboundPolicy='selected'
  introduceOnJoin       Boolean            @default(false) // #536: self-introduce to peers on a genuine channel join
  runInSandbox          Boolean            @default(false) // #642: request an OS sandbox; daemon policy may force it on
  // Monotonic revision of the fully resolved AgentSpec (organization-secrets-and-
  // variables.md §5). NOT environment-specific: every durable mutation that can
  // change a CP-owned field assembled into the spec bumps it through the same
  // writer, so there is ONE ordering domain per agent rather than competing
  // revisions per feature area. The daemon refuses a snapshot older than the
  // greatest it applied, which is what makes full-map env/secret replacement safe.
  configRevision        BigInt             @default(0)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  org                   Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  daemon                Daemon?                    @relation(fields: [daemonId], references: [id], onDelete: SetNull)
  set                   MemberSet?                 @relation(fields: [setId], references: [id], onDelete: SetNull)
  createdBy             User?                      @relation("AgentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy        User?                      @relation("AgentModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  assignments           Assignment[]
  launches              AgentLaunch[]
  sessions              SessionMeta[]
  sessionUsage          SessionUsage[]
  sessionSpend          SessionSpend[]
  crons                 CronDef[]
  hooks                 HookDef[]
  integrations          Integration[]
  repoAuths             AgentRepoAuthorization[]
  secrets               AgentSecret[]
  webchatConversations  WebchatConversation[]
  webchatParticipations WebchatConversationAgent[]
  webchatMcpDelegations WebchatMcpDelegation[]
  presetRecords         PresetAgent[]

  organizationEnvironmentAssignments OrganizationEnvironmentAssignment[]

  @@unique([orgId, name]) // slug is unique within an org
  // Referenced by the composite assignment FK: a binding cannot name an agent in
  // another organization (organization-secrets-and-variables.md §5).
  @@unique([id, orgId])
  @@index([orgId])
  @@index([daemonId])
  @@index([setId])
  @@map("agent")
}

// Which preset an org-level preset_agent row describes (preset-agents.md §3).
// `general` (the `agentconnect` dev agent) is the ONLY preset: the dedicated
// assistant preset was cancelled — assistant/admin capabilities are planned to
// fold into the general agent's webapp sessions instead. Additive enum if a
// new preset ever ships.
enum PresetAgentKind {
  general
}

enum PresetAgentState {
  created // the agent row exists — written in the same transaction
  skipped // permanently not created (backfill slug collision, or org opt-out)
}

// Per-preset provisioning state (preset-agents.md §3.2). The row IS the
// idempotency marker: creation (org-creation seam or one-time backfill) writes it
// transactionally with the agent row, and a deleted preset is never recreated
// because creation has no later trigger — the row remains as the record the
// onboarding checklist derives from. `placementSettledAt` is stamped by the FIRST
// placement of any kind (or an explicit opt-out) so auto-placement (M1) never
// fights a user who unplaced or moved the agent.
model PresetAgent {
  orgId              String
  preset             PresetAgentKind
  agentId            String?          @db.Uuid // null once the agent is deleted (SetNull) or when skipped
  status             PresetAgentState
  placementSettledAt DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@id([orgId, preset])
  @@index([agentId])
  @@map("preset_agent")
}

// One write-only secret env var of an agent, row-per-key. BotSecret discipline:
// list/DTO queries never join it — key NAMES are read via AgentSecretStore.keys
// (values untouched), values ONLY via AgentSecretStore.get on the wire-projection
// paths (agent/upsert, register/ok roster, agent/activate). The store seam is the
// single read/write path, so the configured SecretCipher transforms every value;
// an encrypting provider supplies at-rest encryption while `none` is identity.
model AgentSecret {
  agentId   String   @db.Uuid
  key       String // env var name (validated at the API edge)
  value     String // passes through the SecretCipher seam (plaintext under the identity cipher)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, key])
  @@map("agent_secret")
}

/// Access level of an AgentRepoAuthorization row. Three tiers instead of
/// GitAccess's two: `comment` (contents:read + issues/PR:write) is the github
/// hook write-back shape — two tiers would force granting contents:write just
/// to let the agent comment (agent-multi-repo-authorization.md decision 3).
enum RepoAccess {
  read // contents/issues/PR all read — reference repo
  comment // contents:read, issues/PR write — watch + write-back
  write // all write — secondary working repo
}

/// Explicit grant of one code-host repository to an agent (issue #457,
/// agent-multi-repo-authorization.md; gitlab-com-integration.md §8.3). Anchored on
/// the agent, NOT on hooks — creating a hook must never silently widen
/// credentials. `repoId` (numeric, rename-immune) is the match key WITHIN a
/// provider; `repoFullName` is display + the request fast-path. The covering
/// installation is deliberately NOT bound here: minting re-resolves the live
/// installation by repo owner (gitcred decision 7), so an uninstall→reinstall
/// self-heals. Rows are mutable (add/remove) — the workspace-immutability
/// convention is untouched.
model AgentRepoAuthorization {
  id String @id @default(uuid()) @db.Uuid
  agentId String @db.Uuid
  /// 'github' | 'gitlab' — TEXT with the closed-set guard at the application layer,
  /// matching CodeHostRepository. The two hosts number their repositories
  /// independently, so identity is (provider, repoId), never repoId alone.
  provider String @default("github")
  repoId BigInt // numeric repository/project id — the match key
  repoFullName String // "owner/repo" or "group/subgroup/project" — display + case-insensitive fast-path; refreshed on rename detection
  access RepoAccess
  createdByUserId String? // audit: who authorized (the identity-assertion subject)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AgentRepoAuthCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([agentId, provider, repoId])
  @@index([agentId])
  @@map("agent_repo_authorization")
}

/// Provider-qualified repository catalog (gitlab-com-integration.md §8.1) — the
/// org-scoped identity every code-host reference converges on. `provider` is
/// TEXT, not an enum (the platform-text precedent above): a new host id must be
/// storable without a migration, with the closed-set guard at the application
/// layer. `externalId` (numeric, rename-immune) is the authority; `displayPath`
/// and `cloneUrl` are mutable hints refreshed from the provider. GitHub rows are
/// backfilled readers-first: legacy `repoId`/`repoFullName` columns stay the
/// read path until writers cut over.
model CodeHostRepository {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String
  provider      String // 'github' | 'gitlab' — app-layer closed set
  externalId    BigInt // numeric repo/project id — the match key
  displayPath   String // "owner/repo" / "group/subgroup/project" — display only
  cloneUrl      String? // canonical HTTPS clone URL
  defaultBranch String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, externalId])
  @@index([orgId])
  @@map("code_host_repository")
}

/// Deployment-GLOBAL single-owner claim over one external repository/project
/// (§8.1): within one deployment, one numeric project has at most one managing
/// organization. Acquired transactionally BEFORE any provider mutation; a
/// uniqueness loser may not begin provisioning. Deliberately org-relation-free
/// and binding-relation-free (`bindingRef` is a soft pointer): the claim must
/// survive owner deletion so `cleanup_pending` external state is never orphaned
/// silently, and release requires provider-verified cleanup, never elapsed time.
/// GitHub keeps its existing installation claim; only GitLab rows live here in v1.
model CodeHostRepositoryClaim {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  externalId BigInt
  orgId      String // owning organization — soft reference, see above
  bindingRef String?  @db.Uuid // owning provider binding (e.g. GitlabProjectBinding), soft reference
  generation BigInt   @default(1) // incremented on ownership transfer
  state      String // provisioning | active | transferring | cleanup_pending — app-layer closed set
  // Metadata-only cleanup facts (external ids, never secrets) preserved when the
  // owning binding disappears before external cleanup completed (§10.2/§19.4).
  tombstone  Json?
  // §10.2 mutual exclusion: an EXCLUSIVE run-owned provisioning lease. Acquired
  // CAS-style before any provider write; cleanup refuses while it is live; only
  // the owning run releases it, and only expiry lets another run reclaim.
  opOwner      String?
  opLeaseUntil DateTime? @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@unique([provider, externalId])
  @@index([orgId])
  @@map("code_host_repository_claim")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.7 Assignment — the routing table (session ownership + fencing) (C3)
// ───────────────────────────────────────────────────────────────────────────

// The persisted chat-platform id is TEXT, not an enum (integration-plugin-architecture.md
// §11): a new platform id must be storable without a migration once the platform registry
// lands. The closed-set guard moved to the application layer — `toDbPlatform`
// (persistence/platform.ts) still refuses ids outside the served set, fail-closed, until
// the registry replaces it. `session_meta.platform` was already text; these columns joined
// it in the S1b migration.

enum AssignmentState {
  active
  draining
  released // released = drain/done (reassignable under NEW epoch)
  frozen
}

model Assignment {
  id          String   @id @default(cuid())
  platform    String
  channel     String
  thread      String?
  threadKey   String   @default(dbgenerated("(COALESCE(thread, ''::text))")) // STORED generated col, added in migration SQL (§3.13); read-only
  agentId     String   @db.Uuid
  daemonId    String?  @db.Uuid // null while released/unplaced
  workspaceId String // opaque scope id on the wire (RouteAssign.workspaceId); now = agentId (workspace is inline)

  // ── fencing ──
  assignedEpoch BigInt          @db.BigInt // Daemon.sessionEpoch at assign time (ControlExt.epoch)
  assignedSeq   BigInt?         @db.BigInt // per-agent seq of the route/assign frame
  routingEpoch  BigInt          @db.BigInt // table version this row reflects
  state         AssignmentState @default(active)
  bindRules     Json            @default("[]") @db.JsonB // RouteAssign.bindRules[]
  releasedAt    DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  daemon Daemon? @relation(fields: [daemonId], references: [id], onDelete: SetNull)

  @@index([daemonId, state]) // register/ok reconcile: active set for a daemon
  @@index([agentId])
  @@index([platform, channel, threadKey])
  @@map("assignment")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.8 SessionMeta — converged session milestones (NO bodies) (C6 + dashboard)
// ───────────────────────────────────────────────────────────────────────────

enum SessionPhase {
  start
  plan
  problem
  end
}

enum ActivityState {
  thinking
  tool_call
  awaiting_permission
  idle
}

// Per-session visibility tier (docs/designs/session-visibility.md §1): 'org'
// (default) = visible to every organization member; 'private' = session owner
// (identity match) ONLY — no role override, org owners included; 'external' =
// current provider audience. Session reads are independent from owning-Agent
// Team visibility. Share-by-link is deliberately NOT a member of this enum (§8).
enum SessionVisibility {
  private
  org
  external
}

enum ExternalResolution {
  pending
  settled
  invalid
}

enum ExternalAccessPolicyState {
  disabled
  enabling
  enabled
  degraded
}

// How a session's visibility was determined (session-visibility.md §3, §4.5).
// The A2A reconciliation state machine: settlement flips inherited_pending →
// inherited iff the row is still pending (CAS on this column); 'explicit' pins
// the row against settlement but NOT against a tightening cascade (privacy wins).
enum VisibilitySource {
  default // classified by the §4.2 ingest rules
  inherited_pending // A2A child awaiting parent resolution (§4.5)
  inherited // settled from (or cascaded by) its parent
  explicit // set by a human via §4.3
}

model SessionMeta {
  id                  String              @id // EventSession.sessionId = ACP session id (agent-assigned string, NOT a UUID)
  parentSessionId     String? // Parent ACP session id reported by the daemon; no FK because parent metadata may arrive later or live on another daemon
  agentId             String              @db.Uuid
  launchId            String?             @db.Uuid // CP launch fence; null for Slack/Discord-created sessions (no CP launch)
  platform            String? // denormalized sessionKey echo for dashboard filters (free string so webchat can be listed)
  channel             String?
  thread              String?
  // Durable workspace/tenant scope (EventSession.transportScope — a Slack team
  // id, Feishu tenant key, or stable per-integration mint), persisted so the
  // conversation grouping key (merged-conversation-view.md §5.1) can tell
  // installations apart. NOT the daemon's credential-derived transport scope.
  tenantScope         String?
  phase               SessionPhase        @default(start)
  link                String? // deep-link (NOT a body)
  summary             String?             @db.Text // short milestone text (NOT the stream)
  title               String?             @db.Text // display title: runtime/ingress, else a capped first-message excerpt
  status              String?
  triggeredBy         String?
  channelName         String?
  triggeredByName     String?
  // Trigger-identity snapshot, frozen at creation beside triggeredBy/triggeredByName: the
  // KIND of hook this session fired from. The hook row can be deleted and recreated, and
  // without this the session would silently degrade to the generic webhook rendering.
  // Null on rows written before this column — those still resolve through the live hook.
  hookKind            HookKind?
  threadUrl           String?             @db.Text
  // ── execution-config snapshot (what the session actually ran with) ──
  // Daemon-reported via event/session (session override ?? agent config at run
  // time); null ⇒ never reported / the runtime's own default. Recorded so the
  // console shows what a session USED, not the agent's config at view time.
  runtime             String?
  model               String?
  effort              String? // reasoning effort level (runtime-owned vocabulary)
  fastMode            Boolean?
  permissionMode      String? // runtime permission/approval mode
  outputMode          String? // daemon-side output verbosity (low/medium/high)
  // First daemon that reported the session, stamped by the CP from the authenticated WS conn and
  // never daemon-echoed. Provenance, NOT the only reader: the FK nulls it when that daemon is
  // deleted, and a pool member's content outlives it in the store its peers share.
  daemonId            String?             @db.Uuid
  /// The member set whose shared data-plane store holds this session's content, stamped from the
  /// recorder's own membership beside `daemonId`. Null ⇒ the recorder's private local store, which
  /// nobody else can read. Session-bound on purpose: the agent's CURRENT placement is no evidence
  /// about where a past session ran (`domain/session-content.ts`).
  contentSetId        String?             @db.Uuid
  // Session-pinned checkout choice. Null is a legacy row whose daemon never
  // reported it; `session` identifies a daemon-local worktree eligible for the
  // authorized Workspace viewer.
  workspaceIsolation  WorkspaceIsolation?
  activityState       ActivityState       @default(idle)
  // ── session visibility (docs/designs/session-visibility.md §3) ──
  orgId               String // denormalized from agent.orgId at ingest so the org-wide list predicate/index never joins agent
  visibility          SessionVisibility   @default(org)
  ownerIdentity       String? // §2 namespaced identity (`user:<id>` | `<platform>:<scope>:<uid>`); null for automation/legacy/unresolved-owner rows (NOT a §2 owner-orphan, whose tuple is stored but unmatched)
  visibilitySource    VisibilitySource    @default(default)
  visibilityRev       Int                 @default(0) // dedicated monotonic counter, bumped in the same tx as any visibility change (§5.1)
  visibilityAckedRev  Int                 @default(-1) // daemon-ack watermark: 'applied' once >= visibilityRev; -1 = never acked (rev 0 is a real revision)
  // Shared external input. The first trusted binding is immutable; ownerIdentity
  // is provenance only and never authorizes an external row.
  externalProvider    String?
  externalScopeId     String?             @db.Uuid
  externalResolution  ExternalResolution?
  classifiedPolicyRev BigInt?             @db.BigInt
  // Provenance for the unresolved set: true when this row was ALREADY unresolved
  // when its policy was enabled. Such a scope only comes back if new trusted
  // activity rebinds the session, so it is expected rather than a fault, and
  // `state` degrades only while an unresolved row WITHOUT this mark exists (a
  // mere COUNT cannot tell the two apart: settling one marked row would silently
  // absolve a live post-enable failure). Stamped at enable and re-stamped on
  // every re-enable; A2A descendants inherit it with the audience they inherit.
  // "legacy" is relative to the org's enable, NOT to a release — this is live
  // behavior for any org that turns external access on, not pre-release cruft.
  legacyUnresolved    Boolean             @default(false)
  // Cursor tokens pass through JavaScript Date (millisecond precision), so the
  // complete keyset tuple must use the same precision in Postgres.
  // ── retention GC receipt (#485, `event/session-purged`) ──
  // When the owning daemon deleted this session's local row (and any per-session
  // worktree) after its retention window. The metadata row deliberately SURVIVES
  // — it is all that remains — so the console can say the transcript was deleted
  // instead of rendering the now-permanently-empty history as "no messages".
  // First-wins: an at-least-once re-report keeps the original stamp.
  contentPurgedAt     DateTime?           @db.Timestamptz(6)
  contentPurgedReason String? // SessionPurgeReason ('retention'); null while not purged
  lastActivityAt      DateTime            @db.Timestamptz(3)
  startedAt           DateTime            @default(now()) @db.Timestamptz(3)
  endedAt             DateTime?           @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)

  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  launch        AgentLaunch?   @relation(fields: [launchId], references: [id], onDelete: SetNull)
  daemon        Daemon?        @relation(fields: [daemonId], references: [id], onDelete: SetNull)
  contentSet    MemberSet?     @relation("SessionContentStore", fields: [contentSetId], references: [id], onDelete: SetNull)
  externalScope ExternalScope? @relation(fields: [externalScopeId, orgId, externalProvider], references: [id, orgId, provider], onDelete: Restrict, onUpdate: Restrict)

  webchatCurrentFor      WebchatConversation[]      @relation("WebchatCurrentSession")
  webchatAgentCurrentFor WebchatConversationAgent[] @relation("WebchatAgentCurrentSession")
  webchatTargetedBy      WebchatConversation[]      @relation("WebchatTargetSession")
  pullRequest            SessionPullRequest?
  pullRequestCapture     SessionPullRequestCapture?

  @@index([agentId, startedAt])
  @@index([lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc), agentId], map: "session_meta_activity_page_idx")
  @@index([agentId, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_activity_page_idx")
  @@index([agentId, platform, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_platform_page_idx")
  @@index([agentId, channel, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_channel_page_idx")
  @@index([agentId, triggeredBy, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_agent_trigger_page_idx")
  @@index([orgId, visibility, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_org_visibility_page_idx")
  @@index([parentSessionId])
  // Conversation grouping (merged-conversation-view.md §5.2): serves the
  // emit-at-max exists-newer probe, the member backfill, and the
  // conversationKey resolver. Replaces the unused bare (platform, channel).
  @@index([orgId, platform, tenantScope, channel, thread, lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "session_meta_conversation_key_idx")
  @@index([launchId])
  @@index([daemonId])
  @@index([orgId, externalProvider, externalScopeId])
  @@map("session_meta")
}

// Durable PR ownership plus an optional level-triggered wake; no feedback bodies or CI logs.
model SessionPullRequest {
  orgId          String
  repoId         BigInt    @db.BigInt
  pullNumber     Int
  installationId BigInt    @db.BigInt
  repoFullName   String
  sessionId      String?   @unique(map: "session_pull_request_session_key")
  deliveryKey    String?
  nextAttemptAt  DateTime? @db.Timestamptz(6)
  claimOwner     String?   @db.Uuid
  claimUntil     DateTime? @db.Timestamptz(6)
  signalAt       DateTime? @db.Timestamptz(6)

  session SessionMeta? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([orgId, repoId, pullNumber], map: "session_pull_request_pkey")
  @@index([nextAttemptAt, claimUntil], map: "session_pull_request_pending_idx")
  @@map("session_pull_request")
}

// One durable, exact-session obligation to discover the PR created from its isolated worktree.
model SessionPullRequestCapture {
  sessionId     String    @id
  nextAttemptAt DateTime  @db.Timestamptz(6)
  claimOwner    String?   @db.Uuid
  claimUntil    DateTime? @db.Timestamptz(6)

  session SessionMeta @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt, claimUntil], map: "session_pull_request_capture_pending_idx")
  @@map("session_pull_request_capture")
}

// Stable provider resource referenced by SessionMeta. Provider ACLs themselves
// are never copied here; access is resolved at read time and only short-lived
// decisions are cached in process memory.
model ExternalScope {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String
  provider       String
  realmKey       String
  resourceKind   String
  resourceKey    String
  credentialKind String?
  credentialId   String?
  aclRevision    BigInt    @default(0) @db.BigInt
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions SessionMeta[]

  @@unique([id, orgId, provider])
  @@unique([orgId, provider, realmKey, resourceKind, resourceKey])
  @@index([credentialKind, credentialId])
  @@map("external_scope")
}

// Organization/provider policy. Missing is never interpreted as disabled: the
// ingest transaction ensures this row before creating a supported candidate.
model SessionExternalAccessPolicy {
  orgId           String
  provider        String
  state           ExternalAccessPolicyState @default(disabled)
  currentRev      BigInt                    @default(0) @db.BigInt
  readFenceRev    BigInt?                   @db.BigInt
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, provider])
  @@map("session_external_access_policy")
}

// Durable ownership metadata for a browser webchat conversation. The message
// stream and transcript remain daemon-local; this row only lets the CP prove
// that a requested resume belongs to the authenticated human, agent, and org.
model WebchatConversation {
  id                   String   @id @db.Uuid
  orgId                String
  agentId              String   @db.Uuid
  userId               String
  delegationGeneration Int      @default(0)
  // The exact ACP session currently installed for this conversation — the
  // current-session fence for remote MCP authorization. Maintained ONLY by the
  // session-milestone upsert, transactionally, under a lock on this row, so a
  // replacement-session insert serializes with every authorization read that
  // locks the conversation. `endedAt` cannot express this ("end" is stamped
  // after every turn); identity must be explicit. SetNull fails closed if the
  // session row disappears.
  currentSessionId     String?
  currentSessionRev    Int      @default(0) // bumped in the same tx as any pointer change
  // Session-targeted continuation (webchat-cross-integration-continuation.md §6.2):
  // non-null ⇒ this conversation adopts an existing integration-origin session
  // (immutable after creation); null ⇒ ordinary webchat conversation. Cascade:
  // a targeted conversation without its target has no purpose — metadata
  // deletion removes the row; retention purge keeps it and every continuation
  // gate rejects on the session's contentPurgedAt.
  targetSessionId      String?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  org            Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent          Agent                      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSession SessionMeta?               @relation("WebchatCurrentSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  targetSession  SessionMeta?               @relation("WebchatTargetSession", fields: [targetSessionId], references: [id], onDelete: Cascade)
  delegations    WebchatMcpDelegation[]
  mcpOperations  WebchatMcpOperation[]
  participants   WebchatConversationAgent[]

  // Concurrent mints for one user/session converge on one browser conversation
  // (Postgres permits all-null targets, so standard rows are unconstrained).
  @@unique([userId, targetSessionId])
  @@index([orgId])
  @@index([agentId])
  @@index([userId])
  @@index([currentSessionId])
  @@map("webchat_conversation")
}

// One participant agent of a webchat conversation (webchat-multi-agents.md §3.1).
// The roster is fixed at creation; `WebchatConversation.agentId` always mirrors
// the `role='primary'` row. `ord` preserves the pick order (primary is ord 0).
// Each participant carries its OWN current-session pointer, maintained by the
// session-milestone upsert exactly like the conversation-level fence.
model WebchatConversationAgent {
  conversationId    String   @db.Uuid
  agentId           String   @db.Uuid
  role              String   @default("member") // 'primary' | 'member'
  ord               Int      @default(0)
  addedByUserId     String
  addedAt           DateTime @default(now()) @db.Timestamptz(6)
  currentSessionId  String?
  currentSessionRev Int      @default(0)

  conversation   WebchatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent          Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  currentSession SessionMeta?        @relation("WebchatAgentCurrentSession", fields: [currentSessionId], references: [id], onDelete: SetNull)

  @@id([conversationId, agentId])
  @@index([agentId])
  @@index([currentSessionId])
  @@map("webchat_conversation_agent")
}

// Durable, generation-fenced authority for one browser conversation to invoke
// curated AgentConnect MCP tools through whichever daemon serves the agent when it redeems one.
model WebchatMcpDelegation {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  generation     Int
  userId         String
  orgId          String
  agentId        String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  revokedReason  String?

  conversation WebchatConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  org          Org                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  grants       WebchatMcpAccessGrant[]

  @@unique([conversationId, generation])
  @@index([conversationId, revokedAt])
  @@index([agentId, revokedAt])
  @@index([expiresAt])
  @@map("webchat_mcp_delegation")
}

enum WebchatMcpOperationStatus {
  awaiting_confirmation
  executing
  completed
  failed
  ambiguous
  stale
}

enum WebchatMcpGrantStatus {
  pending
  active
  revoked
  expired
}

// Short-lived bearer credential for one exact runtime descriptor. Only the
// peppered token hash is durable; plaintext exists only in the issuance reply.
model WebchatMcpAccessGrant {
  id                   String                @id @default(uuid()) @db.Uuid
  authorityId          String                @db.Uuid
  descriptorInstanceId String                @db.Uuid
  grantRevision        Int
  tokenHash            String                @unique
  status               WebchatMcpGrantStatus @default(pending)
  pendingExpiresAt     DateTime              @db.Timestamptz(6)
  expiresAt            DateTime              @db.Timestamptz(6)
  activatedAt          DateTime?             @db.Timestamptz(6)
  revokedAt            DateTime?             @db.Timestamptz(6)
  revokedReason        String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)

  authority  WebchatMcpDelegation         @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  operations WebchatMcpOperation[]
  receipts   WebchatMcpTransportReceipt[]

  @@unique([descriptorInstanceId, grantRevision])
  @@index([authorityId, status])
  @@index([descriptorInstanceId, status])
  @@index([status, pendingExpiresAt])
  @@index([status, expiresAt])
  @@map("webchat_mcp_access_grant")
}

// Browser-confirmed logical write. Identity and terminal status live for the
// conversation lifetime; the bounded response may be evicted independently.
model WebchatMcpOperation {
  id                         String                    @id @default(uuid()) @db.Uuid
  conversationId             String                    @db.Uuid
  createdAuthorityGeneration Int
  sourceGrantId              String                    @db.Uuid
  userId                     String
  toolName                   String
  canonicalArguments         Json                      @db.JsonB
  intentHash                 String
  status                     WebchatMcpOperationStatus @default(awaiting_confirmation)
  executionAttemptId         String?                   @db.Uuid
  claimedAt                  DateTime?                 @db.Timestamptz(6)
  recoveryDeadline           DateTime?                 @db.Timestamptz(6)
  boundedResponse            Bytes?
  createdAt                  DateTime                  @default(now()) @db.Timestamptz(6)
  confirmationExpiresAt      DateTime                  @db.Timestamptz(6)
  completedAt                DateTime?                 @db.Timestamptz(6)

  conversation WebchatConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceGrant  WebchatMcpAccessGrant        @relation(fields: [sourceGrantId], references: [id], onDelete: Restrict)
  receipts     WebchatMcpTransportReceipt[]

  @@index([conversationId, status, createdAt])
  @@index([status, recoveryDeadline, id])
  @@map("webchat_mcp_operation")
}

// Standard JSON-RPC retry coordinate. It never authorizes or claims execution.
model WebchatMcpTransportReceipt {
  grantId          String    @db.Uuid
  jsonRpcRequestId String
  conversationId   String    @db.Uuid
  requestHash      String
  operationId      String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  supersededAt     DateTime? @db.Timestamptz(6)

  grant     WebchatMcpAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  operation WebchatMcpOperation   @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@id([grantId, jsonRpcRequestId])
  @@index([operationId])
  @@index([grantId, createdAt])
  @@map("webchat_mcp_transport_receipt")
}

// ───────────────────────────────────────────────────────────────────────────
// SessionUsage — per-session token accounting for the console's usage dashboard.
//
// Unlike the message stream (daemon-local, never on the CP), token counts + cost
// ARE dashboard telemetry: an upstream reports each session's CUMULATIVE usage and
// the CP upserts one row per (agentId, sessionId). This is the ONLY historical
// usage store — the `/usage` aggregates sum over it by time window. `sessionId` is
// the agent-assigned ACP id (a string, NOT a wire UUID), so the PK is composite
// with agentId. Latest-wins upsert = idempotent.
// ───────────────────────────────────────────────────────────────────────────
model SessionUsage {
  agentId           String      @db.Uuid
  sessionId         String // ACP session id (agent-assigned; NOT a wire UUID)
  platform          String? // denormalized sessionKey echo (free string, not the Platform enum)
  channel           String?
  source            UsageSource @default(daemon)
  totalTokens       Int         @default(0)
  inputTokens       Int         @default(0)
  outputTokens      Int         @default(0)
  thoughtTokens     Int         @default(0)
  cachedReadTokens  Int         @default(0)
  cachedWriteTokens Int         @default(0)
  contextUsed       Int?
  contextSize       Int?
  // Exact money: an amount is metered by one party and billed by another, so it is
  // NUMERIC end to end and never a binary float. Reports carry it as a decimal string.
  costAmount        Decimal     @default(0) @db.Decimal(38, 18)
  costCurrency      String?
  startedAt         DateTime    @default(now()) @db.Timestamptz(6)
  lastActivityAt    DateTime    @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, sessionId])
  @@index([agentId, lastActivityAt])
  @@map("session_usage")
}

// Which authenticated ingress metered a session. Stamped from the adapter that
// accepted the report, NEVER self-reported by the payload: the daemon `usage/report`
// EVT is always `daemon`, the service-authenticated batch endpoint always `gateway`.
// A session stays on one source for life; pre-gateway rows read `daemon`.
enum UsageSource {
  daemon
  gateway
}

// SessionSpend — cumulative usage timeline backing range-scoped spend and the
// durable per-model breakdown.
//
// session_usage is a latest-wins lifetime snapshot, so it can't answer "how much
// was spent inside this window": a long-lived session collapses its entire cost
// into its newest report. This table records the session's CUMULATIVE cost at each
// report time together with the model observed for that interval. Readers derive
// token/cost deltas by diffing consecutive cumulatives and attribute each delta to
// this row's model. Storing cumulatives keeps writes idempotent on
// (agentId, sessionId, at); null model is an observed or legacy unknown.
model SessionSpend {
  agentId                     String      @db.Uuid
  sessionId                   String // ACP session id (echo of the snapshot row)
  at                          DateTime    @db.Timestamptz(6) // the report's lastActivityAt — the bucket time
  model                       String?
  source                      UsageSource @default(daemon) // echo of the snapshot row's ingress, so a range query can filter by it
  cumulativeTotalTokens       Int         @default(0)
  cumulativeInputTokens       Int         @default(0)
  cumulativeOutputTokens      Int         @default(0)
  cumulativeThoughtTokens     Int         @default(0)
  cumulativeCachedReadTokens  Int         @default(0)
  cumulativeCachedWriteTokens Int         @default(0)
  // Session's cumulative cost as of `at`; window spend = diff of consecutive cumulatives.
  // NUMERIC like the snapshot: the diffs feed billing, so no step may round.
  cumulativeCost              Decimal     @db.Decimal(38, 18)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, sessionId, at])
  @@index([agentId, at])
  @@map("session_spend")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.9 AgentLaunch — launch fencing (C3)
// ───────────────────────────────────────────────────────────────────────────

enum LaunchMode {
  long_lived
  per_turn
}

enum LaunchStatus {
  launching
  running
  stopped
  crashed
}

model AgentLaunch {
  id                 String       @id @db.Uuid // AgentLaunched.launchId (the fence value)
  agentId            String       @db.Uuid
  daemonId           String       @db.Uuid
  runtime            String
  mode               LaunchMode   @default(long_lived)
  acpSessionId       String? // set iff long-lived ACP session
  // Web API launch provenance (session-visibility.md §4.4) — DISTINCT from the
  // fencing `id`: the CP mints it, the daemon echoes it on the session's
  // `event/session` frame, and ingest resolves it back to the launching user.
  correlationId      String?      @unique @db.Uuid
  createdByUserId    String? // launching principal; raw scalar (no FK) so a deleted user never breaks provenance
  activeCapabilities String[]     @default([]) // capability pin (AgentCapabilities.active)
  status             LaunchStatus @default(launching)
  launchEpoch        BigInt       @db.BigInt // sessionEpoch the launch was issued under
  startedAt          DateTime?    @db.Timestamptz(6)
  stoppedAt          DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  agent    Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  daemon   Daemon        @relation(fields: [daemonId], references: [id], onDelete: Cascade)
  sessions SessionMeta[]

  @@index([agentId, status])
  @@index([daemonId])
  @@map("agent_launch")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.10 SecretLease — lease metadata (NO plaintext) (C5)
// ───────────────────────────────────────────────────────────────────────────

enum LeaseStatus {
  active
  expired
  revoked
}

model SecretLease {
  id               String      @id @db.Uuid // SecretsGrant.leaseId
  daemonId         String      @db.Uuid
  scopePlatform    String
  scopeWorkspaceId String      @db.Uuid // SecretsGrant.scope.workspaceId — opaque scope id; now = agentId (workspace inline)
  ref              String // Vault/KMS path/handle — NOT the secret
  ttlSec           Int
  renewBeforeSec   Int         @default(60)
  status           LeaseStatus @default(active)
  issuedAt         DateTime    @default(now()) @db.Timestamptz(6)
  renewedAt        DateTime?   @db.Timestamptz(6)
  expiresAt        DateTime    @db.Timestamptz(6) // issuedAt+ttl; advanced on renew
  revokedReason    String?

  daemon Daemon @relation(fields: [daemonId], references: [id], onDelete: Cascade)

  @@index([daemonId, status])
  @@index([status, expiresAt])
  @@map("secret_lease")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.11 CronDef — cron definitions (C6 + C3)
// ───────────────────────────────────────────────────────────────────────────

model CronDef {
  id                   String             @id @db.Uuid // CronUpsert.cronId
  orgId                String
  agentId              String?            @db.Uuid // required at the API; null only via agent-delete SetNull (inert until re-assigned)
  name                 String? // console display name ("weekly-deploy-report"); pure console metadata, never on the daemon wire. Null for legacy/CLI rows.
  schedule             String // croner expression interpreted in timezone
  timezone             String // IANA timezone resolved by the CP before persistence
  targetPlatform       String             @default("slack")
  targetChannel        String? // CronUpsert.target.channel; null ⇒ headless fire (no platform output)
  targetIntegrationId  String?            @db.Uuid // CronUpsert.target.integrationId — the agent integration posting the anchor; null (legacy / uninstalled) ⇒ daemon falls back to the agent's first integration
  trigger              String             @db.Text // synthetic trigger text (control metadata)
  enabled              Boolean            @default(true)
  lastRunAt            DateTime?          @db.Timestamptz(6) // advisory (cron/report EVT, latest-wins); daemon authoritative
  createdByUserId      String? // WebUI user who created the cron (immutable audit; stamped on create only)
  // Last-modification audit (human edits only): stamped on create AND on every
  // edit through the PUT upsert. Separate from `updatedAt`, which also bumps on
  // system writes (e.g. `lastRunAt` advanced by a daemon cron/report).
  lastModifiedByUserId String? // WebUI user who last edited the cron (null ⇒ never edited by a human)
  lastModifiedAt       DateTime           @default(now()) @db.Timestamptz(6) // defaults to createdAt; app-bumped on each upsert-edit
  // ── visibility / sharing (docs/designs/resource-visibility.md) ──
  visibility           ResourceVisibility @default(org) // 'org' = all members; 'restricted' = the complete sharedWith audience
  sharedWith           String[]           @default([]) // complete app_user.id audience when visibility='restricted'
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  org               Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent             Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  targetIntegration Integration? @relation(fields: [targetIntegrationId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation("CronCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy    User?        @relation("CronModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  runs              CronRun[]

  @@index([orgId])
  @@index([agentId])
  @@index([targetIntegrationId])
  @@map("cron_def")
}

// One fire of a schedule (`cron/report` EVT pairs keyed on (cronId, startedAt)):
// the FIRE report opens the row (`running`), the COMPLETION report closes it
// with outcome + duration + the ACP session to deep-link. `running` rows whose
// completion report was lost (daemon crashed / CP down at turn end) are
// reconciled to `failed` (orphaned) by the CronRunReaper once they age past
// CRON_RUN_TTL_SEC — a late completion still overwrites that with the real
// outcome (the upsert is last-writer-wins), the daemon remaining authoritative.
enum CronRunStatus {
  running
  success
  failed
}

model CronRun {
  id         String        @id @default(cuid())
  cronId     String        @db.Uuid
  orgId      String
  startedAt  DateTime      @db.Timestamptz(6) // CronReport.firedAt
  status     CronRunStatus @default(running)
  durationMs Int?
  sessionId  String? // ACP session id (console deep-link); null while running / on legacy reports
  reason     String? // short failure text (status "failed")
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)

  cron CronDef @relation(fields: [cronId], references: [id], onDelete: Cascade)

  @@unique([cronId, startedAt])
  @@index([cronId, startedAt(sort: Desc)])
  @@map("cron_run")
}

// ───────────────────────────────────────────────────────────────────────────
// HookDef — inbound-webhook triggers (webhook-triggers-and-github-events.md)
//   A hook maps an inbound webhook delivery to ONE agent turn. The CP owns the
//   definition and compiles it into relay-side rules (rc/hook-assign, broadcast
//   to the whole pool); the relay is the public ingress — event payloads never
//   touch the CP, these rows are definitions + run metadata only.
// ───────────────────────────────────────────────────────────────────────────

enum HookKind {
  webhook // generic inbound webhook (POST /webhooks/in/:token on the relay)
  github // GitHub event subscription (P2)
  gitlab // GitLab.com event subscription (gitlab-com-integration.md §8.3)
}

enum HookSessionMode {
  perDelivery // new ACP session per delivery (webhook-kind default)
  perThread // source-thread affinity: github = repo#number (github-kind default & only)
  shared // the whole hook shares one session (webhook-kind opt-in)
}

enum HookReviewPolicy {
  off
  comment
  request_changes
  full
}

enum HookReportingMode {
  off
  check
  status
}

enum HookGateMode {
  informational
  required
}

model HookDef {
  id                                 String            @id @default(uuid()) @db.Uuid
  orgId                              String
  agentId                            String?           @db.Uuid // required at the API; nullable only for legacy inert rows
  kind                               HookKind
  name                               String
  enabled                            Boolean           @default(true)
  // No trigger prompt: the agent's description is its standing context and the
  // delivery payload carries the caller's message (design security boundary 1).
  sessionMode                        HookSessionMode
  // ── kind=webhook ──
  urlToken                           String?           @unique // ≥128-bit random ingress routing key (capability URL; canEdit-visible)
  // hmacSecret lives in HookSecret — never on this row (accidental-serialization guard)
  // ── kind=github (P2) ──
  repoId                             BigInt? // GitHub numeric repo id — the match key (rename-proof)
  repoFullName                       String? // "owner/repo" — display + create-time validation; never matched on
  githubSessionKey                   String? // immutable per-thread namespace; existing rows keep their pre-rename owner/repo
  family                             String? // subject family of this row; a github/gitlab hook row covers exactly one family (webhook kind: null)
  events                             String[]          @default([]) // "issues:opened" / "pull_request:*" / "issue_comment:created"
  commentFamilies                    String[]          @default([]) // empty = legacy repo-wide comments; otherwise issues/pull_request scope
  labelFilter                        String[]          @default([]) // non-empty ⇒ issue/PR must carry one of these labels
  mentionOnly                        Boolean           @default(false) // P3 summon mode: authored event text must @<agent-name> or @<app-slug>
  // Durable configuration/dispatch fences.  configRevision changes whenever
  // the compiled definition changes; dispatchRevision additionally changes
  // when the owning agent is re-placed.
  configRevision                     BigInt            @default(1)
  dispatchRevision                   BigInt            @default(1)
  // Changes only when the review projection binding/lifecycle changes
  // (enablement, agent/repo binding, reporting transport, or gate mode). It is
  // part of the projection natural key, so a one-way tombstone from an older
  // lifecycle can never suppress a later explicit re-enable on the same SHA.
  projectionEpoch                    BigInt            @default(1)
  reviewPolicy                       HookReviewPolicy  @default(off)
  reportingMode                      HookReportingMode @default(off)
  gateMode                           HookGateMode      @default(informational)
  requiredAcknowledgedAt             DateTime?         @db.Timestamptz(6)
  requiredAcknowledgedByUserId       String?
  requiredAcknowledgedConfigRevision BigInt?
  // ── output anchoring (same trio as CronDef.target*; null channel ⇒ headless) ──
  targetPlatform                     String            @default("slack")
  targetChannel                      String?
  targetIntegrationId                String?           @db.Uuid
  lastFiredAt                        DateTime?         @db.Timestamptz(6) // advisory; bumped on rc/run-report
  // A hook is subordinate to ONE agent (like an Integration, unlike a CronDef):
  // it is only ever listed under that agent, so it carries NO visibility of its
  // own — access is gated by the owning agent's visibility. createdBy is audit.
  createdByUserId                    String?
  lastModifiedByUserId               String?
  lastModifiedAt                     DateTime          @default(now()) @db.Timestamptz(6)
  createdAt                          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime          @updatedAt @db.Timestamptz(6)

  org               Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent             Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  targetIntegration Integration? @relation(fields: [targetIntegrationId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation("HookCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedBy    User?        @relation("HookModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  secret            HookSecret?

  // One subscription row per (agent, repo, subject family) — the database owns
  // the rule, so the routes need no duplicate probe. Postgres skips rows with a
  // NULL member, so webhook-kind and legacy inert rows never conflict.
  @@unique([agentId, kind, repoId, family], map: "hook_def_agent_repo_family_key")
  @@index([orgId])
  @@index([agentId])
  @@index([kind, repoId]) // github rule-compile main query (P2)
  @@map("hook_def")
}

// Per-hook HMAC signing key, 1:1 with HookDef. BotSecret discipline: list/DTO
// queries never join it, it is read only through the HookSecretStore, and it is
// echoed exactly once in the create response. The stored value passes through
// SecretCipher: plaintext under `none`, ciphertext under an encrypting provider.
model HookSecret {
  hookId     String @id @db.Uuid
  hmacSecret String // stored SecretCipher representation; read ONLY via HookSecretStore

  hook HookDef @relation(fields: [hookId], references: [id], onDelete: Cascade)

  @@map("hook_secret")
}

// One webhook delivery that fired (or failed to fire) an agent turn. Two-stage
// lifecycle: the relay's rc/run-report opens the row (`running` on accepted, or
// `failed` outright on a delivery failure), the daemon's hook/report completion
// EVT closes it. `running` rows whose completion was lost are reconciled to
// `failed` (orphaned) by the HookRunReaper; a late completion still overwrites
// (last-writer-wins). (hookId, deliveryKey) is the idempotency key absorbing
// GitHub redeliveries and reconcile re-posts.
model HookRun {
  id                        String             @id @default(cuid())
  hookId                    String             @db.Uuid
  orgId                     String
  deliveryKey               String // X-GitHub-Delivery GUID / X-AC-Delivery-Key / relay-minted uuid
  event                     String? // github: "issues:opened"; webhook kind: null (metadata, never a body)
  startedAt                 DateTime           @db.Timestamptz(6) // RcRunReport.firedAt (relay ingest time)
  // Exact accepted dispatch snapshot.  Nullable only for legacy rows whose
  // relay/daemon predates the R1 protocol additions.
  agentId                   String?            @db.Uuid
  configRevision            BigInt?
  dispatchRevision          BigInt?
  projectionEpoch           BigInt?
  dispatchDaemonId          String?            @db.Uuid
  reviewPolicySnapshot      HookReviewPolicy?
  reportingModeSnapshot     HookReportingMode?
  gateModeSnapshot          HookGateMode?
  projectionIntent          String?
  repoId                    BigInt?
  repoFullName              String?
  sourceInstallationId      BigInt?
  subjectKind               String?
  pullNumber                Int?
  headSha                   String?
  baseSha                   String?
  reportSha                 String?
  isDraft                   Boolean?
  baseChanged               Boolean?
  turnStartedAt             DateTime?          @db.Timestamptz(6)
  completedAt               DateTime?          @db.Timestamptz(6)
  orphanedAt                DateTime?          @db.Timestamptz(6)
  projectionId              String?            @db.Uuid
  projectionGeneration      BigInt?
  reviewAttemptId           String?            @unique @db.Uuid
  reviewAttemptState        String?
  reviewErrorCode           String?
  reviewId                  String?
  reviewEvent               String?
  verdict                   String?
  reviewCommitId            String?
  publishedCommentKind      String?
  publishedCommentId        String?
  status                    CronRunStatus      @default(running)
  durationMs                Int?
  sessionId                 String? // ACP session id (console deep-link); null while running
  reason                    String? // short failure text: daemon_offline / dispatch_timeout / orphaned / turn failure
  // Durable, metadata-only GitHub redelivery schedule. These fields are used
  // only for delivery-stage failures that are explicitly classified as safe
  // to retry; no webhook payload is stored in the control plane.
  redeliveryAttempts        Int                @default(0)
  redeliveryLastRequestedAt DateTime?          @db.Timestamptz(6)
  redeliveryNextAttemptAt   DateTime?          @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([hookId, deliveryKey])
  @@index([orgId])
  @@index([hookId, startedAt(sort: Desc)])
  @@index([hookId, repoId, reportSha, startedAt(sort: Desc)])
  @@index([projectionId, projectionGeneration])
  @@index([status, startedAt])
  @@index([deliveryKey, status, redeliveryNextAttemptAt])
  @@index([status, redeliveryNextAttemptAt, redeliveryAttempts], map: "hook_run_redelivery_due_idx")
  // The console PR panel's session -> owning run lookup. Declared unfiltered here because Prisma
  // cannot express the partial predicate; the migration creates it WHERE sessionId IS NOT NULL.
  @@index([orgId, sessionId], map: "hook_run_org_session_idx")
  @@map("hook_run")
}

// Durable GitHub Checks/status projection.  It deliberately has no FK to
// HookDef/Agent/Org: cleanup must still run after an owner row is deleted.
model HookReviewProjection {
  id                         String  @id @default(uuid()) @db.Uuid
  hookId                     String  @db.Uuid
  orgId                      String
  agentId                    String  @db.Uuid
  // Stable, single-line agent slug displayed in the external Check summary.
  // Snapshotted because this projection must survive Agent deletion for cleanup.
  agentName                  String?
  lastResolvedInstallationId BigInt?
  repoId                     BigInt
  repoFullName               String
  headSha                    String
  reportSha                  String
  projectionEpoch            BigInt

  generation       BigInt  @default(0)
  currentHookRunId String?
  externalId       String  @unique
  checkRunId       String? @unique

  mode          HookReportingMode
  gateMode      HookGateMode
  desiredState  String
  observedState String?
  sealedThrough BigInt            @default(0)

  // Live commit -> current PR association is evaluated once per generation
  // before a terminal informational Check write. The canonical desired state
  // remains untouched when association fails closed.
  subjectSyncGeneration BigInt  @default(0)
  subjectSyncErrorCode  String?

  leaseOwner     String?
  leaseUntil     DateTime? @db.Timestamptz(6)
  nextAttemptAt  DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastErrorCode  String?
  pendingIntent  Json?     @db.JsonB
  writeMarker    String?   @unique
  writePhase     String?
  writeStartedAt DateTime? @db.Timestamptz(6)
  tombstonedAt   DateTime? @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  subjects HookReviewSubject[]

  @@unique([hookId, repoId, reportSha, projectionEpoch])
  @@index([orgId])
  @@index([nextAttemptAt, leaseUntil])
  @@index([agentId, repoId])
  @@index([lastResolvedInstallationId])
  @@map("hook_review_projection")
}

// ───────────────────────────────────────────────────────────────────────────
// Provider-neutral formal reviews (gitlab-com-integration.md §15.1, §15.2).
//   Every agent on a project publishes through ONE service account, and the
//   provider's bulk-publish endpoint carries no attempt identifier — so the
//   publication lease below is a correctness boundary, not an optimization.
//   Review bodies and inline comments never reach these tables.
// ───────────────────────────────────────────────────────────────────────────

/// The durable publication lease for one `(provider, project, merge-request IID,
/// service-account user)` subject. Acquisition is compare-and-swap, increments
/// `fence`, and admits exactly one owner across agents and daemons. The subject
/// key deliberately omits `orgId`: the boundary is the provider-side merge
/// request, and the global project claim already gives it one owning org.
model CodeHostReviewLease {
  id                       String    @id @default(uuid()) @db.Uuid
  orgId                    String
  provider                 String    // 'gitlab' today — app-layer closed set (protocol code-host.ts)
  projectExternalId        BigInt
  mergeRequestIid          Int
  serviceAccountExternalId BigInt
  // Monotonic and never reused; bumped on every acquisition so a stale broker
  // cannot obtain another operation record. Never a provider-side fence (§15.1).
  fence                    BigInt    @default(0)
  // The current owner; null only while the lease is settled.
  attemptId                String?   @unique @db.Uuid
  ownerDaemonId            String?   @db.Uuid
  agentId                  String?   @db.Uuid
  hookId                   String?   @db.Uuid
  deliveryKey              String?
  event                    String?
  verdict                  String?
  headSha                  String?
  // open / publishing / classifying / settled / ambiguous_locked — app-layer closed set.
  // `ambiguous_locked` retains its attempt indefinitely: no timeout, no force unlock.
  phase                    String    @default("settled")
  // Advisory only. An expired lease permits a TRANSFER decision, never a takeover:
  // once a record was issued, transfer needs one of the four §15.1 conditions.
  leaseUntil               DateTime? @db.Timestamptz(6)
  // Short normalized lock category for operator diagnosis. Never provider text.
  lockedReason             String?
  lockedAt                 DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  org        Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  operations CodeHostReviewOperation[]

  @@unique([provider, projectExternalId, mergeRequestIid, serviceAccountExternalId], map: "code_host_review_lease_subject_key")
  @@index([orgId])
  @@index([phase, leaseUntil])
  @@map("code_host_review_lease")
}

/// One single-use provider-mutation permit. Bound to attempt, fence, kind,
/// method, target, and ordinal; `issued` -> `request_started` (atomically, before
/// the outbound request) -> `settled` or `ambiguous`, or `unused` when the same
/// live broker durably returns it before any request starts. `startToken` is the
/// broker's id for the ONE intended request, so a lost reply is retransmittable
/// while a second, different start is refused.
model CodeHostReviewOperation {
  id                 String    @id @default(uuid()) @db.Uuid
  leaseId            String    @db.Uuid
  orgId              String
  attemptId          String    @db.Uuid
  fence              BigInt
  ordinal            Int
  kind               String    // draft_create / draft_delete / bulk_publish / approval
  method             String    // POST / PUT / PATCH / DELETE
  target             String    // bounded request path — body-free by construction
  state              String    @default("issued") // issued / request_started / settled / ambiguous / unused
  startToken         String?   @db.Uuid
  responseStatus     Int?
  responseExternalId String?
  resultCode         String?   // short normalized code; provider error text never lands here
  issuedAt           DateTime  @default(now()) @db.Timestamptz(6)
  startedAt          DateTime? @db.Timestamptz(6)
  // Set the first time this record was classified ambiguous and retained after a
  // later positive identification — that history is §15.1's fourth transfer condition.
  ambiguousAt        DateTime? @db.Timestamptz(6)
  settledAt          DateTime? @db.Timestamptz(6)

  lease CodeHostReviewLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([attemptId, fence, kind, ordinal], map: "code_host_review_operation_permit_key")
  @@index([leaseId, state])
  @@index([orgId])
  @@map("code_host_review_operation")
}

/// The body-free outcome of one formal review attempt (§15.2). The control plane
/// stores the attempt id, external ids, event, verdict, head SHA, and normalized
/// state — never a review body, an inline comment, or provider prose.
/// `externalIds` entries are `"<kind>:<numeric id>"`, validated on write, so the
/// column cannot hold text.
model CodeHostReviewAttemptOutcome {
  attemptId         String   @id @db.Uuid
  orgId             String
  hookId            String   @db.Uuid
  deliveryKey       String
  provider          String
  projectExternalId BigInt
  mergeRequestIid   Int
  event             String
  verdict           String
  headSha           String
  state             String
  externalIds       String[] @default([])
  recordedAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([hookId, deliveryKey])
  @@map("code_host_review_attempt_outcome")
}

model HookReviewSubject {
  projectionId String   @db.Uuid
  pullNumber   Int
  headSha      String
  baseSha      String?
  isOpen       Boolean  @default(true)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  projection HookReviewProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  @@id([projectionId, pullNumber])
  @@index([headSha])
  @@map("hook_review_subject")
}

// Provider-neutral informational run projection (gitlab-com-integration.md §16).
// ONE note per (hook, project, merge-request IID, head SHA, projection epoch).
// The Control Plane records the desired generation; the OWNING DAEMON is the
// only provider writer, so `leaseOwner` is the daemon that holds the write and
// an offline or non-advertising daemon simply leaves the row pending. Same
// no-FK discipline as hook_review_projection: cleanup outlives its owner rows.
model CodeHostRunProjection {
  id              String  @id @default(uuid()) @db.Uuid
  provider        String
  hookId          String  @db.Uuid
  orgId           String
  agentId         String  @db.Uuid
  // Snapshotted so a projection survives Agent deletion for cleanup.
  agentName       String?
  projectId       BigInt
  projectPath     String
  mergeRequestIid Int
  headSha         String
  projectionEpoch BigInt

  generation         BigInt  @default(1)
  currentDeliveryKey String?
  // Relay ingest / report time of the delivery that owns the row; an older edge never takes it back.
  currentRunAt       DateTime? @db.Timestamptz(6)
  // The hidden stable marker the daemon reconciles its note by; stable across generations.
  externalId         String  @unique
  noteId             String?

  desiredState  String
  observedState String?
  // Bounded normalized code only — never provider or runtime exception text.
  reason        String?
  // Terminal-authority watermark: a late queued/running edge cannot regress a sealed generation.
  sealedThrough BigInt  @default(0)

  queuedAt    DateTime? @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  // ACP session behind the ordinary authenticated Console link; never a token-bearing URL.
  sessionId       String?
  // Purge fence copied from the project binding: a stale effect lease loses against a newer epoch.
  credentialEpoch BigInt  @default(1)
  // The complete §17.2 placement fence, stored verbatim so the desired frame echoes exactly the
  // accepted dispatch tuple. Any member missing ⇒ the row is not dispatchable (fail closed).
  configRevision        BigInt?
  dispatchRevision      BigInt?
  dispatchDaemonId      String? @db.Uuid
  reviewPolicySnapshot  String?
  reportingModeSnapshot String?
  gateModeSnapshot      String?

  // Write ownership. `leaseOwner` is the daemon id; `writeMarker`/`writePhase` are the
  // in-flight mutation mutex, and ownership may not move while one is set.
  leaseOwner     String?
  leaseUntil     DateTime? @db.Timestamptz(6)
  nextAttemptAt  DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastErrorCode  String?
  pendingIntent  Json?     @db.JsonB
  writeMarker    String?   @unique
  writePhase     String?
  writeStartedAt DateTime? @db.Timestamptz(6)
  tombstonedAt   DateTime? @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([hookId, projectId, mergeRequestIid, headSha, projectionEpoch])
  @@index([orgId])
  @@index([nextAttemptAt, leaseUntil])
  @@index([hookId, projectId, mergeRequestIid])
  @@index([agentId])
  @@map("code_host_run_projection")
}

// ───────────────────────────────────────────────────────────────────────────
// Relay — one registered ingress-relay instance (shared-bot-relay.md §6)
//   The relay pool is the platform's unified inbound plane: webchat now,
//   shared-bot + webhook with milestone B. Instances register dynamically over
//   the relay WS (`rc/register`); `lastSeenAt` is bumped by `rc/heartbeat` and
//   drives the liveness sweeper (stale rows are swept, and — milestone B —
//   their bots reassigned). No org column: relays are deployment-level infra
//   serving every tenant. No FKs and no secret material.
// ───────────────────────────────────────────────────────────────────────────

model Relay {
  id         String    @id @db.Uuid // minted by the CP on rc/register → rc/registered
  // Deployment-side identity (pod name etc.) — THE upsert key: a relay is
  // stateless, so after a restart `name` is its only stable identity and
  // re-registration reclaims the same row (and relayId). Unique so the upsert
  // is atomic (no duplicate rows for one pod racing the sweeper).
  name       String    @unique
  // The address daemons dial for THIS relay instance. MUST route to this
  // specific instance (per-pod DNS, or one hostname with relay-id-sticky
  // paths) — a pool-level random LB here breaks the no-cross-pod-forwarding
  // topology (design §5). The pool-level public ingress (browser/webhook) is
  // env-level PUBLIC_RELAY_URL and never stored per relay.
  daemonUrl  String
  // Advertised relay features (rc/register.features), e.g.
  // webchat_session_continuation_v1. Refreshed on every register.
  features   String[]  @default([])
  lastSeenAt DateTime? @db.Timestamptz(6) // rc/heartbeat; drives the failover sweeper
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([lastSeenAt])
  @@map("relay")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.15 Bot + Integration — a platform bot identity and its install (C6/C5)
//   `bot` is the durable identity (name + token material): it OUTLIVES the
//   integration that installs it, so uninstalling frees the bot for reuse from
//   the console picker instead of forcing a re-create. `bot_secret` holds the
//   stored SecretCipher representation behind the BotSecretStore seam — the ONLY
//   read/write path for tokens. `none` stores plaintext; an encrypting provider
//   stores ciphertext. `integration` is the install: it binds ONE bot to
//   ONE agent (`botId` unique ⇒ a bot serves at most one agent at a time) and
//   is what the owning daemon opens the socket from. The metadata read paths
//   (GET /bots, GET /integrations) never select the secret table.
// ───────────────────────────────────────────────────────────────────────────

model Bot {
  id                    String         @id @db.Uuid
  orgId                 String
  platform              String         @default("slack")
  name                  String // Slack app / display name
  prebuilt              Boolean        @default(false) // provisioned by AgentConnect, not a console user
  slackAppId            String? // Slack app id (A…), parsed from the pasted xapp token — deep-links the console to api.slack.com/apps/{id}. Public metadata, NOT secret material.
  // Slack workspace id ("T…", == Events API `team_id`), persisted by the platform
  // (distributed) app's OAuth callback. Load-bearing for relay demux: every install
  // of a distributed app shares one app id + signing secret, so only the composite
  // (slackAppId, teamId) identifies a workspace's Bot. NULL for legacy /
  // single-workspace bots. Public metadata, NOT secret material.
  teamId                String?
  // Slack's own copies of the identity pair below, kept because each is read for
  // its own reason: `slackAppId` is the console's deep-link to
  // api.slack.com/apps/{id}, and `teamId` rides `rc/bot-assign` to the relay,
  // whose delivery-time demux reads it to pick the strict (distributed install)
  // or learnable (single-workspace) arm. Neither is an identity fence — that is
  // the composite unique below.
  // External workspace identity used only to label/group bot rows in the Console.
  // Slack fills this from auth.test/OAuth for every bot kind. It is deliberately
  // separate from teamId, whose non-null value marks a distributed platform-app
  // install and participates in relay demux/admission behavior.
  workspaceId           String?
  workspaceName         String?
  // Slack bot user id ("U…"/"B…"), from the OAuth exchange (`bot_user_id`). Saves
  // the relay an auth.test round-trip and backs echo suppression. Public metadata.
  botUserId             String?
  // Stamped when the workspace uninstalled the app or revoked its tokens
  // (`app_uninstalled` / `tokens_revoked` via rc/bot-revoked). A revoked bot is
  // dead credential-wise; a platform-app re-install clears it (fresh token).
  revokedAt             DateTime?      @db.Timestamptz(6)
  // Install GENERATION of the bot's CURRENT credential. Slack does not guarantee
  // the ordering of `app_uninstalled` / `tokens_revoked`, so a delayed event from
  // a PRIOR install can land after the workspace re-installed — applying it would
  // revoke the fresh token and its live integrations. Both fields advance together
  // every time a new credential lands (`BotRepo.bumpCredential`): the revision is
  // echoed through rc/bot-assign → rc/bot-revoked so revocation can CAS on it, and
  // the timestamp lets the CP reject an event that HAPPENED before the credential
  // it would kill (the case where the relay already holds the newer assignment).
  credentialRevision    Int            @default(1)
  credentialInstalledAt DateTime?      @db.Timestamptz(6)
  // Bot scopes Slack REPORTED as granted for the current credential — the
  // `x-oauth-scopes` header observed when an install/refresh verified the token.
  // Empty means "never observed" (Slack omits the header at times), NEVER
  // "granted nothing": a real bot grant always carries at least one scope.
  // Advisory capability metadata — reads pick a credential that provably holds a
  // scope (e.g. the session-access workspace checker needs `users:read`); it is
  // never an authorization fence by itself.
  grantedScopes         String[]       @default([])
  // ── generic bot demux identity (integration-plugin-architecture.md D6/§11) ──
  // The platform's app-scoped id plus its tenant scope — the row's identity.
  // `BotRepo.getByExternalIdentity` is the only lookup and the composite unique
  // below is the only constraint, so every platform is fenced by one rule. Slack
  // fills these from `(slackAppId, teamId)`. NULL means no app identity was
  // captured (a pasted-token Slack install), and Postgres keeps those distinct; a
  // tenantless platform writes the '-' sentinel instead.
  externalAppId         String?
  externalTenantId      String?
  // Per-platform public row metadata, written by `projectBotIdentity` and read
  // back into the record's named fields at the repository seam. Never demux
  // identity (that is the pair above), never secret material.
  //   discordAppId — Discord application (client) id, decoded from the bot token's
  //     first segment; backs the console's ready-made "Add to Discord" invite URL.
  //   feishuAppId  — Feishu/Lark app id (cli_…), so Settings can deep-link to the
  //     app without reading bot_secret.
  //   feishuRegion — 'feishu' (open.feishu.cn) | 'lark' (open.larksuite.com);
  //     absent ⇒ 'feishu'. DURABLE home, so a freed Lark bot reinstalls against
  //     the gateway it came from.
  // A platform adds a key here instead of a column, which is the whole point:
  // the fifth platform costs a registry line, not a migration.
  platformConfig        Json?
  // Shared-bot opt-in (shared-bot-relay.md §4.1). false ⇒ classic 1-bot:1-agent
  // (daemon owns the whole socket, zero behaviour change). true ⇒ the bot's
  // INBOUND migrates to a relay and it may serve MULTIPLE agents (one Integration
  // row per agent). Per-bot, not per-install — a uniform rule, no mode switching.
  shareable             Boolean        @default(false)
  // IM ingress transport. `socket` means the daemon owns the platform's outbound
  // long connection (Slack Socket Mode or Feishu WSClient). `http` means the relay
  // receives callbacks and the daemon gets a send-only spec. This is the
  // direct-vs-shared axis; `shareable` is the multi-agent-within-http sub-flag.
  transport             SlackTransport @default(socket)
  createdByUserId       String? // WebUI user who registered it (audit)
  lastUsedAt            DateTime?      @db.Timestamptz(6) // stamped when its integration is removed
  lastAgentName         String? // agent the bot was last freed from (console display hint)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)

  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  secret       BotSecret?
  // A shareable bot backs MANY installs (one per agent); a classic bot backs ≤1.
  // The 1-install cap for classic bots is enforced in the install route, not by a
  // unique FK (dropped so shared bots can fan out).
  integrations Integration[]

  // One Bot per external app identity per platform — the relay demux fence, and
  // cross-org global because a workspace binds to exactly one org. A row that
  // captured no app identity carries NULLs, which Postgres treats as distinct:
  // that is the pre-capture Slack case (tokens pasted without an OAuth exchange),
  // deliberately unfenced because there is nothing to fence ON. Tenantless
  // platforms write the '-' sentinel instead, which makes this enforce
  // (platform, externalAppId) uniqueness declaratively.
  @@unique([platform, externalAppId, externalTenantId])
  @@index([orgId])
  @@map("bot")
}

/**
 * Inbound transport for a bot. The historical enum name is retained to avoid a
 * destructive PostgreSQL enum rename; see Bot.transport.
 */
enum SlackTransport {
  socket
  http
}

model BotSecret {
  botId             String  @id @db.Uuid
  botToken          String // xoxb-… / Telegram token in stored SecretCipher form; read ONLY via BotSecretStore
  appToken          String? // xapp-… for Slack Socket Mode; Feishu/Lark reuses this slot for its app id; NULL for single-token platforms
  // Slack signing secret — verifies inbound Events API POSTs (HMAC). Lives ONLY here
  // + is shipped to the relay in rc/bot-assign (http transport); daemons never get it.
  signingSecret     String? // Slack signing secret (http transport); NULL for socket/Telegram
  // Feishu callback credentials. The verification token is required in HTTP mode;
  // encryptKey is optional and enables signed/encrypted callback bodies. Neither is
  // sent to daemons, while the Feishu app secret remains daemon-only.
  verificationToken String?
  encryptKey        String?

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_secret")
}

// ───────────────────────────────────────────────────────────────────────────
// SharedThreadAgent (slack-http-mode §10) — durable per-sessionKey thread affinity
// for http-transport shared bots. A relay reports (botId, sessionKey)→{agentId,
// daemonId} the first time it routes a thread (rc/thread-assign); the CP persists it
// here (single writer) and broadcasts it to every relay (rc/assign), and answers a
// pull-on-miss lookup (rc/thread-lookup). Relay-opaque `sessionKey`; no FKs (daemon/
// agent may churn — mirrors relay / github_install_state FK-less infra).
// ───────────────────────────────────────────────────────────────────────────
model SharedThreadAgent {
  botId      String   @db.Uuid
  sessionKey String
  agentId    String   @db.Uuid
  daemonId   String   @db.Uuid
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@id([botId, sessionKey])
  @@index([botId])
  @@map("shared_thread_agent")
}

// Durable multi-agent room membership for relay-pooled HTTP bots. Unlike
// SharedThreadAgent, this is a set and never changes the compatibility owner.
// It is routing metadata only: no message body or transcript content is stored.
model SharedThreadParticipant {
  botId      String   @db.Uuid
  sessionKey String
  agentId    String   @db.Uuid
  daemonId   String   @db.Uuid
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@id([botId, sessionKey, agentId])
  @@index([botId])
  @@map("shared_thread_participant")
}

enum IntegrationStatus {
  active
  revoked
}

model Integration {
  id                        String            @id @db.Uuid // IntegrationSpec.integrationId
  orgId                     String
  agentId                   String            @db.Uuid // owner ⇒ delivery daemon (agent.daemonId)
  // The identity this install runs as. NO @unique: a shareable bot fans out to
  // one Integration row per agent (shared-bot-relay.md §4.1). A classic
  // (non-shareable) bot is still capped at ≤1 install by the create route.
  botId                     String            @db.Uuid
  platform                  String            @default("slack")
  name                      String // Slack app / display name (mirrors bot.name at install time)
  status                    IntegrationStatus @default(active)
  // Credential generation whose uninstall/token-revocation flipped this row.
  // Null for active rows and user-freed rows (which are deleted, not revoked).
  revokedCredentialRevision Int?
  feishuRegion              String? // Feishu/Lark open-platform gateway: 'feishu' (open.feishu.cn) | 'lark' (open.larksuite.com). NULL ⇒ 'feishu' (default / non-feishu integrations). Public config, NOT secret.
  createdByUserId           String? // WebUI user who installed it (audit)
  createdAt                 DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime          @updatedAt @db.Timestamptz(6)

  org             Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent           Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Restrict: the bot is the durable identity — it must never vanish underneath a
  // live install. Uninstall deletes the integration row and FREES the bot.
  bot             Bot                  @relation(fields: [botId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  channels        IntegrationChannel[]
  // Crons/hooks whose target anchor posts through this integration (SetNull on uninstall).
  targetedByCrons CronDef[]
  targetedByHooks HookDef[]

  @@index([orgId])
  @@index([agentId])
  @@index([botId])
  @@map("integration")
}

// How the bot activates in one conversation: not at all (conversation gating,
// resource-visibility.md §14), only when @-mentioned, or on any message.
enum ChannelTrigger {
  off
  mention
  any
}

// Conversation kind (resource-visibility.md §14.3): a member channel vs a direct
// conversation. Direct rows are observed incrementally for every integration.
// `mpim` is a Slack multi-person DM — reported on observation like `im` (Slack
// never lists them as bot membership), but mention-gated like a channel.
enum ConversationKind {
  channel
  im
  mpim
}

// One conversation the integration's bot participates in. `integration/channels`
// carries either an authoritative membership snapshot or a partial observed-
// conversation report; DM rows and rows absent from partial reports are retained.
// The operator's per-conversation trigger survives both forms. Channel id/name are
// control metadata — never message content (§1/§12).
model IntegrationChannel {
  integrationId String           @db.Uuid
  channelId     String // platform conversation id (Slack "C…" / DM "D…")
  name          String? // "#deploys" without the hash (or DM counterpart); null if lookup failed
  // Enclosing space the conversation lives in — a Discord guild. One bot spans several
  // servers, each with its own "#general", so the console needs it to tell the rows
  // apart. `spaceId` (the guild snowflake) is the identity — two guilds may share a
  // name — and `space` is the display label. Null on single-container platforms, on DM
  // rows, and until the daemon resolves them.
  spaceId       String?
  space         String?
  isPrivate     Boolean          @default(false)
  kind          ConversationKind @default(channel)
  // The 1:1 DM counterpart's platform member id (resource-visibility.md §14.8). Control
  // metadata of the same class as `name` — it says WHO the row is with, which is what
  // lets a private agent's DM follow that person's linked console identity instead of
  // defaulting Off. Null on channels, on group DMs, and on rows reported before §14.8.
  dmUserId      String?
  // Relay-backed shared-bot rows repeat the effective trigger across each active
  // integration so deleting the canonical owner does not discard conversation state.
  // Classic integrations keep their trigger per integration.
  trigger       ChannelTrigger   @default(mention)
  // True once a HUMAN chose this conversation's trigger (resource-visibility.md §14.8).
  // A stored Off is otherwise indistinguishable from a default nobody has decided yet,
  // and the two need opposite treatment: §14.8's catch-up may open a defaulted row and
  // must never reopen one an editor deliberately closed.
  triggerChosen Boolean          @default(false)
  // Per-conversation default/owning agent for a SHARED bot (shared-bot-relay.md §10.1
  // conversation ownership — the primary disambiguation path). Exactly one active
  // integration row per shared conversation carries the owner; sibling rows are null.
  // Irrelevant for a classic integration, where its agent is the only target.
  agentId       String?          @db.Uuid
  firstSeenAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, channelId])
  @@index([agentId])
  @@map("integration_channel")
}

// Pending Slack auto-install session (docs/designs/slack-install-smoothing.md §Tier B).
// A short-lived bridge for the config-token funnel: the app is created via
// apps.manifest.create and its client credentials + the OAuth-obtained bot token
// live here until the operator pastes the app-level token and `finalize` creates
// the real bot + integration (then this row is DELETED). `clientSecret`/`botToken`
// pass through SecretCipher with the same discipline as `bot_secret` — plaintext
// under `none`, ciphertext under an encrypting provider; NEVER logged or included
// in a DTO. No FKs (mirrors github_install_state): a dangling row after an
// org/agent delete is harmless and TTL-reaped. The `id` doubles as the
// unforgeable OAuth `state`.
model SlackInstall {
  id              String         @id @db.Uuid // == OAuth state
  orgId           String
  agentId         String         @db.Uuid // install target (owner ⇒ delivery daemon)
  appId           String // A… — manifest-created app id (deep links + association)
  clientId        String
  clientSecret    String // sensitive — secret discipline, never logged/DTO'd
  botToken        String? // xoxb-…, backfilled by the OAuth callback
  name            String? // operator-chosen app name; null ⇒ derived at finalize
  // slack-http-mode quick-install: the finalize path + the http signing secret that
  // apps.manifest.create returns at start (the browser never sees it), so an http
  // auto-install finalizes with no manual paste. `shareable` is NOT stored — it's a
  // non-secret choice the console re-sends in the finalize body.
  transport       SlackTransport @default(socket)
  signingSecret   String? // http: captured at app-create; used at finalize
  createdByUserId String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)

  @@map("slack_install")
}

// Pending install of the PLATFORM-published (distributed) Slack app
// (preset-agents.md §5.3). Unlike SlackInstall, no per-app credentials live here —
// the app id / client secret / signing secret are deployment env config
// (SLACK_PLATFORM_*). The row binds the OAuth `state` to either {org, target
// agent, initiating user} or {org, expected bot, initiating user}. The `id`
// doubles as the unforgeable OAuth `state`; rows are TTL-reaped alongside
// slack_install. No FKs (mirrors slack_install): a dangling row after an
// org/agent/bot delete is harmless.
model SlackPlatformInstall {
  id              String                     @id @db.Uuid // == OAuth state
  orgId           String
  // Generic installs bind a target agent. A bot-bound Settings reauthorization
  // leaves this null so a freed bot stays free.
  agentId         String?                    @db.Uuid
  // Terminal state of the OAuth round trip — the row IS the console's completion
  // signal. It must survive the callback (not be deleted) because a successful
  // RE-authorization of a workspace this agent already has need not create any
  // new integration: "a new integration appeared" cannot distinguish success
  // from a still-pending tab. `failureReason` carries the same short code the
  // callback's close page shows, so the console can report WHY it failed.
  status          SlackPlatformInstallStatus @default(pending)
  failureReason   String?
  // The required bot scopes the workspace authorization did not grant, when
  // `failureReason` is 'missing_scopes'. Empty otherwise. Reported verbatim to
  // the console: "reinstall the app" is only actionable when it names what is
  // absent, and the console cannot derive the list from the code alone.
  missingScopes   String[]                   @default([])
  // For a Settings reauthorization this is populated while pending and fences
  // the OAuth callback to that exact Bot/workspace. Generic installs fill it on
  // completion for the console deep-link.
  botId           String?                    @db.Uuid
  createdByUserId String?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  settledAt       DateTime?                  @db.Timestamptz(6)

  @@map("slack_platform_install")
}

/**
 * Terminal state of a platform Slack app install (see SlackPlatformInstall.status).
 */
enum SlackPlatformInstallStatus {
  pending
  completed
  failed
}

// Durable Feishu/Lark one-click app registration. The browser polls this row,
// so any Control Plane replica can continue the provider device flow after a
// request is load-balanced or a process restarts. `deviceCode` and `appSecret`
// pass through SecretCipher in PgFeishuAppRegistrationStore and are cleared on
// every terminal outcome. No FKs: the route re-validates the agent immediately
// before installation, and abandoned rows are TTL-reaped.
model FeishuAppRegistration {
  id               String                      @id @db.Uuid
  // Non-null only while open. The unique slot prevents two users from creating
  // two apps for the same target; terminal settlement clears it.
  targetKey        String?                     @unique
  orgId            String
  agentId          String                      @db.Uuid
  requestedName    String?
  fallbackRegion   String
  transport        SlackTransport              @default(socket)
  authorizationUrl String
  providerDomain   String
  deviceCode       String? // sensitive — sealed by SecretCipher
  intervalMs       Int
  nextPollAt       DateTime                    @db.Timestamptz(6)
  expiresAt        DateTime                    @db.Timestamptz(6)
  status           FeishuAppRegistrationStatus @default(pending)
  failureReason    String?
  appId            String?
  appSecret        String? // sensitive — sealed by SecretCipher
  resolvedRegion   String?
  // Pre-reserved IDs make finalization restart-idempotent.
  botId            String                      @db.Uuid
  integrationId    String                      @db.Uuid
  createdByUserId  String?
  claimToken       String?                     @db.Uuid
  claimedUntil     DateTime?                   @db.Timestamptz(6)
  createdAt        DateTime                    @default(now()) @db.Timestamptz(6)
  settledAt        DateTime?                   @db.Timestamptz(6)

  @@index([status, nextPollAt])
  @@map("feishu_app_registration")
}

enum FeishuAppRegistrationStatus {
  pending
  authorized
  completed
  failed
}

// One user's stored Slack App Configuration Token, scoped to an org (composite key
// orgId+userId) — docs/designs/slack-install-smoothing.md §Tier B. PER-USER on purpose:
// the app that `apps.manifest.create` builds is owned by whoever's config token
// created it, and only that user can then generate the app's app-level (xapp) token
// on api.slack.com. So each initiator stores their OWN token and installs entirely
// on their own — no shared token that pins every app to one person. When the caller
// has one AND the funnel is enabled, the console FORCES auto-install; absent ⇒ the
// manual flow. The access token expires ~12h after issue, so we persist the refresh
// token and rotate via `tooling.tokens.rotate` when it is stale (each rotate returns
// a NEW pair — last write wins). `accessToken`/`refreshToken` pass through
// SecretCipher with the same discipline as `bot_secret`: plaintext under `none`,
// ciphertext under an encrypting provider; NEVER logged or included in a DTO.
model SlackUserConfig {
  orgId           String
  userId          String
  accessToken     String // xoxe.xoxp-… — the App Configuration access token
  refreshToken    String? // xoxe-… — used to rotate a fresh access token; null ⇒ access-only (expires ~12h, then re-enter)
  accessExpiresAt DateTime @db.Timestamptz(6) // when accessToken expires (~12h; drives rotation / re-entry)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("slack_user_config")
}

// One connected Linear workspace's OAuth grant (docs/designs/linear-integration.md §4.4, §7.2).
// Keyed by the CONNECTION identity `(orgId, clientId, organizationId)` — the same pair the workspace
// Bot's D6 columns mirror — and deliberately NOT by the Bot row id: the token is the workspace's
// authorization of the deployment's one OAuth app, so it survives agent-membership churn, it can be
// written before the Bot row exists (the callback's step-1 upsert), and adding or removing a member
// agent never touches it. Linear access tokens expire in ~24h and refresh ROTATES the refresh token,
// so the CP is the single durable writer; both values pass through SecretCipher under the org scope,
// exactly like `bot_secret`. Never logged, never in a DTO.
model LinearToken {
  orgId          String
  clientId       String // the deployment app's OAuth client id (constant across rows)
  organizationId String // the Linear workspace (organization) id
  accessToken    String // ≤24h; projected into the integration spec and brokered over `linearcred`
  refreshToken   String? // rotates on every refresh; CP-only, never leaves this table
  expiresAt      DateTime @db.Timestamptz(6) // when accessToken expires (drives refresh)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, clientId, organizationId])
  @@map("linear_token")
}

// Pending "connect a Linear workspace" funnel state (linear-integration.md §7.1): the one-shot OAuth
// `state` nonce bound to the initiating org/user and the workspace's chosen default agent. NO secret
// material — the deployment app's credentials are deployment config and the tokens only exist after
// the callback. No FKs (mirrors slack_platform_install): a dangling row after an org/agent delete is
// harmless and TTL-reaped.
model LinearInstallState {
  id              String   @id @db.Uuid // == the OAuth state nonce
  orgId           String
  defaultAgentId  String?  @db.Uuid // the member agent bare delegations start a session with
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@map("linear_install_state")
}

// ───────────────────────────────────────────────────────────────────────────
// §3.12 AuditEvent — audit log / events feed (C6 + C7)
// ───────────────────────────────────────────────────────────────────────────

enum AuditKind {
  daemon_auth
  daemon_register
  daemon_unreachable
  route_assign
  route_release
  drain
  agent_launch
  agent_stop
  scope_denied
  secret_grant
  secret_revoke
  cron_change
  hook_change
  agent_repo_change
  org_invite_change
  protocol_error
  api_key_create
  api_key_rotate
  api_key_revoke
  mcp_tool_call
}

model AuditEvent {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  orgId       String?
  kind        AuditKind
  daemonId    String?   @db.Uuid
  agentId     String?   @db.Uuid
  sessionId   String?   @db.Uuid
  actorUserId String? // set when action came from WebUI
  frameType   String? // "route/assign", "error", …
  frameCorr   String?   @db.Uuid // Envelope.id / corr (tracing)
  message     String?   @db.Text // redacted, human-readable
  details     Json?     @db.JsonB // {expected:<seq>}, {capability}, …
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@index([daemonId, createdAt])
  @@index([kind, createdAt])
  @@map("audit_event")
}

// ── GitHub App (github-app workspaces; docs/designs/github-app-git-credentials.md §Configuration and Data Model) ──
// The App identity itself (id/slug/private key) is DEPLOYMENT CONFIG (GITHUB_APP_* env),
// never persisted. Only its installations are rows, claimed to an org.
// Visibility taxonomy: infrastructure, like `bot` — always org-visible, never restricted.

enum GitAccess {
  read
  write
}

/// One installation of the deployment GitHub App on a GitHub org/user account,
/// claimed by an AgentConnect org. Rows are only ever MARKED dead (`revokedAt`)
/// — never deleted — because agents keep `installationId` provenance pointers;
/// minting resolves live installations by account login, not by row liveness.
model GithubInstallation {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String
  installationId      BigInt    @unique // GitHub-side installation id
  accountLogin        String // e.g. "example-org"
  accountType         String // "Organization" | "User"
  repositorySelection String // "all" | "selected"
  // Installation-effective permissions as returned by GitHub. Unknown/legacy
  // rows use {}, which is intentionally fail-closed for review/check effects.
  permissions         Json      @default("{}") @db.JsonB
  suspendedAt         DateTime? @db.Timestamptz(6)
  revokedAt           DateTime? @db.Timestamptz(6) // sync found it uninstalled ⇒ mark, don't delete
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("github_installation")
}

/// One-shot HMAC-signed install-state nonces (the `state` on the GitHub install
/// deep link / setup callback). Consumed exactly once — replay ⇒ reject. Expired
/// rows are garbage; consumption deletes, and expiry is also embedded in the
/// signed state itself so stale rows can never be replayed.
model GithubInstallState {
  nonce     String   @id // random 128-bit, base64url
  orgId     String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("github_install_state")
}

// ───────────────────────────────────────────────────────────────────────────
// GitLab.com integration (gitlab-com-integration.md §8.2, §9) — the OAuth
// administration identity. Metadata here; sealed token material lives ONLY in
// the side-tables read through their secret stores (BotSecret discipline).
// ───────────────────────────────────────────────────────────────────────────

/// One org member's GitLab.com OAuth connection — the ADMINISTRATION identity
/// (project discovery, provisioning); never a runtime credential. `state` is
/// TEXT with the app-layer closed set: connected | reauth_required | disconnected.
model GitlabConnection {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String
  userId          String? // the AgentConnect user who connected; null after user deletion
  gitlabUserId    BigInt // numeric GitLab.com user id — the stable identity
  gitlabUsername  String // display only, refreshed on sync
  scopes          String[]  @default([])
  accessExpiresAt DateTime? @db.Timestamptz(6) // access-token expiry (observability; refresh is authoritative)
  state           String
  // Refresh single-writer (§9.3): one process claims the lease, refreshes, and
  // commits both sealed tokens under a tokenVersion CAS; others reload.
  tokenVersion    BigInt    @default(1)
  refreshLeaseOwner String?
  refreshLeaseUntil DateTime? @db.Timestamptz(6)
  lastSyncAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  org    Org                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User?                   @relation("GitlabConnectionUser", fields: [userId], references: [id], onDelete: SetNull)
  secret GitlabConnectionSecret?
  installedBindings GitlabProjectBinding[] @relation("GitlabBindingInstaller")
  administeredAccounts GitlabAgentAccount[] @relation("GitlabAccountAdministrator")

  @@unique([orgId, gitlabUserId])
  @@index([orgId])
  @@map("gitlab_connection")
}

/// Sealed OAuth access+refresh pair, 1:1 with GitlabConnection. BotSecret
/// discipline: list/DTO queries never join it; read ONLY via the secret store.
model GitlabConnectionSecret {
  connectionId String @id @db.Uuid
  accessToken  String // stored SecretCipher representation
  refreshToken String // stored SecretCipher representation

  connection GitlabConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("gitlab_connection_secret")
}

/// One managed GitLab.com project (gitlab-com-integration.md §8.2, §10): the
/// org-scoped binding that owns the Project Service Account, purpose-separated
/// credentials, and the managed webhook. `state` is TEXT with the app-layer
/// closed set: provisioning | ready | admin_degraded | runtime_degraded |
/// cleanup_pending — never collapsed into one connected boolean (§8.2).
model GitlabProjectBinding {
  id                     String    @id @default(uuid()) @db.Uuid
  orgId                  String
  projectId              BigInt // numeric GitLab.com project id — the match key
  projectPath            String // current namespaced path — display only, refreshed by the reconciler
  defaultBranch          String?
  // The OAuth connection currently responsible for administration (§7.1); a
  // different Maintainer/Owner may explicitly take over. SetNull on removal —
  // the binding then reads admin_degraded, never silently transfers.
  installerConnectionId  String?   @db.Uuid
  webhookId              BigInt? // the one AgentConnect-managed project webhook (§10.3)
  desiredEventsHash      String? // hash of the enabled-hook event union the webhook was last converged to
  credentialEpoch        BigInt    @default(1) // purge fence: bumped on rotation/revocation/disconnect
  // A convergence that lost a fence wrote nothing, so this is the only record
  // that one is still owed. Neutral, not a degraded state: the binding keeps
  // whatever it was, and a sweep re-drives it — including after a restart.
  convergeOwedAt         DateTime? @db.Timestamptz(6)
  state                  String
  stateReason            String? // bounded normalized repair category for degraded states
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installer   GitlabConnection? @relation("GitlabBindingInstaller", fields: [installerConnectionId], references: [id], onDelete: SetNull)
  memberships GitlabAccountMembership[]
  webhookSecret GitlabWebhookSecret?

  @@unique([orgId, projectId])
  @@index([orgId])
  @@index([convergeOwedAt])
  @@map("gitlab_project_binding")
}

/// One group service account per (organization, agent, top-level group) — the
/// runtime identity every note, review, and push is authored by (§7.2, §8.2).
/// `username` is the rename-stable deterministic marker; `displayName` is the
/// last synced label. `agentId` deliberately carries NO foreign key: an account
/// whose external cleanup is still owed outlives the agent that earned it.
/// `state` is TEXT with the binding's own closed set; `lifecycle` is the
/// generation fence a membership insert commits against (§7.2).
model GitlabAgentAccount {
  id                        String    @id @default(uuid()) @db.Uuid
  orgId                     String
  agentId                   String    @db.Uuid
  rootGroupId               BigInt // numeric TOP-LEVEL group id — accounts cannot cross it
  serviceAccountUserId      BigInt? // numeric GitLab user id; null until created
  username                  String // <agentSlug>-<agentId12>-<root36>, taken at creation
  displayName               String? // fingerprint of the agent name last synced to the provider
  avatarFingerprint         String? // fingerprint of the agent icon last uploaded as the avatar
  createAttemptId           String? // open service-account create attempt (§7.2 recovery window)
  createAttemptAt           DateTime? @db.Timestamptz(6) // when that attempt opened
  createAttemptKnownIds     BigInt[] // the root's service accounts when it opened
  credentialEpoch           BigInt    @default(1) // purge fence: bumped on every PAT rotation
  administeringConnectionId String?   @db.Uuid // the OAuth connection currently administering it
  leaseOwner                String? // account mutation lease (§7.2): create/rotate/rename/retire
  leaseUntil                DateTime? @db.Timestamptz(6)
  generation                BigInt    @default(1) // lifecycle generation a membership insert fences on
  lifecycle                 String    @default("active") // active | retiring
  // The binding removal, if any, that is waiting on this retirement. Memberships
  // are detached before a deletion settles, so without this the removal would
  // lose track of what it still owes evidence for. No relation: the row must
  // outlive a binding that is removed once every obligation clears.
  retiringForBindingId      String?   @db.Uuid
  state                     String
  stateReason               String? // bounded repair category, e.g. service_account_quota
  createdAt                 DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @db.Timestamptz(6)

  org           Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  administering GitlabConnection?         @relation("GitlabAccountAdministrator", fields: [administeringConnectionId], references: [id], onDelete: SetNull)
  memberships   GitlabAccountMembership[]
  credentials   GitlabProjectCredential[]

  @@unique([orgId, agentId, rootGroupId])
  @@index([orgId])
  @@index([agentId])
  @@index([retiringForBindingId])
  @@map("gitlab_agent_account")
}

/// One account's project membership — authorization made external (§7.2). The
/// row is inserted against the account's CURRENT lifecycle generation, so a
/// bind racing a retirement loses deterministically instead of resurrecting a
/// deleted account.
model GitlabAccountMembership {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @db.Uuid
  accountGeneration BigInt // the account generation this membership was bound under
  bindingId         String   @db.Uuid
  accessLevel       Int // GitLab access level the workspace gitAccess clamp derives
  state             String   @default("active") // active — the app-layer closed set
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  account GitlabAgentAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  binding GitlabProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([accountId, bindingId])
  @@index([bindingId])
  @@map("gitlab_account_membership")
}

/// One purpose-separated service-account PAT (§7.3): read | git_write | effect.
/// Metadata only — the sealed token value lives in the side-table below, read
/// exclusively through its secret store. Keyed by the ISSUING ACCOUNT (§8.2):
/// PATs are per agent account, not per project.
model GitlabProjectCredential {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @db.Uuid
  purpose           String // read | git_write | effect — app-layer closed set
  externalTokenId   BigInt // provider PAT id — the revocation/rotation handle
  scopes            String[]  @default([])
  providerExpiresAt DateTime  @db.Timestamptz(6)
  generation        BigInt    @default(1) // rotation counter; the active row is the (account, purpose) row
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  account GitlabAgentAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  secret  GitlabProjectCredentialSecret?

  @@unique([accountId, purpose])
  @@map("gitlab_project_credential")
}

/// Sealed PAT value, 1:1 with its credential row (BotSecret discipline).
model GitlabProjectCredentialSecret {
  credentialId String @id @db.Uuid
  token        String // stored SecretCipher representation

  credential GitlabProjectCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@map("gitlab_project_credential_secret")
}

/// Sealed webhook signing key, 1:1 with the binding (§11.1). Relay-only secret:
/// compiled into rules, never sent to a daemon.
model GitlabWebhookSecret {
  bindingId  String @id @db.Uuid
  signingKey String // stored SecretCipher representation of the whsec_ form

  binding GitlabProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@map("gitlab_webhook_secret")
}

/// One-shot OAuth authorization state (§9.1): bound to org, user, browser (a
/// cookie-nonce hash stamped at the begin hop), exact return path, and the
/// sealed PKCE verifier. Consumed exactly once at the callback; expired rows
/// are garbage. The `state` sent to GitLab is exactly `nonce` — opaque, no
/// embedded ids or reusable claims.
model GitlabOauthState {
  nonce       String   @id // random 128-bit, base64url
  orgId       String
  userId      String
  browserHash String? // sha256 of the begin-hop browser cookie nonce; null until begin
  returnPath  String // allowlisted local console path for the final redirect
  verifier    String // sealed PKCE verifier (SecretCipher representation)
  expiresAt   DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("gitlab_oauth_state")
}

/// Deployment-level observed facts about the GitLab instance (§24.2): the
/// authenticated `GET /api/v4/version` at first credentialed contact, refreshed
/// on the reconciliation pass. Keyed on the normalized base URL, so a re-target
/// after a full disconnect can never inherit another instance's version.
model GitlabInstanceState {
  baseUrl    String   @id
  version    String // exactly what the instance reported, e.g. '18.11.0-ee'
  enterprise Boolean  @default(false)
  observedAt DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("gitlab_instance_state")
}

// ───────────────────────────────────────────────────────────────────────────
// Centralized tool management — MCP provider registry (docs/designs/
// centralized-tool-management.md). CP owns MCP provider definitions; the relay
// reverse-proxies agent calls so the upstream credential never reaches the
// daemon/agent. Mirrors the Bot / BotSecret split: metadata table + secret
// side-table read only via McpProviderSecretStore.
// ───────────────────────────────────────────────────────────────────────────
enum McpTransport {
  http
  sse
}

// How a provider row was created / what manages it. `custom` = an operator-entered
// upstream MCP server (url + headers). `open_connector` = a connection provisioned
// through the open-connector integration (docs: connectors); the url is the
// open-connector /mcp endpoint and the upstream header carries the connection
// profile alias. Display + create-flow discriminator only — the wire (rc/mcp-assign,
// daemon proxy def) is identical for both.
enum McpProviderKind {
  custom
  open_connector
}

model McpProvider {
  // uuid (not cuid): providerId rides the wire as rc/mcp-assign.providerId (z.string().uuid()).
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String
  name            String // reference key; the agent enable-list + probe facts key on it
  kind            McpProviderKind    @default(custom) // custom upstream vs open-connector connection
  transport       McpTransport       @default(http) // v1 accepts http (Streamable HTTP) only
  url             String // upstream endpoint (non-secret; may appear in DTOs)
  // Console visibility — same Shareable model as Agent/Daemon/Cron
  // (docs/designs/resource-visibility.md): 'org' = every member sees it; 'restricted'
  // = the complete sharedWith audience. Governs console access only — an agent that
  // already enabled a provider keeps reaching it regardless (never crosses the wire).
  visibility      ResourceVisibility @default(org)
  sharedWith      String[]           @default([]) // complete app_user.id audience when visibility='restricted'
  createdByUserId String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  org       Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("McpProviderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  secret    McpProviderSecret?
  grants    McpGrant[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("mcp_provider")
}

// Upstream auth headers pass through SecretCipher: plaintext under `none`,
// ciphertext under an encrypting provider. Read ONLY via
// McpProviderSecretStore, never in a DTO, and never pushed to a daemon (same
// discipline as bot_secret). Shipped to the relay in rc/mcp-assign, injected on
// forward.
model McpProviderSecret {
  mcpProviderId String @id @db.Uuid
  headers       Json   @default("[]") @db.JsonB // {name,value}[] — upstream apikey etc.

  provider McpProvider @relation(fields: [mcpProviderId], references: [id], onDelete: Cascade)

  @@map("mcp_provider_secret")
}

// A proxy grant: the bearer key the daemon injects into the agent and the relay
// validates. v1 = one active grant per provider (shared identity). The CP re-pushes
// the plaintext key to daemons on every reconcile, so the persisted value must be
// recoverable through SecretCipher. `none` stores plaintext; an encrypting provider
// stores ciphertext. The key remains store-only and never enters a DTO; the relay
// receives only sha256(key) via rc/mcp-assign.
model McpGrant {
  id            String   @id @default(cuid())
  mcpProviderId String   @db.Uuid
  key           String   @unique // bearer grant key in stored SecretCipher form; store-only
  status        String   @default("active") // active | revoked
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  provider McpProvider @relation(fields: [mcpProviderId], references: [id], onDelete: Cascade)

  @@index([mcpProviderId])
  @@map("mcp_grant")
}

// ───────────────────────────────────────────────────────────────────────
// Shared skills registry (docs/designs/shared-skills.md). The CP records only a
// bounded public GitHub SOURCE, its numeric repository identity, and optional
// ref/subdir/skill filter — skill CONTENT never touches the CP. The daemon
// acquires a commit-bound local snapshot and installs it with its bundled exact
// CLI before the ACP host spawns. There is no secret side-table or repo grant.
//
// The per-agent enable-list is NOT a relation here; like mcpServers it lives as
// a string[] of "<sourceName>/<skillName>" (or "<sourceName>/*") inside the
// agent's runtimeOverrides JSON bag. The CP resolves those into self-contained
// AgentSpec.skills entries when it assembles the spec (agentSpecAssembler).
model SkillSource {
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String
  name            String // reference key; the agent enable-list keys on it. @@unique([orgId, name])
  source          String // bounded GitHub acquisition input; the CLI sees only a local snapshot
  githubRepoId    BigInt? // nullable for migration; unbound rows never project to AgentSpec
  ref             String? // optional branch/tag/commit; composed into the source (design §5)
  subDir          String? // optional repo-relative install dir
  skills          String[]           @default([]) // empty ⇒ install every skill; else only these (passed as -s)
  visibility      ResourceVisibility @default(org)
  sharedWith      String[]           @default([]) // complete app_user.id audience when visibility='restricted'
  createdByUserId String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SkillSourceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("skill_source")
}

// ───────────────────────────────────────────────────────────────────────
// Organization Knowledge + managed Agent Skills bundles
// (docs/designs/organization-knowledge.md).
// Pending candidate bodies stay daemon-local; only their metadata is indexed
// here. Accepted revisions are immutable product-owned shared content.
// ───────────────────────────────────────────────────────────────────────

// ── organization environment registry (organization-secrets-and-variables.md) ──

enum OrganizationEnvironmentKind {
  variable
  secret
}

/// How an entry enrolls agents. `all` is an automatic-ENROLLMENT policy, not an
/// authorization bypass: every effective assignment is still an explicit
/// OrganizationEnvironmentAssignment row created under a `resource.edit` decision
/// for that agent (design §3.4).
enum OrganizationEnvironmentAudience {
  all
  selected
}

/// One organization-owned variable or secret. Metadata only — a secret's value
/// lives in the sibling OrganizationEnvironmentSecret row so list and human-DTO
/// queries can never join it (the AgentSecret discipline).
///
/// `key` and `kind` are IMMUTABLE after creation: renaming or converting is an
/// explicit delete-and-create, which prevents an edit from silently changing the
/// meaning of the same organization-owned credential (design §3.1).
model OrganizationEnvironmentEntry {
  id                   String                          @id @default(uuid()) @db.Uuid
  orgId                String
  key                  String // env var name, validated at the API edge
  kind                 OrganizationEnvironmentKind
  variableValue        String? // non-null ONLY for kind=variable
  audience             OrganizationEnvironmentAudience
  version              Int                             @default(1) // editor-conflict fence for PATCH (expectedVersion)
  createdByUserId      String?
  lastModifiedByUserId String?
  createdAt            DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                        @updatedAt @db.Timestamptz(6)

  org         Org                                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?                               @relation("OrgEnvCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  modifiedBy  User?                               @relation("OrgEnvModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  secret      OrganizationEnvironmentSecret?
  assignments OrganizationEnvironmentAssignment[]

  // ONE organization keyspace: an org cannot hold both a variable and a secret
  // with the same key (design §3.1).
  @@unique([orgId, key])
  // Referenced by the assignment FK so a binding cannot cross organizations.
  @@unique([id, orgId])
  @@index([orgId, audience])
  @@map("organization_environment_entry")
}

/// The write-only value of an organization secret. Every value passes through the
/// injected SecretCipher via OrganizationEnvironmentSecretStore — the ONLY
/// value-reading seam — so at-rest encryption stays a wiring change.
model OrganizationEnvironmentSecret {
  entryId   String   @id @db.Uuid
  value     String // passes through the SecretCipher seam (plaintext under the identity cipher)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  entry OrganizationEnvironmentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("organization_environment_secret")
}

/// One entry→agent binding: the durable delegation created when a request
/// authorized for `resource.edit` on that agent enrolled it (design §4). Once it
/// exists, `organization.manage` may rotate or delete the entry without gaining
/// any visibility into the agent.
model OrganizationEnvironmentAssignment {
  orgId              String
  entryId            String   @db.Uuid
  agentId            String   @db.Uuid
  authorizedByUserId String? // the actor whose resource.edit decision created the delegation
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  // Both FKs are COMPOSITE on orgId: a cross-organization binding is impossible
  // even for an internal caller, not merely rejected in application code.
  entry        OrganizationEnvironmentEntry @relation(fields: [entryId, orgId], references: [id, orgId], onDelete: Cascade)
  agent        Agent                        @relation(fields: [agentId, orgId], references: [id, orgId], onDelete: Cascade)
  authorizedBy User?                        @relation("OrgEnvAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)

  @@id([entryId, agentId])
  @@index([orgId, agentId])
  @@map("organization_environment_assignment")
}

enum OrganizationArtifactSource {
  manual
  dream
}

enum OrganizationSuggestionKind {
  knowledge
  skill
}

enum OrganizationSuggestionOperation {
  create
  update
}

enum OrganizationSuggestionState {
  pending
  accepted
  rejected
}

model OrganizationKnowledge {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String
  title            String
  currentRevision  Int       @default(1)
  archivedAt       DateTime? @db.Timestamptz(6)
  archivedByUserId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  org       Org                             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  revisions OrganizationKnowledgeRevision[]

  @@index([orgId, archivedAt, updatedAt])
  @@map("organization_knowledge")
}

model OrganizationKnowledgeRevision {
  knowledgeId       String                     @db.Uuid
  revision          Int
  content           String                     @db.Text
  summary           String?                    @db.Text
  tags              String[]                   @default([])
  digest            String
  source            OrganizationArtifactSource
  sourceAgentId     String?                    @db.Uuid
  sourceDreamId     String?
  sourceCandidateId String?                    @db.Uuid
  sourceSessionIds  String[]                   @default([])
  createdByUserId   String?
  reviewedByUserId  String?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)

  knowledge OrganizationKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@id([knowledgeId, revision])
  @@index([createdAt])
  @@map("organization_knowledge_revision")
}

model ManagedSkill {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String
  name             String
  description      String
  currentRevision  Int       @default(1)
  archivedAt       DateTime? @db.Timestamptz(6)
  archivedByUserId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  org       Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  revisions ManagedSkillRevision[]

  @@unique([orgId, name])
  @@index([orgId, archivedAt, updatedAt])
  @@map("managed_skill")
}

model ManagedSkillRevision {
  managedSkillId    String                     @db.Uuid
  revision          Int
  archive           Bytes
  digest            String
  compressedBytes   Int
  expandedBytes     Int
  fileCount         Int
  manifest          Json                       @db.JsonB
  source            OrganizationArtifactSource
  sourceAgentId     String?                    @db.Uuid
  sourceDreamId     String?
  sourceCandidateId String?                    @db.Uuid
  sourceSessionIds  String[]                   @default([])
  createdByUserId   String?
  reviewedByUserId  String?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)

  skill ManagedSkill @relation(fields: [managedSkillId], references: [id], onDelete: Cascade)

  @@id([managedSkillId, revision])
  @@index([createdAt])
  @@map("managed_skill_revision")
}

model OrganizationSuggestion {
  id                       String                          @id @default(uuid()) @db.Uuid
  orgId                    String
  sourceAgentId            String                          @db.Uuid
  sourceDaemonId           String?                         @db.Uuid
  dreamId                  String
  candidateId              String                          @db.Uuid
  kind                     OrganizationSuggestionKind
  operation                OrganizationSuggestionOperation
  targetArtifactId         String?                         @db.Uuid
  targetRevision           Int?
  title                    String
  summary                  String?                         @db.Text
  tags                     String[]                        @default([])
  digest                   String
  contentBytes             Int
  sessionIds               String[]                        @default([])
  state                    OrganizationSuggestionState     @default(pending)
  reviewedByUserId         String?
  reviewedAt               DateTime?                       @db.Timestamptz(6)
  reviewReason             String?                         @db.Text
  acceptedArtifactId       String?                         @db.Uuid
  acceptedArtifactRevision Int?
  createdAt                DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                        @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceAgentId, dreamId, candidateId])
  @@index([orgId, state, createdAt])
  @@index([sourceDaemonId, state])
  @@map("organization_suggestion")
}

// ───────────────────────────────────────────────────────────────────────
// External-memory plugin control plane (docs/designs/memory-evolution.md M-5A).
// Purpose-separated from the model-facing MCP registry. Upstream secret values
// and daemon grant keys live only in side tables whose values pass through the
// configured SecretCipher.
// ────────────────────────────────────────────────────────────────────────
enum MemoryPluginTransport {
  streamable_http
  stdio
}

enum ExternalMemoryConnectionStatus {
  probing
  ready
  degraded
  invalid
}

model MemoryPluginInstallation {
  id                     String                @id @default(uuid()) @db.Uuid
  orgId                  String
  pluginId               String
  transport              MemoryPluginTransport @default(streamable_http)
  endpoint               String?
  commandRef             String?
  pinnedProfileMajor     Int                   @default(1)
  expectedManifestDigest String?
  // Reviewed logical-secret → upstream-header mapping. Header names are
  // configuration; values live only in ExternalMemoryConnectionSecret.
  secretHeaders          Json                  @default("[]") @db.JsonB
  createdByUserId        String?
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)

  org         Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?                      @relation("MemoryPluginInstallationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  connections ExternalMemoryConnection[]

  // One plugin may have multiple independently reviewed immutable pins: another
  // endpoint, manifest digest, or secret contract must not overwrite agents
  // still using the old installation.
  @@index([orgId, pluginId])
  @@map("memory_plugin_installation")
}

model ExternalMemoryConnection {
  id                  String                         @id @default(uuid()) @db.Uuid
  orgId               String
  installationId      String                         @db.Uuid
  config              Json                           @default("{}") @db.JsonB
  status              ExternalMemoryConnectionStatus @default(probing)
  revision            Int                            @default(1)
  probedRevision      Int?
  pluginVersion       String?
  profile             String?
  manifestDigest      String?
  capabilities        Json?                          @db.JsonB
  declaredEgressHosts String[]                       @default([])
  reasonCode          String?
  createdByUserId     String?
  createdAt           DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                       @updatedAt @db.Timestamptz(6)

  org          Org                             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installation MemoryPluginInstallation        @relation(fields: [installationId], references: [id], onDelete: Restrict)
  createdBy    User?                           @relation("ExternalMemoryConnectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  secret       ExternalMemoryConnectionSecret?
  grants       ExternalMemoryGrant[]

  @@index([orgId])
  @@index([installationId])
  @@map("external_memory_connection")
}

model ExternalMemoryConnectionSecret {
  connectionId String @id @db.Uuid
  values       Json   @default("{}") @db.JsonB

  connection ExternalMemoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("external_memory_connection_secret")
}

model ExternalMemoryGrant {
  id           String   @id @default(cuid())
  connectionId String   @db.Uuid
  key          String   @unique
  status       String   @default("active")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  connection ExternalMemoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("external_memory_grant")
}

/// K8s duty ledger: one row per connected component of the
/// agent↔daemon-held-bot graph (an enabled cron is an edge too), the only unit
/// a k8s daemon ever claims. Deliberately NOT holder columns on Bot or
/// Integration: per-row leases cannot express an atomic group claim, a botless
/// cron-bearing agent has no Integration row to carry one, and two held groups
/// merging need a single surviving holder recorded somewhere.
///
/// Vacancy is temporal, not referential: a group is grantable when
/// `expiresAt` has passed (or it was never claimed / explicitly released), so a
/// dead member simply stops renewing — `holder` carries no FK on purpose, since
/// fencing always reads (holder, term) together and a row-level SetNull would
/// vacate without a term bump.
model DutyGroup {
  id        String    @id @db.Uuid
  orgId     String
  holder    String?   @db.Uuid // member (daemon) the group is granted to; null ⇒ never claimed or released
  term      BigInt    @default(0) // monotonic per group; bumped on EVERY grant/re-grant — the fencing token
  expiresAt DateTime? @db.Timestamptz(6) // renewal horizon written by the granter; past ⇒ vacant and grantable
  // WHICH hold the member has reported in its heartbeat digest — a grant is applied daemon-side
  // only after its install succeeded (#972), so the digest is the proof it is serving. Scoped to
  // the exact grant it proves: confirmed ⟺ `confirmedTerm = term AND confirmedHolder = holder`.
  // A bare timestamp could not say WHAT it confirmed, so a re-take, a composition rewrite, or a
  // stale-term digest inherited a confirmation none of them earned. Every grant path bumps `term`
  // and renewal never does (#939), which is exactly the identity this needs. Ingress addressing
  // waits for it; delivery and `duty/fetch` deliberately do not (a member must receive its bundle
  // to become confirmed at all).
  confirmedTerm   BigInt?
  confirmedHolder String? @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  org     Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members DutyGroupMember[]

  @@index([orgId])
  @@index([holder])
  @@index([expiresAt])
  @@map("duty_group")
}

enum DutyMemberKind {
  agent
  bot
}

/// Derived membership projection (agentId|botId → group), recomputed from
/// Integration and CronDef rows whenever an edge changes — never hand-written,
/// so it needs no reconciliation of its own. The composite id makes "one home
/// per agent / per bot" a database invariant, not a code promise.
model DutyGroupMember {
  kind    DutyMemberKind
  refId   String         @db.Uuid // Agent.id or Bot.id, per kind (no FK: recompute owns lifecycle)
  groupId String         @db.Uuid
  orgId   String

  group DutyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([kind, refId])
  @@index([groupId])
  @@index([orgId])
  @@map("duty_group_member")
}
