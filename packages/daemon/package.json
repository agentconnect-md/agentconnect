{
  "name": "@agentconnect.md/daemon",
  "version": "2.0.0-dev",
  "description": "AgentConnect daemon — edge message + agent execution unit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentconnect-md/agentconnect.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "bin": {
    "agentconnect-daemon": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "agent:chat": "tsx src/index.ts --agents-dir ./test/fixtures/sample-agent chat",
    "agent:run": "tsx src/index.ts --agents-dir ./test/fixtures/sample-agent run",
    "build": "pnpm --filter \"{.}...\" build:package",
    "build:package": "tsdown && pnpm run build:shim && node scripts/prepare-bundled-skills.mjs && node scripts/prepare-release-image.mjs && node scripts/assert-self-contained.mjs",
    "build:shim": "tsdown --config tsdown.shim.config.ts && node scripts/prepare-shim-skills.mjs && node scripts/emit-shim-gh-wrapper.mjs && node scripts/emit-shim-git-credential-wrapper.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts run",
    "prepack": "pnpm run build",
    "perf:postgres-capacity": "vitest run --config vitest.postgres-capacity.config.ts",
    "start": "node dist/index.js run",
    "test": "vitest run",
    "test:runtime-matrix": "vitest run test/acp-matrix/acp-matrix.test.ts",
    "test:source-cache:minio": "vitest run --config vitest.source-cache.config.ts",
    "test:store:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@agentconnect.md/activation-policy": "workspace:*",
    "@agentconnect.md/connection": "workspace:*",
    "@agentconnect.md/k8s-client": "workspace:*",
    "@agentconnect.md/message": "workspace:*",
    "@agentconnect.md/object-store": "workspace:*",
    "@agentconnect.md/protocol": "workspace:*",
    "@anthropic-ai/sandbox-runtime": "0.0.78",
    "@jsquash/webp": "1.5.0",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "cborg": "^6.1.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "fflate": "^0.8.3",
    "grammy": "^1.45.1",
    "jose": "^6.2.12",
    "jpeg-js": "0.4.4",
    "mdast-util-from-markdown": "^2.1.0",
    "pg": "^8.23.1",
    "pngjs": "7.0.0",
    "simple-git": "^4.0.2",
    "skills": "1.5.21",
    "smol-toml": "^1.9.0",
    "strip-json-comments": "^5.0.3",
    "systeminformation": "^5.33.15",
    "tar": "7.5.22",
    "undici": "^8.11.2",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "json": "^11.0.0",
    "microsandbox": "0.7.7",
    "testcontainers": "^12.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "acp",
    "agentconnect",
    "agents",
    "cli",
    "daemon"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
