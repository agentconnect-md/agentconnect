{
  "name": "@agentconnect.md/daemon",
  "version": "1.0.0-dev",
  "description": "AgentConnect daemon — edge message + agent execution unit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentconnect-md/agentconnect.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "bin": {
    "agentconnect-daemon": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "agent:chat": "tsx src/index.ts --agents-dir ./test/fixtures/sample-agent chat",
    "agent:run": "tsx src/index.ts --agents-dir ./test/fixtures/sample-agent run",
    "build": "pnpm --filter '{.}^...' build && tsdown && pnpm run build:shim && node scripts/prepare-bundled-skills.mjs && node scripts/assert-self-contained.mjs",
    "build:shim": "tsdown --config tsdown.shim.config.ts && node scripts/prepare-shim-skills.mjs && node scripts/emit-shim-gh-wrapper.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts run",
    "prepack": "pnpm run build",
    "perf:postgres-capacity": "vitest run --config vitest.postgres-capacity.config.ts",
    "start": "node dist/index.js run",
    "test": "vitest run",
    "test:runtime-matrix": "vitest run test/acp-matrix/acp-matrix.test.ts",
    "test:store:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@agentconnect.md/activation-policy": "workspace:*",
    "@agentconnect.md/connection": "workspace:*",
    "@agentconnect.md/k8s-client": "workspace:*",
    "@agentconnect.md/message": "workspace:*",
    "@agentconnect.md/protocol": "workspace:*",
    "@anthropic-ai/sandbox-runtime": "0.0.73",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "fflate": "^0.8.3",
    "grammy": "^1.45.1",
    "pg": "^8.22.0",
    "simple-git": "^3.36.0",
    "skills": "1.5.21",
    "systeminformation": "^5.33.1",
    "tar": "7.5.22",
    "undici": "^7.29.0",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "json": "^11.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "acp",
    "agentconnect",
    "agents",
    "cli",
    "daemon"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
