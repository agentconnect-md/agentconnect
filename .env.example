# AgentConnect — environment template.
# Copy to `.env` (gitignored) and fill in real values. NEVER commit a real password.
#   cp .env.example .env
#
# Used by the Control Plane (packages/control-plane). The daemon
# (packages/daemon) is configured separately via ~/.agentconnect/config.json.

# ── Control Plane: Postgres (Prisma) ────────────────────────────────────────
# Local Postgres (Docker quick-start in packages/control-plane/README.md):
DATABASE_URL="postgresql://postgres:pw@localhost:5432/agentconnect?schema=public"
#
# OR an operator-provided remote development Postgres. Keep its credentials only
# in your LOCAL `.env`; use an RFC-reserved host in copied examples:
# DATABASE_URL="postgresql://app:<password>@db.example.test:5432/agentconnect?schema=public"

# HMAC pepper for daemon API-key hashes — must be ≥ 32 chars. Effectively immutable:
# rotating it invalidates every issued key. See docs/designs/daemon-api-key-auth.md.
API_KEY_PEPPER="replace-with-a-random-32+-char-secret-string"

# ── Webchat relay pool (milestone A4) ───────────────────────────────────────
# The browser Playground / webchat rides the RELAY pool now, never the CP (the CP
# is off the message hot path). The console mints a token at
# POST /orgs/:org/agents/:id/webchat/token, which returns this URL to dial. UNSET ⇒
# that mint route 503s and the Playground shows "Webchat relay not configured", so
# to use the Playground locally you must run a relay (packages/relay) and point this
# at it. See docs/designs/shared-bot-relay.md.
# PUBLIC_RELAY_URL=http://localhost:8090

# ── Optional Control Plane knobs (defaults shown) ───────────────────────────
# PORT=8080
# HOST=0.0.0.0
# WS_PATH=/daemon/ws
# HEARTBEAT_SEC=15
# MISSED_BEATS=3
# REASSIGN_GRACE_SEC=60
# ACK_TIMEOUT_MS=5000
# CRON_RUN_TTL_SEC=1800          # a schedule run still "running" this long past its
#                                # fire (completion report lost) is reconciled → failed
# CRON_RUN_REAP_INTERVAL_SEC=300 # how often the CronRunReaper sweeps
# SECRETS_PROVIDER=memory

# ── At-rest secret encryption (docs/designs/secret-store-seams.md) ──────────
# Every stored tenant secret (bot tokens, agent secret env vars, hook HMAC keys,
# MCP headers/grants, Slack config tokens) passes ONE SecretCipher. `none`
# (default) = plaintext at rest. `vault-transit` seals values via HashiCorp
# Vault's Transit engine — flipping it is online: existing plaintext rows keep
# reading and re-seal on their next write. Auth is exactly one of VAULT_TOKEN
# (static) or VAULT_JWT_ROLE (a workload JWT read from VAULT_JWT_PATH, exchanged
# at auth/<VAULT_AUTH_MOUNT>/login — works with Vault's kubernetes AND generic
# jwt/OIDC auth methods; the defaults fit a k8s pod but nothing requires k8s).
# SECRET_CIPHER=none              # none | vault-transit
# VAULT_ADDR=                     # e.g. https://vault.example.com:8200
# VAULT_TRANSIT_KEY=agentconnect-cp
# VAULT_TRANSIT_MOUNT=transit
# VAULT_NAMESPACE=                # Vault Enterprise only
# VAULT_TOKEN=                    # static token auth (dev)
# VAULT_JWT_ROLE=                 # login-auth role (k8s / jwt / OIDC method)
# VAULT_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# VAULT_AUTH_MOUNT=kubernetes     # or e.g. `jwt` outside k8s

# OIDC_ISSUER=            # unset ⇒ devAuth stub (admits all WebUI REST calls).
#                         # Set to any OIDC issuer to require a verified bearer JWT;
#                         # the CP resolves the JWKS via OIDC discovery and
#                         # JIT-provisions the local user from the token's `sub` on
#                         # first call. (Logto note: use the `/oidc` issuer URL,
#                         # e.g. https://tenant.example.com/oidc)
# OIDC_AUDIENCE=          # required `aud` on the token. With a Logto API resource:
#                         # the resource indicator (= NEXT_PUBLIC_LOGTO_API_RESOURCE).
#                         # Without one (id-token fallback): the Logto app id
#                         # (= NEXT_PUBLIC_LOGTO_APP_ID).
# WAITLIST_MODE=false     # Closed-beta admission gate.
#                         # `true` ⇒ a signed-in user must be an activated (join-link
#                         # redeemed) user OR an existing org member to enter the app;
#                         # others land on /waitlist. Requires OIDC. Default `false` =
#                         # today's behavior (login ⇒ personal org ⇒ app). MUST be the
#                         # literal 'true'/'false' — any other value is rejected at boot.
# CORS_ORIGIN=            # Web UI origin(s), comma-separated, or `*`. Unset ⇒
#                         # reflect any origin in dev, disabled in production.

# ── Optional OpenTelemetry (standard OTEL_* env vars) ───────────────────────
# Unset ⇒ disabled. Set an OTLP endpoint/exporter to enable traces/metrics
# for the Control Plane; the daemon reads the same variables from its process env.
# Logs stay on the regular app logger and are not exported through OpenTelemetry.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf # or grpc / http/json
# OTEL_SERVICE_NAME=agentconnect-control-plane
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp

# ── Web UI (packages/web) — public runtime config ───────────────────────────
# The web server injects these public values into window.__AC_ENV at request
# time; NEXT_PUBLIC_* fallbacks still work for local build-time config.
# Control Plane API base the console calls — origin + version path. The CP serves
# its routes under /api/v1; where that surfaces publicly is a deploy/ingress choice,
# so include the version segment here (a bare origin 404s). Direct-to-CP dev default
# is http://localhost:8080/api/v1; behind an ingress it can be e.g. https://api.example.test/v1.
# NEXT_PUBLIC_CP_URL=http://localhost:8080/api/v1
# Optional browser-tab deployment label. For example, WEB_TITLE_ENV=staging
# renders "(staging) Agent · AgentConnect". The NEXT_PUBLIC_* form is a local
# build-time fallback; prefer WEB_TITLE_ENV for runtime deployment config.
# WEB_TITLE_ENV=
# Static bearer token (CI/service). Leave unset when the CP runs the devAuth stub.
# NEXT_PUBLIC_CP_TOKEN=
# Social login via Logto (opt-in). Set ENDPOINT + APP_ID to enable the
# GitHub/Google buttons; unset ⇒ no-auth (the buttons just enter the app). Add
# the social connectors (target `google`/`github`) inside Logto — the buttons
# jump straight to them via Logto's direct sign-in.
# NEXT_PUBLIC_LOGTO_ENDPOINT=https://tenant.example.com/
# NEXT_PUBLIC_LOGTO_APP_ID=
# Optional: the CP API resource registered in Logto, for a JWT access token. When
# unset the console sends the id token (whose `aud` is the app id — set the CP's
# OIDC_AUDIENCE to the app id then). Must equal the CP's OIDC_AUDIENCE.
# NEXT_PUBLIC_LOGTO_API_RESOURCE=https://api.example.com

# Rail-footer Help menu links. Unset ⇒ the agentconnect.md defaults; override to
# point a fork at its own docs / connector guide / releases / support channel
# (support accepts a mailto: or https: URL). NEXT_PUBLIC_* forms work for local
# build-time config.
# HELP_MCP_URL=https://docs.agentconnect.md/docs/mcp-connector
# HELP_DOCS_URL=https://docs.agentconnect.md
# HELP_RELEASES_URL=https://github.com/agentconnect-md/agentconnect/releases
# HELP_SUPPORT_URL=mailto:support@agentconnect.md

# Sender the waitlist page tells approved users their activation link comes from.
# Must match the verified sender the admin mailer actually sends as, or the page
# tells people to whitelist the wrong address. Unset ⇒ no-reply@agentconnect.md.
# WAITLIST_FROM_EMAIL=no-reply@agentconnect.md

# Browser OpenTelemetry traces (opt-in). Logs are not exported through OTel.
# Prefer these runtime env vars in deploys; NEXT_PUBLIC_* forms are only a local
# dev/build-time fallback. Endpoint must be the OTLP/HTTP traces URL, and the
# collector/proxy must allow browser CORS.
# OTEL_WEB_ENABLED=1
# OTEL_WEB_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_WEB_SERVICE_NAME=agentconnect-web
# OTEL_WEB_DEPLOYMENT_ENVIRONMENT=development
# OTEL_WEB_PROPAGATE_TRACE_HEADER_URLS=http://localhost:8080
